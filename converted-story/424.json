[{"op":"callScene","scene":6900,"entry":5},{"op":"set","target":["v","f",1108],"value":0},{"op":"set","target":["v","f",1109],"value":4},{"op":"set","target":["v","f",1110],"value":24},{"op":"set","target":["v","f",1111],"value":4},{"op":"set","target":["v","f",1112],"value":1},{"op":"ifFalse","to":11,"condition":["==",["v","f",11],1]},{"op":"callScene","scene":6424,"entry":0},{"op":"background","image":"kuro"},{"op":"bodies","images":[]},{"op":"jumpScene","scene":6425,"entry":0},{"op":"ifFalse","to":64,"condition":["==",["v","f",215],1]},{"op":"callScene","scene":2424,"entry":0},{"op":"ifFalse","to":60,"condition":["==",["v","f",218],1]},{"op":"background","image":"bg046y"},{"op":"bodies","images":[]},{"op":"set","target":["v","f",1118],"value":3},{"op":"text","speaker":"","text":"我到春原房间一看，发现他不在。"},{"op":"text","speaker":"","text":"也不在教室里，大概是外出了吧。"},{"op":"text","speaker":"","text":"这倒不是太稀奇的事。于是我就一个人看杂志来打发时间。"},{"op":"text","speaker":"","text":"………。"},{"op":"text","speaker":"","text":"过了大约一小时，春原终于回来了。"},{"op":"set","target":["v","z",313],"value":1},{"op":"bodies","images":["cgsh20"]},{"op":"text","speaker":"春原","text":"「哎呀，你这是怎么了？」"},{"op":"text","speaker":"朋也","text":"「什么怎么了？」"},{"op":"bodies","images":["cgsh19"]},{"op":"text","speaker":"春原","text":"「你不是被智代捉去了吗。」"},{"op":"text","speaker":"朋也","text":"「嗯…不过我们不久就分开了。」"},{"op":"text","speaker":"春原","text":"「什么呀，原来是这样。」"},{"op":"bodies","images":["cgsh12"]},{"op":"text","speaker":"春原","text":"「那正好。你也参加进来吧。」"},{"op":"text","speaker":"朋也","text":"「参加啥？」"},{"op":"bodies","images":["cgsh13"]},{"op":"text","speaker":"春原","text":"「就是这个…」"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"说着，他从手里拎着的纸袋子里取出的是一把枪，以及一个盒子形状的感应器一样的小东西。"},{"op":"text","speaker":"","text":"他把这些摆在桌上。"},{"op":"text","speaker":"朋也","text":"「这都什么啊？」"},{"op":"set","target":["v","z",321],"value":1},{"op":"bodies","images":["cgsh13"]},{"op":"text","speaker":"春原","text":"「嗯…」"},{"op":"text","speaker":"春原","text":"「最近不是因为智代的关系，什么好玩的事都没做嘛。」"},{"op":"text","speaker":"朋也","text":"「顺带一提，只有你是这样。」"},{"op":"text","speaker":"春原","text":"「然后我就在商店街溜达，想着有没有什么好玩的事能做。」"},{"op":"text","speaker":"春原","text":"「接着，我就在玩具店门口遇到了一个男的。」"},{"op":"text","speaker":"春原","text":"「他对我说了以下的话。」"},{"op":"bodies","images":["cgsh18"]},{"op":"text","speaker":"春原","text":"「如果你有空，就一起来玩吧。」"},{"op":"bodies","images":["cgsh15"]},{"op":"text","speaker":"春原","text":"「然后他交给我的，就是这个…」"},{"op":"bodies","images":["cgsh18"]},{"op":"text","speaker":"春原","text":"「…『赤红闪电魔蝎』。」"},{"op":"text","speaker":"春原","text":"「是把感应器戴在身上，互相射击的对战型玩具。」"},{"op":"bodies","images":["cgsh13"]},{"op":"text","speaker":"春原","text":"「这简直就是根救命稻草，我二话没说就答应下来了。」"},{"op":"text","speaker":"春原","text":"「别担心，你的那份我也留了。」"},{"op":"text","speaker":"朋也","text":"「我可完全没有担心。」"},{"op":"goto","to":597},{"op":"goto","to":64},{"op":"ifFalse","to":64,"condition":["==",["v","f",218],0]},{"op":"background","image":"kuro"},{"op":"bodies","images":[]},{"op":"jumpScene","scene":2425,"entry":0},{"op":"background","image":"bg033"},{"op":"bodies","images":[]},{"op":"set","target":["v","z",315],"value":1},{"op":"text","speaker":"","text":"今天，依然上学迟到。"},{"op":"text","speaker":"","text":"上学路上空无一人，姗姗来迟进入教室。"},{"op":"text","speaker":"","text":"从前有位老师问过我，这算是我的抗争吗？"},{"op":"text","speaker":"","text":"什么抗争啊。"},{"op":"text","speaker":"","text":"纯粹是懒散而已。"},{"op":"background","image":"bg021a"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"直到第三节课我才坐到座位上，望着窗外打发时间。"},{"op":"text","speaker":"","text":"………。"},{"op":"ifFalse","to":78,"condition":["==",["v","f",410],1]},{"op":"jumpScene","scene":4424,"entry":0},{"op":"ifFalse","to":80,"condition":["==",["v","f",306],1]},{"op":"callScene","scene":3424,"entry":0},{"op":"background","image":"bg021b"},{"op":"bodies","images":[]},{"op":"set","target":["v","z",312],"value":1},{"op":"text","speaker":"","text":"第四节课结束，午休开始了。"},{"op":"ifFalse","to":176,"condition":["==",["v","f",213],1]},{"op":"ifFalse","to":142,"condition":["==",["v","f",813],0]},{"op":"bodies","images":["cgsh12"]},{"op":"text","speaker":"春原","text":"「午安。」"},{"op":"bodies","images":["cgsh25"]},{"op":"text","speaker":"春原","text":"「去吃午饭吧。」"},{"op":"text","speaker":"朋也","text":"「………」"},{"op":"bodies","images":["cgsh18"]},{"op":"text","speaker":"春原","text":"「怎么样？我按你要求招呼了。这样总行了吧？」"},{"op":"text","speaker":"朋也","text":"「有够爽朗的啊…」"},{"op":"bodies","images":["cgsh20"]},{"op":"text","speaker":"春原","text":"「嗯？」"},{"op":"text","speaker":"朋也","text":"「就你而言，未免太过爽朗了。」"},{"op":"text","speaker":"春原","text":"「咦？是吗？」"},{"op":"text","speaker":"朋也","text":"「不错。和你的形象偏差太大了。这反差让我一整哆嗦。」"},{"op":"bodies","images":["cgsh15"]},{"op":"text","speaker":"春原","text":"「那不就没意义了嘛。」"},{"op":"text","speaker":"朋也","text":"「是啊…完全没有意义。」"},{"op":"bodies","images":["cgsh18"]},{"op":"text","speaker":"春原","text":"「那下次开始你要我怎么弄啊？」"},{"op":"text","speaker":"朋也","text":"「也是啊。」"},{"op":"choice","id":"424:52150","target":["v","f",1089],"items":[{"text":"含口水在嘴里说话","value":0,"serial":52150},{"text":"句尾加上『还有马桶盖子』","value":1,"serial":52160},{"text":"学腹语师说话","value":2,"serial":52170}]},{"op":"ifFalse","to":115,"condition":["==",["v","f",1089],0]},{"op":"text","speaker":"朋也","text":"「含口水在嘴里说话。」"},{"op":"bodies","images":["cgsh27"]},{"op":"text","speaker":"春原","text":"「那算什么，简直就是惩罚游戏啊。」"},{"op":"text","speaker":"朋也","text":"「那要不明天请早来？」"},{"op":"bodies","images":["cgsh21"]},{"op":"text","speaker":"春原","text":"「那是不可能的！」"},{"op":"text","speaker":"朋也","text":"「那就含口水再说话。」"},{"op":"goto","to":136},{"op":"ifFalse","to":125,"condition":["==",["v","f",1089],1]},{"op":"text","speaker":"朋也","text":"「说话时句尾加上，还有马桶盖子。」"},{"op":"bodies","images":["cgsh27"]},{"op":"text","speaker":"春原","text":"「啥？搞什么…这简直就是惩罚游戏啊。」"},{"op":"text","speaker":"春原","text":"「怎么可能说这种蠢话！」"},{"op":"text","speaker":"朋也","text":"「那要不明天请早来？」"},{"op":"bodies","images":["cgsh21"]},{"op":"text","speaker":"春原","text":"「那是不可能的！」"},{"op":"text","speaker":"朋也","text":"「那就愿赌服输吧。」"},{"op":"goto","to":136},{"op":"ifFalse","to":136,"condition":["==",["v","f",1089],2]},{"op":"text","speaker":"朋也","text":"「学腹语师说话。」"},{"op":"bodies","images":["cgsh20"]},{"op":"text","speaker":"春原","text":"「你说的腹语师，是我理解的那个腹语师吧？」"},{"op":"text","speaker":"朋也","text":"「没错，就是腹语师。」"},{"op":"bodies","images":["cgsh16"]},{"op":"text","speaker":"春原","text":"「搞什么，弄得和惩罚游戏似的。」"},{"op":"text","speaker":"朋也","text":"「那要不明天请早来？」"},{"op":"bodies","images":["cgsh21"]},{"op":"text","speaker":"春原","text":"「那是不可能的！」"},{"op":"text","speaker":"朋也","text":"「那就学腹语师说话吧。」"},{"op":"set","target":["v","f",816],"value":["v","f",1089]},{"op":"bodies","images":["cgsh16"]},{"op":"text","speaker":"春原","text":"「嘁…你赢了。我学还不成吗…」"},{"op":"text","speaker":"朋也","text":"「哦哦，我期待得很呢。」"},{"op":"goto","to":418},{"op":"goto","to":167},{"op":"ifFalse","to":156,"condition":["==",["v","f",813],1]},{"op":"bodies","images":["cgsh27"]},{"op":"text","speaker":"春原","text":"「哎呀？」"},{"op":"bodies","images":["cgsh25"]},{"op":"text","speaker":"春原","text":"「这不是冈崎吗，好久不见！」"},{"op":"bodies","images":["cgsh12"]},{"op":"text","speaker":"春原","text":"「你还好吗？我好得很。」"},{"op":"text","speaker":"","text":"我把手贴上春原的额头，看看他是不是发烧了。"},{"op":"text","speaker":"","text":"…没有。"},{"op":"text","speaker":"朋也","text":"「我告诉你，春原…其实我们昨天也见面了。」"},{"op":"bodies","images":["cgsh23"]},{"op":"text","speaker":"春原","text":"「我当然知道了！」"},{"op":"text","speaker":"朋也","text":"「我告诉你，春原。就半天没见面的人呢，是不会说好久不见的。」"},{"op":"goto","to":167},{"op":"ifFalse","to":167,"condition":["==",["v","f",813],2]},{"op":"bodies","images":["cgsh25"]},{"op":"text","speaker":"春原","text":"「哟，我是春原，１７岁，和你一样，是这里的学生。」"},{"op":"bodies","images":["cgsh12"]},{"op":"text","speaker":"春原","text":"「要不要一起吃个午饭？」"},{"op":"text","speaker":"","text":"我把手贴上春原的额头，看看他是不是发烧了。"},{"op":"text","speaker":"","text":"…没有。"},{"op":"text","speaker":"朋也","text":"「我告诉你，春原…其实我和你早就认识了。」"},{"op":"bodies","images":["cgsh23"]},{"op":"text","speaker":"春原","text":"「这还用你告诉我吗！」"},{"op":"text","speaker":"朋也","text":"「听我说，春原。人们是不会对已经认识的人再做自我介绍的。」"},{"op":"text","speaker":"春原","text":"「别说得好像我是神经病一样！」"},{"op":"text","speaker":"朋也","text":"「咦？原来不是啊？」"},{"op":"bodies","images":["cgsh17"]},{"op":"text","speaker":"春原","text":"「我正常得很！还不是你叫我说我才这么说的！」"},{"op":"text","speaker":"朋也","text":"「咦？有这回事？」"},{"op":"bodies","images":["cgsh16"]},{"op":"text","speaker":"春原","text":"「不是吧，你随口说说的吗…混蛋，亏我还按你要求说了…」"},{"op":"text","speaker":"朋也","text":"「不好意思不好意思。」"},{"op":"goto","to":418},{"op":"ifFalse","to":196,"condition":["==",["v","f",816],0]},{"op":"bodies","images":["cgsh24"]},{"op":"text","speaker":"春原","text":"「………」"},{"op":"text","speaker":"","text":"春原鼓着腮帮站起身。"},{"op":"bodies","images":["cgsh16"]},{"op":"text","speaker":"春原","text":"「唔…唔…」"},{"op":"text","speaker":"朋也","text":"「怎么，出什么事了？」"},{"op":"text","speaker":"春原","text":"「唔…」"},{"op":"bodies","images":[]},{"op":"text","speaker":"春原","text":"「咳咳，咳咳咳呸呸！」"},{"op":"text","speaker":"","text":"他嘴里喷出水来。"},{"op":"text","speaker":"朋也","text":"「唔哇！」"},{"op":"text","speaker":"","text":"我飞身后退，但裤脚上还是沾到了一点点。"},{"op":"text","speaker":"朋也","text":"「脏死了，你干什么呢！」"},{"op":"text","speaker":"","text":"啪嗒！"},{"op":"text","speaker":"","text":"我抄起室内鞋朝他头上抡过去。"},{"op":"bodies","images":["cgsh23"]},{"op":"text","speaker":"春原","text":"「好痛啊！不是你让我这么干的嘛！」"},{"op":"text","speaker":"朋也","text":"「啊？这又怎么说？」"},{"op":"goto","to":414},{"op":"ifFalse","to":231,"condition":["==",["v","f",816],1]},{"op":"bodies","images":["cgsh25"]},{"op":"text","speaker":"春原","text":"「哟，冈崎，还有马桶盖子。」"},{"op":"text","speaker":"朋也","text":"「什么啊…」"},{"op":"bodies","images":["cgsh12"]},{"op":"text","speaker":"春原","text":"「好啦，我们去吃饭吧，还有马桶盖子。」"},{"op":"text","speaker":"朋也","text":"「我只吃饭就行了。」"},{"op":"text","speaker":"朋也","text":"「又去食堂啊…你打算吃什么？」"},{"op":"bodies","images":["cgsh10"]},{"op":"text","speaker":"春原","text":"「嗯？我想想，猪排饭吧…还有马桶盖子。」"},{"op":"text","speaker":"朋也","text":"「你这搭配够可以的…」"},{"op":"text","speaker":"朋也","text":"「真是的，能像你这么轻松也挺好的。看你的样子完全没有想将来的事吧。」"},{"op":"bodies","images":["cgsh15"]},{"op":"text","speaker":"春原","text":"「别看我这样，也是有考虑的啦，将来的事情…还有马桶盖子。」"},{"op":"text","speaker":"朋也","text":"「你还能把这么荒诞的事放在一起考虑啊。」"},{"op":"text","speaker":"朋也","text":"「你就是因为这样，才会被别人当笨蛋啊。」"},{"op":"bodies","images":["cgsh21"]},{"op":"text","speaker":"春原","text":"「笨蛋？你说我是笨蛋！？还有马桶盖子。」"},{"op":"text","speaker":"朋也","text":"「不，马桶盖子可不是我说的。」"},{"op":"text","speaker":"春原","text":"「别看我这样，以前人家可都说我是神童！还有马桶盖子。」"},{"op":"text","speaker":"朋也","text":"「真是两个极端啊。」"},{"op":"bodies","images":["cgsh18"]},{"op":"text","speaker":"春原","text":"「唉…那时候还真觉得自己什么都能当得上啊…」"},{"op":"bodies","images":["cgsh10"]},{"op":"text","speaker":"春原","text":"「飞行员，学校老师，警官…还有马桶盖子。」"},{"op":"bodies","images":["cgsh23"]},{"op":"text","speaker":"春原","text":"「喂，我真受够了ーーーー！」"},{"op":"text","speaker":"春原","text":"「光是加个马桶盖子，正常的对话就全都见鬼了。」"},{"op":"text","speaker":"朋也","text":"「那你不加不就行了？」"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"咣叽，春原夸张地倒在地上。"},{"op":"bodies","images":["cgsh23"]},{"op":"text","speaker":"春原","text":"「不是你让我这么干的吗！」"},{"op":"text","speaker":"朋也","text":"「啊？这又怎么说？」"},{"op":"goto","to":414},{"op":"ifFalse","to":263,"condition":["==",["v","f",816],2]},{"op":"bodies","images":["cgsh15"]},{"op":"text","speaker":"春原","text":"「………」"},{"op":"text","speaker":"","text":"春原默默地站在原地。"},{"op":"text","speaker":"朋也","text":"「什么嘛，原来你在啊。」"},{"op":"bodies","images":["cgsh18"]},{"op":"text","speaker":"春原","text":"「………」"},{"op":"bodies","images":["cgsh15"]},{"op":"text","speaker":"春原","text":"「哟。」"},{"op":"bodies","images":["cgsh18"]},{"op":"text","speaker":"春原","text":"「………」"},{"op":"bodies","images":["cgsh15"]},{"op":"text","speaker":"春原","text":"「我们去吃饭吧。」"},{"op":"bodies","images":["cgsh20"]},{"op":"text","speaker":"春原","text":"「………」"},{"op":"bodies","images":["cgsh19"]},{"op":"text","speaker":"春原","text":"「咦？」"},{"op":"bodies","images":["cgsh20"]},{"op":"text","speaker":"春原","text":"「………」"},{"op":"bodies","images":["cgsh19"]},{"op":"text","speaker":"春原","text":"「声音听起来…」"},{"op":"bodies","images":["cgsh20"]},{"op":"text","speaker":"春原","text":"「………」"},{"op":"bodies","images":["cgsh19"]},{"op":"text","speaker":"春原","text":"「好像有点慢啊。」"},{"op":"text","speaker":"朋也","text":"「你在干什么呢？」"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"咣叽，春原夸张地倒在地上。"},{"op":"bodies","images":["cgsh23"]},{"op":"text","speaker":"春原","text":"「不是你让我这么干的吗！」"},{"op":"text","speaker":"朋也","text":"「啊？这又怎么说？」"},{"op":"goto","to":414},{"op":"ifFalse","to":307,"condition":["==",["v","f",816],3]},{"op":"text","speaker":"朋也","text":"（春原那家伙，好慢啊…）"},{"op":"text","speaker":"","text":"我望向走廊。"},{"op":"text","speaker":"","text":"就在这时，门开了，门外站着的是春原。"},{"op":"text","speaker":"朋也","text":"「你干什么呢？」"},{"op":"text","speaker":"","text":"我向他走去。"},{"op":"bodies","images":["cgsh28"]},{"op":"text","speaker":"春原","text":"「饭…」"},{"op":"text","speaker":"朋也","text":"「啊？」"},{"op":"text","speaker":"","text":"他声音太小，我没听清楚。"},{"op":"set","target":["v","z",324],"value":1},{"op":"text","speaker":"春原","text":"「我们…去吃饭吧…」"},{"op":"text","speaker":"朋也","text":"「嗯，走吧。」"},{"op":"text","speaker":"春原","text":"「绝对…绝对要去哦…」"},{"op":"text","speaker":"朋也","text":"「嗯，绝对去吃。」"},{"op":"text","speaker":"春原","text":"「吃我们一直吃的…猪排饭…」"},{"op":"text","speaker":"朋也","text":"「不，我今天打算吃乌冬面。」"},{"op":"text","speaker":"春原","text":"「已经到，时间了…」"},{"op":"text","speaker":"朋也","text":"「赶紧走吧。」"},{"op":"bodies","images":["cgsh20"]},{"op":"text","speaker":"春原","text":"『呼噜噜噜噜噜ー』"},{"op":"text","speaker":"春原","text":"『门即将关闭，请乘客小心。』"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"嘎吱一声，春原亲手合上了门。"},{"op":"text","speaker":"","text":"接着他隔着玻璃砰砰砰地敲门。"},{"op":"text","speaker":"","text":"只能看见他的嘴巴一开一合。"},{"op":"text","speaker":"","text":"『去·吃·猪·排·饭·吧…』"},{"op":"text","speaker":"","text":"啪叽！"},{"op":"set","target":["v","z",314],"value":1},{"op":"bodies","images":["cgky14"]},{"op":"text","speaker":"杏","text":"「碍事！」"},{"op":"text","speaker":"","text":"杏一巴掌扇在他的后脑勺上。"},{"op":"bodies","images":["cgsh23"]},{"op":"text","speaker":"春原","text":"「唔哦哦…」"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"春原疼得蹲在地上，杏大步跨过他，走进教室。"},{"op":"bodies","images":["cgky13"]},{"op":"text","speaker":"杏","text":"「真是够蠢的。」"},{"op":"text","speaker":"朋也","text":"「你别把我跟他算到一起。」"},{"op":"text","speaker":"朋也","text":"「我也不知拿他怎么办好呢。」"},{"op":"bodies","images":["cgsh23"]},{"op":"text","speaker":"春原","text":"「不是你让我这么干的吗！」"},{"op":"text","speaker":"朋也","text":"「啊？这又怎么说？」"},{"op":"goto","to":414},{"op":"ifFalse","to":362,"condition":["==",["v","f",816],4]},{"op":"text","speaker":"朋也","text":"（春原那家伙，好慢啊…）"},{"op":"text","speaker":"","text":"我望向走廊。"},{"op":"text","speaker":"","text":"就在这时，只见春原站到了关着的门背后。"},{"op":"text","speaker":"朋也","text":"「你干什么呢？」"},{"op":"text","speaker":"","text":"我向他走去。"},{"op":"text","speaker":"春原","text":"「噼咔咔咔噼…」"},{"op":"bodies","images":["cgsh20"]},{"op":"text","speaker":"春原","text":"「是冈崎么？这里是春原。你那边能看见我吗？」"},{"op":"text","speaker":"朋也","text":"「看的可清楚了。」"},{"op":"bodies","images":["cgsh10"]},{"op":"text","speaker":"春原","text":"「是吗…好久不见了。」"},{"op":"text","speaker":"朋也","text":"「才一天没见好吗。」"},{"op":"text","speaker":"春原","text":"「现在，我有重要的事要说。」"},{"op":"bodies","images":["cgsh16"]},{"op":"set","target":["v","z",324],"value":1},{"op":"text","speaker":"春原","text":"「我已经…没法回到地球了。」"},{"op":"text","speaker":"朋也","text":"「哦，是吗。」"},{"op":"text","speaker":"春原","text":"「我必须留在这里，手动按下摧毁陨石的按钮…」"},{"op":"text","speaker":"朋也","text":"「你倒是快按啊。」"},{"op":"bodies","images":["cgsh28"]},{"op":"text","speaker":"春原","text":"「我现在回忆起的，是与你一起在学校度过的每一天…」"},{"op":"text","speaker":"朋也","text":"「你倒是快按啊。」"},{"op":"text","speaker":"春原","text":"「和你一起在食堂吃的猪排饭，真是美味啊…」"},{"op":"text","speaker":"春原","text":"「如果可以的话，真想再吃一次…」"},{"op":"text","speaker":"春原","text":"「我说，冈崎，你能向我保证吗？」"},{"op":"text","speaker":"春原","text":"「如果…有朝一日，我们能再相会…」"},{"op":"text","speaker":"春原","text":"「然后的话，我们再一起去食堂。」"},{"op":"text","speaker":"春原","text":"「在那里…一起再吃一次猪排饭。」"},{"op":"text","speaker":"春原","text":"「再一次，用你那刻薄的笑话，逗我笑。」"},{"op":"text","speaker":"朋也","text":"「你就按吧，挑战一下１６发连射，试试看一秒钟里爆炸１６次。」"},{"op":"bodies","images":["cgsh12"]},{"op":"text","speaker":"春原","text":"「哈哈，你这家伙，果然很有趣啊…」"},{"op":"bodies","images":["cgsh10"]},{"op":"text","speaker":"春原","text":"「差不多到时间了。冈崎…」"},{"op":"bodies","images":["cgsh16"]},{"op":"text","speaker":"春原","text":"「还有，地球啊…」"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"啪叽！"},{"op":"set","target":["v","z",314],"value":1},{"op":"bodies","images":["cgky14"]},{"op":"text","speaker":"杏","text":"「碍事！」"},{"op":"text","speaker":"","text":"杏一巴掌扇在他的后脑勺上。"},{"op":"bodies","images":["cgsh23"]},{"op":"text","speaker":"春原","text":"「唔哦哦…」"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"春原疼得蹲在地上，杏大步跨过他，走进教室。"},{"op":"bodies","images":["cgky13"]},{"op":"text","speaker":"杏","text":"「真是够蠢的。」"},{"op":"text","speaker":"朋也","text":"「你别把我跟他算到一起。」"},{"op":"text","speaker":"朋也","text":"「我也不知拿他怎么办好呢。」"},{"op":"bodies","images":["cgsh23"]},{"op":"text","speaker":"春原","text":"「不是你让我这么干的吗！」"},{"op":"text","speaker":"朋也","text":"「啊？这又怎么说？」"},{"op":"goto","to":414},{"op":"ifFalse","to":414,"condition":["==",["v","f",816],5]},{"op":"bodies","images":["cgsh10"]},{"op":"text","speaker":"春原","text":"「哟，冈崎。」"},{"op":"text","speaker":"朋也","text":"「你可算来了。」"},{"op":"bodies","images":["cgsh25"]},{"op":"text","speaker":"春原","text":"「哈哈，久等啦。我们去吃饭吧。」"},{"op":"bodies","images":[]},{"op":"text","speaker":"春原","text":"「我是春原。」"},{"op":"text","speaker":"春原","text":"「这家伙呢，是冈崎。」"},{"op":"text","speaker":"春原","text":"「我们两个是好朋友。」"},{"op":"text","speaker":"春原","text":"「…自那天开始。」"},{"op":"set","target":["v","z",303],"value":1},{"op":"text","speaker":"","text":"没错…自２年前那次命运的邂逅开始。"},{"op":"set","target":["v","f",1112],"value":0},{"op":"background","image":"bg014"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"那是我刚转学过来不久…这所学校正处在动乱中。"},{"op":"text","speaker":"","text":"力量就是一切。没有力量的，只能屈从于有力量的。"},{"op":"text","speaker":"","text":"好几个帮派被组织起来，四处挑起争端。"},{"op":"text","speaker":"","text":"上课都没法上，老师们也只能困守在办公室里。"},{"op":"text","speaker":"","text":"那段时间就是这样。就连我这个转校生，也毫不例外地经受了战火洗礼。"},{"op":"background","image":"bg018"},{"op":"bodies","images":[]},{"op":"set","target":["v","z",323],"value":1},{"op":"text","speaker":"不良A","text":"「哟，你站住。生面孔嘛？」"},{"op":"text","speaker":"不良B","text":"「谁允许你在这条走廊上走的，嗯？」"},{"op":"text","speaker":"谜之转校生","text":"「给我让开，不然我看中的面包…恶魔羊角面包就要卖光了。」"},{"op":"text","speaker":"不良C","text":"「你知不知道现在这什么情况啊？」"},{"op":"text","speaker":"","text":"啪叽！咔嚓！咚！"},{"op":"text","speaker":"不良A","text":"「唔哦…这么多人他一瞬间就…」"},{"op":"text","speaker":"不良B","text":"「好强…太强了…」"},{"op":"text","speaker":"不良C","text":"「他…他是怪兽吗…」"},{"op":"text","speaker":"谜之转校生","text":"「你说怪兽…？」"},{"op":"bodies","images":["cgsh13"]},{"op":"callScene","scene":9073,"entry":0},{"op":"text","speaker":"春原","text":"「是啊…偶尔会想要使用暴力的…」"},{"op":"text","speaker":"春原","text":"「盘踞在我心中的凶暴之物，那简直就是怪兽…」"},{"op":"text","speaker":"朋也","text":"「我看是史莱姆吧。」"},{"op":"text","speaker":"春原","text":"「对…是史莱姆。」"},{"op":"bodies","images":["cgsh21"]},{"op":"text","speaker":"春原","text":"「我正是史莱姆春原！」"},{"op":"callScene","scene":9073,"entry":1},{"op":"set","target":["v","f",1112],"value":1},{"op":"background","image":"bg021b"},{"op":"bodies","images":[]},{"op":"set","target":["v","z",314],"value":1},{"op":"bodies","images":["cgsh23"]},{"op":"text","speaker":"春原","text":"「喂，完全不可怕好吗！」"},{"op":"text","speaker":"春原","text":"「羊角面包听起来都比我强啊！」"},{"op":"text","speaker":"朋也","text":"「说起来，你刚才一个人在那嘀咕什么呢？」"},{"op":"text","speaker":"春原","text":"「不是你让我这么干的吗！」"},{"op":"text","speaker":"朋也","text":"「啊？这又怎么说？」"},{"op":"bodies","images":["cgsh16"]},{"op":"text","speaker":"春原","text":"「你这人真是健忘…」"},{"op":"text","speaker":"朋也","text":"「嗯，细想起来，我昨天好像还真说过，又好像没说过…」"},{"op":"text","speaker":"春原","text":"「算了，已经无所谓了。」"},{"op":"ifFalse","to":423,"condition":["==",["v","f",306],1]},{"op":"callScene","scene":3424,"entry":1},{"op":"ifFalse","to":422,"condition":["==",["v","f",307],0]},{"op":"jumpScene","scene":3425,"entry":0},{"op":"set","target":["v","z",314],"value":1},{"op":"ifFalse","to":484,"condition":["==",["v","f",17],1]},{"op":"background","image":"bg018"},{"op":"bodies","images":[]},{"op":"bodies","images":["cgsh19"]},{"op":"text","speaker":"春原","text":"「说起来，冈崎啊…」"},{"op":"ifFalse","to":435,"condition":["==",["v","f",307],0]},{"op":"text","speaker":"","text":"在去食堂的路上，春原一本正经地说。"},{"op":"text","speaker":"春原","text":"「…你应该还记得吧，我妹妹的事。」"},{"op":"text","speaker":"朋也","text":"「嗯？你说猪排饭怎么了？」"},{"op":"bodies","images":["cgsh16"]},{"op":"text","speaker":"春原","text":"「你还真是完全进入午饭状态了是吧！」"},{"op":"goto","to":440},{"op":"ifFalse","to":440,"condition":["==",["v","f",307],1]},{"op":"text","speaker":"春原","text":"「…你应该还记得吧，我妹妹的事。」"},{"op":"text","speaker":"朋也","text":"「嗯，咖喱面包和蜜瓜面包很好吃，你说的真是没错。」"},{"op":"bodies","images":["cgsh16"]},{"op":"text","speaker":"春原","text":"「你要听错也得有个度啊。」"},{"op":"bodies","images":["cgsh18"]},{"op":"text","speaker":"春原","text":"「我说的是我妹妹，她打来的电话，是你接的对吧。」"},{"op":"text","speaker":"","text":"他这么一说，我记起了昨天的事。"},{"op":"text","speaker":"朋也","text":"「嗯，我记得…她好像在用仅存的最后一点理性，告诉我了什么。」"},{"op":"bodies","images":["cgsh23"]},{"op":"text","speaker":"春原","text":"「你打算把我妹妹当成什么东西啊！」"},{"op":"text","speaker":"春原","text":"「你倒是认真回忆一下啊！你不是装成我的样子，最后还搞得我妹妹要来这里了吗。」"},{"op":"text","speaker":"朋也","text":"「好像是有这么回事…话说，你这是想要我干什么？」"},{"op":"bodies","images":["cgsh14"]},{"op":"text","speaker":"春原","text":"「我昨天不是已经说了嘛…」"},{"op":"text","speaker":"春原","text":"「要让她看看，我已经获得到了另外一种幸福啊。」"},{"op":"bodies","images":["cgsh16"]},{"op":"text","speaker":"春原","text":"「昨天是谁说一切包在他身上的呀？」"},{"op":"text","speaker":"朋也","text":"「嗯…是那边那位吗？」"},{"op":"bodies","images":["cgsh23"]},{"op":"text","speaker":"春原","text":"「就是你啊，冈崎！」"},{"op":"bodies","images":["cgsh16"]},{"op":"text","speaker":"春原","text":"「你该不会…觉得这事麻烦，打算逃避了…」"},{"op":"choice","id":"424:54580","target":["v","f",1089],"items":[{"text":"逃避","value":0,"serial":54580},{"text":"接受","value":1,"serial":54590}]},{"op":"ifFalse","to":482,"condition":["==",["v","f",1089],0]},{"op":"text","speaker":"朋也","text":"「嗯，我要逃避了。」"},{"op":"bodies","images":["cgsh23"]},{"op":"text","speaker":"春原","text":"「别说得那么理直气壮好吗！」"},{"op":"bodies","images":["cgsh16"]},{"op":"text","speaker":"春原","text":"「不过说到底，我也是够蠢才会找你帮忙…」"},{"op":"text","speaker":"朋也","text":"「不管你怎么挣扎，还是一样蠢。」"},{"op":"bodies","images":["cgsh17"]},{"op":"text","speaker":"春原","text":"「是啊，反正我就叫蠢原！真是对不起您了！」"},{"op":"text","speaker":"朋也","text":"「我又没说这是你的错。」"},{"op":"text","speaker":"朋也","text":"「我自己也很蠢。」"},{"op":"bodies","images":["cgsh20"]},{"op":"text","speaker":"春原","text":"「………」"},{"op":"text","speaker":"春原","text":"「冈崎。」"},{"op":"text","speaker":"朋也","text":"「怎么了？」"},{"op":"bodies","images":["cgsh10"]},{"op":"text","speaker":"春原","text":"「我就是喜欢你这点。」"},{"op":"text","speaker":"朋也","text":"「………」"},{"op":"text","speaker":"朋也","text":"「算了…我当笨蛋，你改当弱智吧。」"},{"op":"bodies","images":["cgsh23"]},{"op":"text","speaker":"春原","text":"「我们做同类不行吗！」"},{"op":"text","speaker":"朋也","text":"「才不要…」"},{"op":"goto","to":484},{"op":"ifFalse","to":484,"condition":["==",["v","f",1089],1]},{"op":"jumpScene","scene":7400,"entry":0},{"op":"ifFalse","to":510,"condition":["==",["v","f",307],0]},{"op":"background","image":"kuro"},{"op":"bodies","images":[]},{"op":"background","image":"bg025"},{"op":"bodies","images":[]},{"op":"bodies","images":["cgsh16"]},{"op":"text","speaker":"春原","text":"「今天，依旧吃面包吧…」"},{"op":"text","speaker":"朋也","text":"「嗯。」"},{"op":"background","image":"bg018"},{"op":"bodies","images":[]},{"op":"text","speaker":"朋也","text":"「你今天不用去想新的打工了？」"},{"op":"bodies","images":["cgsh18"]},{"op":"text","speaker":"春原","text":"「因为总是找不到看得上眼的嘛。」"},{"op":"text","speaker":"朋也","text":"「我在想啊…其实你直接去买彩票不就好了吗？」"},{"op":"bodies","images":["cgsh12"]},{"op":"text","speaker":"春原","text":"「啊？我看起来，居然这么好运？」"},{"op":"text","speaker":"朋也","text":"「不是呀，看你的生活，简直就像被好运抛弃了一样不是吗？」"},{"op":"text","speaker":"朋也","text":"「所以我在想，这样是不是反而把你的运气都存起来了。」"},{"op":"bodies","images":["cgsh23"]},{"op":"text","speaker":"春原","text":"「哦，好像是哦。」"},{"op":"text","speaker":"朋也","text":"「你这干脆的反应是怎么回事。我难得认真为你考虑的。」"},{"op":"background","image":"bg021e"},{"op":"bodies","images":[]},{"op":"text","speaker":"朋也","text":"「你就买一次试试吧。说不定会让你有生以来第一次觉得活着真好。」"},{"op":"bodies","images":["cgsh23"]},{"op":"text","speaker":"春原","text":"「我的人生，看起来真的就这么不堪吗？」"},{"op":"ifFalse","to":513,"condition":["&&",["==",["v","f",504],1],["==",["v","f",505],0]]},{"op":"jumpScene","scene":5424,"entry":0},{"op":"goto","to":516},{"op":"ifFalse","to":516,"condition":["||",["==",["v","f",504],0],["==",["v","f",505],1]]},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"今天的午休，我依旧靠戏弄春原打发了。"},{"op":"background","image":"bg021a"},{"op":"bodies","images":[]},{"op":"set","target":["v","z",313],"value":1},{"op":"text","speaker":"","text":"………。"},{"op":"ifFalse","to":537,"condition":["==",["v","f",819],1]},{"op":"background","image":"kuro"},{"op":"bodies","images":[]},{"op":"background","image":"bg018"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"第五节课结束后的课间休息。"},{"op":"text","speaker":"","text":"我再次走出教室去买饮料。"},{"op":"text","speaker":"","text":"回来路上。"},{"op":"text","speaker":"","text":"同样的，那个小家伙又从我身边跑过。"},{"op":"choice","id":"424:55020","target":["v","f",1089],"items":[{"text":"叫住她","value":0,"serial":55020},{"text":"还是算了","value":1,"serial":55030}]},{"op":"ifFalse","to":534,"condition":["==",["v","f",1089],0]},{"op":"set","target":["v","f",126],"value":["+",["v","f",126],1]},{"op":"callScene","scene":1004,"entry":0},{"op":"goto","to":537},{"op":"ifFalse","to":537,"condition":["==",["v","f",1089],1]},{"op":"text","speaker":"朋也","text":"（这家伙把精力都浪费在这种无聊的事上了啊…）"},{"op":"text","speaker":"","text":"目送她离开。"},{"op":"background","image":"kuro"},{"op":"bodies","images":[]},{"op":"background","image":"bg021h"},{"op":"bodies","images":[]},{"op":"set","target":["v","z",313],"value":1},{"op":"text","speaker":"","text":"放学后。"},{"op":"bodies","images":["cgsh14"]},{"op":"text","speaker":"春原","text":"「冈崎…你来我房间等着。」"},{"op":"text","speaker":"","text":"春原一下子站起身，目视前方，对我说到。"},{"op":"text","speaker":"朋也","text":"「你这没来由的干什么呀？」"},{"op":"text","speaker":"春原","text":"「别问了，你就去等着吧。」"},{"op":"text","speaker":"朋也","text":"「你呢？」"},{"op":"bodies","images":["cgsh16"]},{"op":"text","speaker":"春原","text":"「我去拿一样东西就回来。」"},{"op":"text","speaker":"朋也","text":"「拿一样东西…？」"},{"op":"text","speaker":"春原","text":"「那我走了…」"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"春原也不回答我的提问，便走出了教室。"},{"op":"background","image":"bg046y"},{"op":"bodies","images":[]},{"op":"set","target":["v","f",1118],"value":3},{"op":"text","speaker":"","text":"我在春原的房间等着。"},{"op":"text","speaker":"","text":"不知什么时候，电视机已经不见了。"},{"op":"text","speaker":"","text":"或许是因为不够打发时间，就干脆还掉了吧。"},{"op":"text","speaker":"朋也","text":"（我本来还想看看相声录像的呢…）"},{"op":"text","speaker":"","text":"春原终于回来了。"},{"op":"bodies","images":["cgsh15"]},{"op":"text","speaker":"春原","text":"「让你久等啦…」"},{"op":"text","speaker":"朋也","text":"「你说话别这么阴沉。」"},{"op":"bodies","images":["cgsh13"]},{"op":"text","speaker":"春原","text":"「哼…就算我不这样，你听了我说的话也会变成这样的。」"},{"op":"text","speaker":"朋也","text":"「到底怎么了啊？」"},{"op":"bodies","images":["cgsh18"]},{"op":"text","speaker":"春原","text":"「你拿着这个。」"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"说着，他从手里拎着的纸袋子里取出的是一把枪，以及一个盒子形状的感应器一样的小东西。"},{"op":"text","speaker":"","text":"他把这些摆在桌上。"},{"op":"text","speaker":"朋也","text":"「你倒是解释一下啊。」"},{"op":"set","target":["v","z",321],"value":1},{"op":"bodies","images":["cgsh13"]},{"op":"text","speaker":"春原","text":"「嗯…」"},{"op":"text","speaker":"春原","text":"「最近，我一直在思考怎么才能有意义地打发时间，但所有尝试都失败了。」"},{"op":"text","speaker":"朋也","text":"「顺带一提，只有你是这样哦。」"},{"op":"text","speaker":"春原","text":"「然后我就在商店街溜达，想着新的办法来打发时间。」"},{"op":"text","speaker":"朋也","text":"「既然你都醒了，还是应该来上学啊。」"},{"op":"text","speaker":"春原","text":"「接着，我就在玩具店门口遇到了一个男的。」"},{"op":"text","speaker":"春原","text":"「他对我这么说了。」"},{"op":"bodies","images":["cgsh18"]},{"op":"text","speaker":"春原","text":"「如果有空，就一起来玩吧。」"},{"op":"bodies","images":["cgsh15"]},{"op":"text","speaker":"春原","text":"「然后他交给我的，就是这个…」"},{"op":"bodies","images":["cgsh18"]},{"op":"text","speaker":"春原","text":"「…『赤红闪电魔蝎』。」"},{"op":"text","speaker":"春原","text":"「是把感应器戴在身上，互相射击玩的对战型玩具。」"},{"op":"bodies","images":["cgsh13"]},{"op":"text","speaker":"春原","text":"「这简直就是根救命稻草，我二话没说就答应下来了。」"},{"op":"text","speaker":"春原","text":"「当然，我也把你算进去了。」"},{"op":"text","speaker":"朋也","text":"「别擅自把我算进去啊。」"},{"op":"text","speaker":"春原","text":"「于是，今天我就拿来了我的一套，还有你的一套。」"},{"op":"text","speaker":"朋也","text":"「原来是这样…」"},{"op":"bodies","images":["cgsh18"]},{"op":"text","speaker":"春原","text":"「但是，这个游戏的失败者会受到惩罚。」"},{"op":"text","speaker":"朋也","text":"「是什么？」"},{"op":"text","speaker":"春原","text":"「必须在一周时间里，服从胜利者的所有命令。」"},{"op":"text","speaker":"春原","text":"「不管是什么内容的命令。」"},{"op":"text","speaker":"春原","text":"「这就是规矩…」"},{"op":"ifFalse","to":606,"condition":["==",["v","f",218],0]},{"op":"text","speaker":"朋也","text":"「这样啊…这就是你这么说话的原因啊。」"},{"op":"goto","to":608},{"op":"ifFalse","to":608,"condition":["==",["v","f",218],1]},{"op":"text","speaker":"朋也","text":"「…这就是你说话这么阴沉的原因啊。」"},{"op":"bodies","images":["cgsh13"]},{"op":"text","speaker":"春原","text":"「嗯…这是场真刀真枪的较量。」"},{"op":"text","speaker":"春原","text":"「哈哈，这种寒毛直竖的感觉…真不错…」"},{"op":"text","speaker":"春原","text":"「这就是所谓武士的战栗吗…」"},{"op":"text","speaker":"春原","text":"「行了，赶紧把感应器放到校服口袋里，然后拿起枪吧…」"},{"op":"text","speaker":"春原","text":"「那一刻起，我和你，就是敌人了…」"},{"op":"text","speaker":"朋也","text":"「也就是说…只要穿着校服，就是交战状态对吧。」"},{"op":"text","speaker":"春原","text":"「正是…」"},{"op":"text","speaker":"朋也","text":"「我想先问问你。」"},{"op":"text","speaker":"春原","text":"「怎么…」"},{"op":"text","speaker":"朋也","text":"「还有其他人玩吗…？」"},{"op":"ifFalse","to":642,"condition":["&&",["&&",["==",["v","f",208],1],["==",["v","f",214],0]],["==",["v","f",218],0]]},{"op":"bodies","images":["cgsh18"]},{"op":"text","speaker":"春原","text":"「有。另外还有两个。」"},{"op":"text","speaker":"春原","text":"「你也认识的…」"},{"op":"text","speaker":"春原","text":"「一个是…坂上智代。」"},{"op":"text","speaker":"朋也","text":"「你等一下，怎么又是她？」"},{"op":"bodies","images":["cgsh15"]},{"op":"text","speaker":"春原","text":"「我邀请了她，她就答应了呀…」"},{"op":"text","speaker":"春原","text":"「我也觉得不可思议…不过看起来她的目的是想让我们不要再迟到了…」"},{"op":"text","speaker":"朋也","text":"「那还真是用心良苦啊…」"},{"op":"bodies","images":["cgsh18"]},{"op":"text","speaker":"春原","text":"「而另外一人，是藤林杏…」"},{"op":"text","speaker":"春原","text":"「我就说明了一下规则，不知怎么的这家伙就答应了…」"},{"op":"bodies","images":["cgsh15"]},{"op":"text","speaker":"春原","text":"「我看她是非常想整我们…」"},{"op":"text","speaker":"朋也","text":"「她到底会逼我们做什么，可真想象不到啊。」"},{"op":"bodies","images":["cgsh24"]},{"op":"text","speaker":"春原","text":"「呵呵，那我们赢了就行，赢了就行…」"},{"op":"text","speaker":"朋也","text":"「也就是说，只要打赢了你，还有包含邀请了你的那个男的在内的四个人，就算获胜对吧？」"},{"op":"bodies","images":["cgsh13"]},{"op":"text","speaker":"春原","text":"「正是如此…」"},{"op":"set","target":["v","f",839],"value":1},{"op":"goto","to":655},{"op":"ifFalse","to":655,"condition":["||",["||",["==",["v","f",208],0],["==",["v","f",214],1]],["==",["v","f",218],1]]},{"op":"bodies","images":["cgsh18"]},{"op":"text","speaker":"春原","text":"「有。另外还有一个。」"},{"op":"text","speaker":"春原","text":"「你也认识的…就是藤林杏…」"},{"op":"bodies","images":["cgsh15"]},{"op":"text","speaker":"春原","text":"「我就说明了一下规则，不知怎么的这家伙就答应了…」"},{"op":"text","speaker":"春原","text":"「我看她是非常想整我们…」"},{"op":"text","speaker":"朋也","text":"「她到底会逼我们做什么，可真想象不到啊。」"},{"op":"bodies","images":["cgsh24"]},{"op":"text","speaker":"春原","text":"「呵呵，那我们赢了就行，赢了就行…」"},{"op":"text","speaker":"朋也","text":"「也就是说，只要打赢了你，还有包含邀请了你的那个男的在内的三个人，就算获胜对吧？」"},{"op":"bodies","images":["cgsh13"]},{"op":"text","speaker":"春原","text":"「正是如此…」"},{"op":"text","speaker":"春原","text":"「那么…就开始吧。」"},{"op":"choice","id":"424:55930","target":["v","f",1089],"items":[{"text":"同意","value":0,"serial":55930},{"text":"拒绝","value":1,"serial":55940}]},{"op":"ifFalse","to":659,"condition":["==",["v","f",1089],0]},{"op":"goto","to":700},{"op":"ifFalse","to":700,"condition":["==",["v","f",1089],1]},{"op":"text","speaker":"朋也","text":"「还是算了。」"},{"op":"set","target":["v","z",314],"value":1},{"op":"bodies","images":["cgsh27"]},{"op":"text","speaker":"春原","text":"「…哎？」"},{"op":"text","speaker":"朋也","text":"「我都说了我不玩了。」"},{"op":"text","speaker":"春原","text":"「为什么啊？」"},{"op":"text","speaker":"朋也","text":"「要是别人赢了，我可不晓得他们会逼我干些什么。」"},{"op":"text","speaker":"春原","text":"「可要是赢了，就可以命令输家干任何事了呀。」"},{"op":"ifFalse","to":673,"condition":["==",["v","f",839],1]},{"op":"text","speaker":"春原","text":"「你想想，那可是智代和杏啊。」"},{"op":"bodies","images":["cgsh16"]},{"op":"text","speaker":"春原","text":"「可以让她们一齐，干这样那样的事…」"},{"op":"goto","to":677},{"op":"ifFalse","to":677,"condition":["==",["v","f",839],0]},{"op":"text","speaker":"春原","text":"「你想想，那可是杏啊。」"},{"op":"bodies","images":["cgsh16"]},{"op":"text","speaker":"春原","text":"「可以让她干，这样那样的事情…」"},{"op":"bodies","images":["cgsh23"]},{"op":"text","speaker":"春原","text":"「哎哟，不好，我都兴奋起来了！」"},{"op":"text","speaker":"朋也","text":"「你就一个人兴奋去吧。」"},{"op":"bodies","images":["cgsh13"]},{"op":"text","speaker":"春原","text":"「算了，就这样吧，就当我少了一个对手。」"},{"op":"bodies","images":["cgsh12"]},{"op":"text","speaker":"春原","text":"「嘿嘿，那么，我就去啦。」"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"春原一副趾高气昂的丢人模样，走出了房间。"},{"op":"text","speaker":"","text":"………。"},{"op":"text","speaker":"","text":"远处，传来噼噼噼的警报声。"},{"op":"text","speaker":"","text":"………。"},{"op":"bodies","images":["cgsh26"]},{"op":"set","target":["v","z",314],"value":1},{"op":"text","speaker":"春原","text":"「…被干掉了。」"},{"op":"text","speaker":"朋也","text":"「我就知道。」"},{"op":"ifFalse","to":695,"condition":["==",["v","f",839],1]},{"op":"text","speaker":"","text":"归根结底，跟那两个人为敌，会赢才怪了。"},{"op":"text","speaker":"春原","text":"「哎…不知道我会被罚做什么事啊…」"},{"op":"text","speaker":"","text":"真是可悲。"},{"op":"ifFalse","to":699,"condition":["==",["v","f",320],3]},{"op":"callScene","scene":7600,"entry":3},{"op":"goto","to":816},{"op":"bodies","images":[]},{"op":"text","speaker":"朋也","text":"「好吧…」"},{"op":"text","speaker":"","text":"我把感应器放进胸袋里。"},{"op":"text","speaker":"","text":"同时…"},{"op":"set","target":["v","z",323],"value":1},{"op":"text","speaker":"","text":"春原把枪顶在了我的胸口。"},{"op":"text","speaker":"朋也","text":"「…嗯？」"},{"op":"bodies","images":["cgsh13"]},{"op":"text","speaker":"春原","text":"「不好意思，这里就是你的…Tha End了。」"},{"op":"text","speaker":"朋也","text":"「你这人，怎么这么卑鄙啊。」"},{"op":"text","speaker":"朋也","text":"「另外，是The，不是Tha啦。」"},{"op":"text","speaker":"春原","text":"「哼…为了胜利，我可是不择手段的…」"},{"op":"ifFalse","to":719,"condition":["==",["v","f",839],1]},{"op":"text","speaker":"朋也","text":"「你干吗一定要赢过我呀？只要赢过智代和杏不就行了？」"},{"op":"text","speaker":"春原","text":"「不，我要赢…」"},{"op":"text","speaker":"春原","text":"「你想想，我可以命令智代和杏做任何事啊。」"},{"op":"bodies","images":["cgsh16"]},{"op":"text","speaker":"春原","text":"「让她们一齐，干这样那样的事…」"},{"op":"goto","to":725},{"op":"ifFalse","to":725,"condition":["==",["v","f",839],0]},{"op":"text","speaker":"朋也","text":"「你干嘛一定要赢过我呀？只要赢过杏不就行了？」"},{"op":"text","speaker":"春原","text":"「不，我要赢…」"},{"op":"text","speaker":"春原","text":"「你想想，我可以命令杏做任何事啊。」"},{"op":"bodies","images":["cgsh16"]},{"op":"text","speaker":"春原","text":"「这样那样的事情…」"},{"op":"bodies","images":["cgsh23"]},{"op":"text","speaker":"春原","text":"「哎哟，不好，我都兴奋起来了！」"},{"op":"text","speaker":"朋也","text":"「你就兴奋去吧。」"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"我绕过正按着鼻血的春原的手臂，从桌上拿起枪。"},{"op":"text","speaker":"朋也","text":"「游戏结束了。」"},{"op":"text","speaker":"","text":"我把枪口顶在春原胸口。"},{"op":"bodies","images":["cgsh27"]},{"op":"text","speaker":"春原","text":"「…哎？」"},{"op":"text","speaker":"","text":"扣动扳机。"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"哔哔哔哔哔哔ーーーーーーーーーー！"},{"op":"text","speaker":"","text":"几乎要撕裂耳膜的警报声。"},{"op":"bodies","images":["cgsh23"]},{"op":"text","speaker":"春原","text":"「呃啊啊啊啊啊ーーー！」"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"因为落败的打击，春原仰面摔在地上。"},{"op":"text","speaker":"朋也","text":"「第一个…」"},{"op":"text","speaker":"","text":"我把枪插进屁股上的口袋。"},{"op":"bodies","images":["cgsh26"]},{"op":"text","speaker":"春原","text":"「冈崎…」"},{"op":"text","speaker":"","text":"春原躺在地板上，泪眼婆娑地仰视着我。"},{"op":"text","speaker":"朋也","text":"「怎么了？」"},{"op":"text","speaker":"春原","text":"「等你获胜的那一天…记得分我一杯羹哦…」"},{"op":"text","speaker":"朋也","text":"「可以啊。」"},{"op":"text","speaker":"春原","text":"「冈崎，你这人，果然是我的好朋友啊！」"},{"op":"ifFalse","to":759,"condition":["==",["v","f",839],1]},{"op":"text","speaker":"朋也","text":"「我会请那两个人把你摁在地上打的。」"},{"op":"bodies","images":["cgsh25"]},{"op":"text","speaker":"春原","text":"「好耶！」"},{"op":"bodies","images":["cgsh23"]},{"op":"text","speaker":"春原","text":"「喂，我是受虐狂吗！」"},{"op":"text","speaker":"朋也","text":"「想象你被两个女的打趴下的样子，的确让人兴奋啊，就这样办吧，嗯。」"},{"op":"goto","to":766},{"op":"ifFalse","to":766,"condition":["==",["v","f",839],0]},{"op":"text","speaker":"朋也","text":"「我会请杏把你摁在地上打的。」"},{"op":"bodies","images":["cgsh25"]},{"op":"text","speaker":"春原","text":"「好耶！」"},{"op":"bodies","images":["cgsh23"]},{"op":"text","speaker":"春原","text":"「喂，我是受虐狂吗！」"},{"op":"text","speaker":"朋也","text":"「想象你被女的打趴下的样子，的确让人兴奋啊，就这样办吧，嗯。」"},{"op":"text","speaker":"春原","text":"「唔啊啊啊，你不许赢哦，一定要输啊。」"},{"op":"text","speaker":"朋也","text":"「随你怎么祈祷吧。」"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"接下来…"},{"op":"text","speaker":"","text":"要在这里守株待兔，也得先把衣服换了啊…。"},{"op":"text","speaker":"朋也","text":"「春原，你要是想好过一点，就跟我来吧。」"},{"op":"bodies","images":["cgsh27"]},{"op":"text","speaker":"春原","text":"「嗯？真的？我去我去！」"},{"op":"background","image":"bg045y"},{"op":"bodies","images":[]},{"op":"set","target":["v","f",1118],"value":4},{"op":"set","target":["v","z",328],"value":1},{"op":"text","speaker":"","text":"………。"},{"op":"text","speaker":"","text":"好像没有人的动静…。"},{"op":"text","speaker":"","text":"…看来毕竟不方便进来这里啊。"},{"op":"text","speaker":"朋也","text":"「你先上，春原。」"},{"op":"text","speaker":"","text":"我用枪口对他示意。"},{"op":"bodies","images":["cgsh16"]},{"op":"text","speaker":"春原","text":"「怎么搞的我像人质一样…」"},{"op":"text","speaker":"朋也","text":"「你想好过一点对吧？」"},{"op":"bodies","images":["cgsh23"]},{"op":"text","speaker":"春原","text":"「我想啊！」"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"砰！"},{"op":"text","speaker":"春原","text":"「…哎？」"},{"op":"text","speaker":"","text":"身边的房间门猛地被打开了。"},{"op":"text","speaker":"朋也","text":"「没想到，会在这里…」"},{"op":"text","speaker":"","text":"脚下有影子！"},{"op":"text","speaker":"朋也","text":"「下面！？」"},{"op":"text","speaker":"","text":"哔哔哔哔哔哔ーーーーーーーー！"},{"op":"text","speaker":"","text":"…被干掉了…不对…"},{"op":"bodies","images":["cgsh16"]},{"op":"text","speaker":"春原","text":"「我，又一次被干掉了…」"},{"op":"text","speaker":"","text":"响起来的，是走在我前面的春原身上的感应器。"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"而人影，已经消失了。"},{"op":"text","speaker":"","text":"要是没把春原带来，刚才被干掉的肯定就是我了…。"},{"op":"text","speaker":"","text":"因为感应器在胸袋里，所以只会对正面的攻击起反应。"},{"op":"text","speaker":"","text":"对方也是考虑到这一点，才从正面发动突袭的。"},{"op":"text","speaker":"朋也","text":"「我说，春原啊…」"},{"op":"text","speaker":"朋也","text":"「我觉得，我们真的是在跟不得了的对手较量啊…」"},{"op":"bodies","images":["cgsh13"]},{"op":"text","speaker":"春原","text":"「嘿嘿…看来你被干掉也只是时间问题了…」"},{"op":"text","speaker":"朋也","text":"「你就不想好过一点吗？」"},{"op":"bodies","images":["cgsh23"]},{"op":"text","speaker":"春原","text":"「冈崎，我替你加油！」"},{"op":"text","speaker":"","text":"此后，我就带着春原回家换完衣服，一直活到这天游戏结束。"},{"op":"text","speaker":"","text":"明天还要带着这种紧张感过一整天啊…。"},{"op":"text","speaker":"","text":"感觉命都要没了…。"},{"op":"set","target":["v","f",838],"value":1},{"op":"background","image":"kuro"},{"op":"bodies","images":[]},{"op":"set","target":["v","f",1118],"value":0},{"op":"jumpScene","scene":425,"entry":0},{"op":"return"}]