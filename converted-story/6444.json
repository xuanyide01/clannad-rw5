[{"op":"ifFalse","to":2,"condition":["==",["v","f",20],1]},{"op":"goto","to":212},{"op":"set","target":["v","z",316],"value":1},{"op":"background","image":"bg033a"},{"op":"bodies","images":[]},{"op":"bodies","images":["cgng10"]},{"op":"set","target":["v","s",0],"value":["call","global.namae",["％Ｅ"]]},{"op":"set","target":["v","s",1],"value":["+","岡","崎さん"]},{"op":"ifFalse","to":9,"condition":["==",["v","s",0],["v","s",1]]},{"op":"text","speaker":"名前＿渚","text":"「《＄呼称＿渚→朋也》，早上好。」"},{"op":"text","speaker":"朋也","text":"「哦，早…」"},{"op":"text","speaker":"朋也","text":"「哈欠…」"},{"op":"bodies","images":["cgng13"]},{"op":"text","speaker":"名前＿渚","text":"「今天似乎也很困。」"},{"op":"text","speaker":"朋也","text":"「晚上睡得晚，没办法啊…」"},{"op":"bodies","images":["cgng16"]},{"op":"text","speaker":"名前＿渚","text":"「晚上要早些睡。」"},{"op":"text","speaker":"名前＿渚","text":"「这样早上醒得也早…」"},{"op":"text","speaker":"名前＿渚","text":"「我们早上，就能说更多的话了。」"},{"op":"bodies","images":["cgng31"]},{"op":"text","speaker":"名前＿渚","text":"「也就不会一个人说一个人听了。」"},{"op":"text","speaker":"朋也","text":"「你…对我，有什么期待啊…」"},{"op":"text","speaker":"朋也","text":"「我就算人很清醒，也不会主动开口说什么的…」"},{"op":"bodies","images":["cgng32"]},{"op":"set","target":["v","s",0],"value":["call","global.namae",["％Ｅ"]]},{"op":"set","target":["v","s",1],"value":["+","岡","崎さん"]},{"op":"ifFalse","to":27,"condition":["==",["v","s",0],["v","s",1]]},{"op":"text","speaker":"名前＿渚","text":"「没有，下午《＄呼称＿渚→朋也》就会和我说很多话。」"},{"op":"text","speaker":"名前＿渚","text":"「早上就是我说得比较多。」"},{"op":"ifFalse","to":39,"condition":["==",["v","f",136],0]},{"op":"text","speaker":"朋也","text":"「那你不说话不就好了。」"},{"op":"bodies","images":["cgng16"]},{"op":"text","speaker":"古河","text":"「哎…」"},{"op":"text","speaker":"朋也","text":"「你也没必要一大早就努力说这么多话吧。」"},{"op":"text","speaker":"朋也","text":"「而且，我是在温存体力上课。」"},{"op":"bodies","images":["cgng12"]},{"op":"text","speaker":"古河","text":"「原来是这样啊…」"},{"op":"text","speaker":"朋也","text":"「你也这样做吧。」"},{"op":"goto","to":47},{"op":"ifFalse","to":47,"condition":["==",["v","f",136],1]},{"op":"text","speaker":"朋也","text":"「我也没拜托你说啊。」"},{"op":"bodies","images":["cgng16"]},{"op":"text","speaker":"渚","text":"「哎…」"},{"op":"text","speaker":"朋也","text":"「你也没必要一大早就努力说这么多话吧。」"},{"op":"text","speaker":"朋也","text":"「小心上课的时候体力不够啊？」"},{"op":"text","speaker":"朋也","text":"「别一大清早就浪费体力。」"},{"op":"bodies","images":["cgng12"]},{"op":"text","speaker":"名前＿渚","text":"「呃…」"},{"op":"bodies","images":["cgng32"]},{"op":"text","speaker":"名前＿渚","text":"「好…」"},{"op":"text","speaker":"","text":"她回了一声就不出声了。"},{"op":"bodies","images":["cgng30"]},{"op":"text","speaker":"名前＿渚","text":"「………」"},{"op":"text","speaker":"","text":"我们就这样沉默着走了一段距离。"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"走着走着，我渐渐觉得周围学生的对话声有些吵闹。"},{"op":"text","speaker":"","text":"更令人气愤的是，他们似乎都聊的很开心。"},{"op":"text","speaker":"朋也","text":"（我都忘记了…这种情况，我一直都是很讨厌的…）"},{"op":"text","speaker":"朋也","text":"「………」"},{"op":"text","speaker":"","text":"…拉扯。"},{"op":"text","speaker":"","text":"《＄呼称＿朋也→渚》拉住了我的衣角。"},{"op":"bodies","images":["cgng30"]},{"op":"text","speaker":"名前＿渚","text":"「…那个。」"},{"op":"text","speaker":"朋也","text":"「啊？怎么了。」"},{"op":"bodies","images":["cgng31"]},{"op":"text","speaker":"名前＿渚","text":"「我还是想和你说说话。」"},{"op":"text","speaker":"名前＿渚","text":"「就算敷衍也好，我希望你能听我说。」"},{"op":"text","speaker":"朋也","text":"「啊…真巧啊。」"},{"op":"text","speaker":"朋也","text":"「…我现在也是这么想的。」"},{"op":"bodies","images":["cgng13z"]},{"op":"text","speaker":"名前＿渚","text":"「真的吗。」"},{"op":"text","speaker":"朋也","text":"「是啊…」"},{"op":"bodies","images":["cgng10z"]},{"op":"set","target":["v","s",0],"value":["call","global.namae",["％Ｅ"]]},{"op":"set","target":["v","s",1],"value":["+","岡","崎さん"]},{"op":"ifFalse","to":76,"condition":["==",["v","s",0],["v","s",1]]},{"op":"text","speaker":"名前＿渚","text":"「那，《＄呼称＿渚→朋也》也说点什么吧。」"},{"op":"text","speaker":"朋也","text":"「………」"},{"op":"bodies","images":["cgng23"]},{"op":"text","speaker":"名前＿渚","text":"「………」"},{"op":"text","speaker":"朋也","text":"「………」"},{"op":"text","speaker":"名前＿渚","text":"「………」"},{"op":"text","speaker":"朋也","text":"「………」"},{"op":"text","speaker":"","text":"…完全想不出话题来。"},{"op":"text","speaker":"","text":"我没说话，《＄呼称＿朋也→渚》却很耐心的等着我开口。"},{"op":"text","speaker":"朋也","text":"（真是…）"},{"op":"text","speaker":"","text":"算了，想到什么说什么吧。"},{"op":"text","speaker":"","text":"我看着《＄呼称＿朋也→渚》那抬起来的脸…"},{"op":"ifFalse","to":104,"condition":["==",["v","f",136],0]},{"op":"bodies","images":[]},{"op":"text","speaker":"朋也","text":"「你还挺可爱的。」"},{"op":"text","speaker":"","text":"顺口就说出来了。"},{"op":"text","speaker":"朋也","text":"（喂，我怎么连这种没羞没臊的话都说出来了！）"},{"op":"text","speaker":"","text":"我脸上逐渐变得通红。"},{"op":"text","speaker":"","text":"而《＄呼称＿朋也→渚》也和我一样。"},{"op":"bodies","images":["cgng32"]},{"op":"text","speaker":"古河","text":"「没有的事，我一点都不可爱的。」"},{"op":"bodies","images":["cgng31"]},{"op":"text","speaker":"古河","text":"「不过，还是要谢谢你。」"},{"op":"text","speaker":"朋也","text":"「对了，昨天我们家厨房，爬出了一只超大型的蟑螂。」"},{"op":"bodies","images":["cgng19"]},{"op":"text","speaker":"古河","text":"「那，那真是太恐怖了。」"},{"op":"text","speaker":"","text":"我们两个都觉得不好意思。于是强行换了个话题。"},{"op":"goto","to":121},{"op":"ifFalse","to":121,"condition":["==",["v","f",136],1]},{"op":"bodies","images":[]},{"op":"text","speaker":"朋也","text":"「…我喜欢你。」"},{"op":"text","speaker":"","text":"顺口就说出来了。"},{"op":"text","speaker":"朋也","text":"（喂，我怎么连这种没羞没臊的话都说出来了！）"},{"op":"text","speaker":"","text":"我脸上逐渐变得通红。"},{"op":"text","speaker":"","text":"而渚也和我一样。"},{"op":"bodies","images":["cgng19"]},{"op":"text","speaker":"渚","text":"「谢…谢谢你。」"},{"op":"text","speaker":"渚","text":"「我也喜欢朋也君。」"},{"op":"text","speaker":"朋也","text":"「哦，是嘛…」"},{"op":"bodies","images":["cgng31"]},{"op":"text","speaker":"","text":"真是太羞耻了。"},{"op":"text","speaker":"朋也","text":"「对了，昨天我们家厨房，爬出了一只超大型的蟑螂。」"},{"op":"bodies","images":["cgng19"]},{"op":"text","speaker":"渚","text":"「那，那真是太恐怖了。」"},{"op":"text","speaker":"","text":"我们两个都觉得不好意思。于是强行换了个话题。"},{"op":"background","image":"bg012"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"再之后，我不停地说了许多话…"},{"op":"text","speaker":"朋也","text":"「假发公司广告打的越响，就说明他们公司就越恶劣。」"},{"op":"bodies","images":["cgng14"]},{"op":"text","speaker":"名前＿渚","text":"「噢…是这样啊。」"},{"op":"text","speaker":"朋也","text":"「嗯，所以说你要当心。」"},{"op":"bodies","images":["cgng17"]},{"op":"text","speaker":"名前＿渚","text":"「好的。」"},{"op":"background","image":"bg015"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"于是…到了学校的时候，我的喉咙已经快冒烟了。"},{"op":"text","speaker":"朋也","text":"「呃…」"},{"op":"text","speaker":"朋也","text":"（…我是不是傻啊。）"},{"op":"background","image":"bg018"},{"op":"bodies","images":[]},{"op":"text","speaker":"朋也","text":"「回见。」"},{"op":"bodies","images":["cgng10"]},{"op":"text","speaker":"名前＿渚","text":"「好的。」"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"我转过身，朝自己的教室走去。"},{"op":"text","speaker":"名前＿渚","text":"「那个。」"},{"op":"text","speaker":"","text":"《＄呼称＿朋也→渚》叫住了我。"},{"op":"text","speaker":"朋也","text":"「啊？」"},{"op":"text","speaker":"","text":"我停下脚步，回过头去。"},{"op":"bodies","images":["cgng10"]},{"op":"text","speaker":"名前＿渚","text":"「我很开心。」"},{"op":"text","speaker":"朋也","text":"「哦…」"},{"op":"bodies","images":["cgng19"]},{"op":"text","speaker":"名前＿渚","text":"「那个…我能提一个过分的要求吗…」"},{"op":"text","speaker":"朋也","text":"「………」"},{"op":"text","speaker":"朋也","text":"「行…」"},{"op":"text","speaker":"朋也","text":"「你说吧。」"},{"op":"bodies","images":["cgng32"]},{"op":"text","speaker":"名前＿渚","text":"「嗯…」"},{"op":"text","speaker":"名前＿渚","text":"「我希望，这样的早晨能一直持续下去。」"},{"op":"text","speaker":"","text":"啊…真巧。"},{"op":"text","speaker":"","text":"我也是这样想的。"},{"op":"bodies","images":["cgng31"]},{"op":"text","speaker":"名前＿渚","text":"「这个要求…太过分了吗…」"},{"op":"text","speaker":"朋也","text":"「………」"},{"op":"text","speaker":"朋也","text":"「嗯…」"},{"op":"text","speaker":"朋也","text":"「总之，明天换你来。」"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"说完，我又往前走去。"},{"op":"text","speaker":"名前＿渚","text":"「好的。」"},{"op":"text","speaker":"","text":"《＄呼称＿朋也→渚》响亮的回答从身后传来。"},{"op":"text","speaker":"","text":"我挥了挥手，走进了教室。"},{"op":"ifFalse","to":261,"condition":["==",["v","f",19],1]},{"op":"background","image":"kuro"},{"op":"bodies","images":[]},{"op":"background","image":"bg021b"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"午休时间。在去食堂之前，我看了一眼隔壁座位。"},{"op":"text","speaker":"","text":"那个座位从早上就一直空着。"},{"op":"text","speaker":"","text":"…我双手合十。"},{"op":"text","speaker":"","text":"在为他祈福之后，我从他的位子上跨了过去，径直走出教室。"},{"op":"background","image":"kuro"},{"op":"bodies","images":[]},{"op":"background","image":"bg024"},{"op":"bodies","images":[]},{"op":"set","target":["v","z",320],"value":1},{"op":"text","speaker":"","text":"我们坐在一起吃着午饭。"},{"op":"text","speaker":"","text":"春原那家伙这几天应该是不会冒出来了。我可以好好享受和古河在一起的时间了。"},{"op":"bodies","images":["cgng30"]},{"op":"text","speaker":"古河","text":"「春原同学，没来呢。」"},{"op":"text","speaker":"朋也","text":"「哦…不用管他。他马上就会振作起来的。」"},{"op":"text","speaker":"古河","text":"「是不是出什么事情了。我有点担心。」"},{"op":"text","speaker":"朋也","text":"「没事。这是常有的事情。」"},{"op":"text","speaker":"","text":"橄榄球部对他的惩罚。"},{"op":"text","speaker":"古河","text":"「原来是这样呀。」"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"古河似乎放下心来叹了口气，继续吃着吃了一半的面包。"},{"op":"text","speaker":"","text":"我则整个人躺倒在了草坪上。"},{"op":"text","speaker":"","text":"古河吃完面包也没有站起来，就这样一直坐在我的身边。"},{"op":"text","speaker":"","text":"仅仅是两人膝盖的接触，也是那样的温暖。"},{"op":"text","speaker":"古河","text":"「哼…哼…」"},{"op":"text","speaker":"","text":"古河开始小声地哼起了歌。"},{"op":"text","speaker":"","text":"听着她的歌声…我渐渐睡了过去。"},{"op":"ifFalse","to":260,"condition":["==",["v","f",128],1]},{"op":"background","image":"kuro"},{"op":"bodies","images":[]},{"op":"background","image":"bg018"},{"op":"bodies","images":[]},{"op":"set","target":["v","z",313],"value":1},{"op":"text","speaker":"","text":"放学时，我也和古河在一起。"},{"op":"text","speaker":"","text":"我们并排走着…发现几个男生正躲在走廊的角落窥视着这边。"},{"op":"text","speaker":"","text":"我回头看了看。"},{"op":"text","speaker":"","text":"…什么都没有。"},{"op":"choice","id":"6444:18108800","target":["v","f",1089],"items":[{"text":"去问个清楚","value":0,"serial":18108800},{"text":"没兴趣","value":1,"serial":18108810}]},{"op":"ifFalse","to":252,"condition":["==",["v","f",1089],0]},{"op":"bodies","images":["cgng30"]},{"op":"text","speaker":"名前＿渚","text":"「有什么事情吗？」"},{"op":"text","speaker":"朋也","text":"「不知道…」"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"正好里面有认识的人在，我便打算过去问个清楚。"},{"op":"text","speaker":"朋也","text":"「怎么了？」"},{"op":"text","speaker":"男学生","text":"「嗯，冈崎啊…」"},{"op":"text","speaker":"男学生","text":"「刚才在走廊里出现了…」"},{"op":"text","speaker":"朋也","text":"「出现什么了。」"},{"op":"text","speaker":"男学生","text":"「你不知道吗。游荡在这个教学楼的幽灵啊。」"},{"op":"text","speaker":"朋也","text":"「传闻倒是听说过…真的会出现吗？」"},{"op":"text","speaker":"男学生","text":"「是啊。而且会主动找上你。」"},{"op":"text","speaker":"男学生","text":"「然后会对你说，请收下这个。然后把被诅咒的道具送你…」"},{"op":"text","speaker":"朋也","text":"「………」"},{"op":"text","speaker":"朋也","text":"「我说啊…」"},{"op":"text","speaker":"男学生","text":"「什么。」"},{"op":"text","speaker":"朋也","text":"「那个幽灵…手上是不是缠着绷带？」"},{"op":"text","speaker":"男学生","text":"「你知道的挺多啊。」"},{"op":"text","speaker":"男学生","text":"「是啊，关于这个也有个恐怖的传闻。据说是遭遇事故的时候，手被夹在了车子和护栏中间…」"},{"op":"text","speaker":"男学生","text":"「那个幽灵…手上还不住的往外冒血呢。」"},{"op":"set","target":["v","z",314],"value":1},{"op":"text","speaker":"朋也","text":"「那只是她笨手笨脚自己弄的！」"},{"op":"text","speaker":"朋也","text":"「喂，《＄呼称＿朋也→渚》，走了。」"},{"op":"text","speaker":"","text":"我拉住《＄呼称＿朋也→渚》的手，奔跑了起来。"},{"op":"bodies","images":["cgng13"]},{"op":"set","target":["v","s",0],"value":["call","global.namae",["％Ｅ"]]},{"op":"set","target":["v","s",1],"value":["+","岡","崎さん"]},{"op":"ifFalse","to":240,"condition":["==",["v","s",0],["v","s",1]]},{"op":"text","speaker":"名前＿渚","text":"「怎么了，《＄呼称＿渚→朋也》。」"},{"op":"text","speaker":"朋也","text":"「你想不想见见幽灵？」"},{"op":"bodies","images":["cgng16"]},{"op":"text","speaker":"名前＿渚","text":"「吓人吗？」"},{"op":"text","speaker":"朋也","text":"「不一点都不吓人。」"},{"op":"bodies","images":["cgng10z"]},{"op":"text","speaker":"名前＿渚","text":"「那我想见见。」"},{"op":"text","speaker":"朋也","text":"「好，那我现在就带你去。」"},{"op":"background","image":"kuro"},{"op":"bodies","images":[]},{"op":"jumpScene","scene":1426,"entry":0},{"op":"goto","to":260},{"op":"ifFalse","to":260,"condition":["==",["v","f",1089],1]},{"op":"text","speaker":"","text":"反正又是什么无聊的事吧。"},{"op":"text","speaker":"","text":"装作没看见，从他们的身边走过，下了楼梯。"},{"op":"background","image":"bg015"},{"op":"bodies","images":[]},{"op":"bodies","images":["cgng30"]},{"op":"text","speaker":"古河","text":"「是怎么回事啊？」"},{"op":"text","speaker":"朋也","text":"「天知道。」"},{"op":"goto","to":275},{"op":"ifFalse","to":275,"condition":["==",["v","f",19],0]},{"op":"set","target":["v","f",1112],"value":0},{"op":"background","image":"bg080"},{"op":"bodies","images":[]},{"op":"set","target":["v","z",320],"value":1},{"op":"text","speaker":"","text":"和渚一起上学…"},{"op":"text","speaker":"","text":"和渚一起午休…"},{"op":"text","speaker":"","text":"和渚一起放学。"},{"op":"text","speaker":"","text":"我一直过着这样的日子。"},{"op":"text","speaker":"","text":"有时候会觉得她有些讨厌…"},{"op":"text","speaker":"","text":"有时候会觉得她有些可爱…"},{"op":"text","speaker":"","text":"这样的校园生活。"},{"op":"background","image":"bg024"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"十分平静。"},{"op":"text","speaker":"","text":"我做梦也没想过，我会在学校渡过这样的时光…"},{"op":"text","speaker":"","text":"我自己都会觉得，真是有些滑稽。"},{"op":"set","target":["v","f",1112],"value":0},{"op":"background","image":"bg020"},{"op":"bodies","images":[]},{"op":"set","target":["v","z",315],"value":1},{"op":"ifFalse","to":285,"condition":["==",["v","f",19],1]},{"op":"text","speaker":"","text":"到了５月，新的学生会班底就要成立了。"},{"op":"goto","to":287},{"op":"ifFalse","to":287,"condition":["==",["v","f",19],0]},{"op":"text","speaker":"","text":"这个周末，新的学生会班底就要成立了。"},{"op":"ifFalse","to":292,"condition":["==",["v","f",201],0]},{"op":"text","speaker":"","text":"我和《＄呼称＿朋也→渚》去过几次学生会活动室，和他们直接交涉。"},{"op":"text","speaker":"","text":"交涉的事情，当然是重建演剧部。"},{"op":"text","speaker":"","text":"但依旧被告知需要一个顾问，所以事情还是没有一点进展。"},{"op":"goto","to":315},{"op":"ifFalse","to":315,"condition":["==",["v","f",201],1]},{"op":"ifFalse","to":301,"condition":["==",["v","f",208],0]},{"op":"text","speaker":"","text":"学生会长是坂上智代。"},{"op":"text","speaker":"","text":"就是和不良学生搏斗的那个女学生。"},{"op":"text","speaker":"","text":"我和《＄呼称＿朋也→渚》也去过几次学生会会室，和她直接交涉过。"},{"op":"text","speaker":"","text":"交涉的事情，当然是重建演剧部。"},{"op":"text","speaker":"","text":"这个叫智代的女学生，比想象的要通情达理。"},{"op":"text","speaker":"","text":"只是，我们依旧被告知需要一个顾问，所以事情还是没有一点头绪。"},{"op":"goto","to":315},{"op":"ifFalse","to":315,"condition":["==",["v","f",208],1]},{"op":"text","speaker":"","text":"学生会长是智代。"},{"op":"text","speaker":"","text":"我们以为这样事情就容易解决了。于是我和《＄呼称＿朋也→渚》去到了学生会，和她交涉。"},{"op":"background","image":"bg023"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"交涉的事情，当然是重建演剧部。"},{"op":"text","speaker":"","text":"只是，我们依旧被告知需要一个顾问，所以事情还是没有一点头绪。"},{"op":"bodies","images":["cgtm22"]},{"op":"text","speaker":"智代","text":"「我也帮你们查一查吧。」"},{"op":"text","speaker":"智代","text":"「如果有线索，我保证马上联系你们。」"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"智代尽力鼓励着《＄呼称＿朋也→渚》，之后就回到了自己的工作上。"},{"op":"background","image":"bg020"},{"op":"bodies","images":[]},{"op":"bodies","images":["cgng32"]},{"op":"text","speaker":"名前＿渚","text":"「真的是没有办法了吗…」"},{"op":"text","speaker":"朋也","text":"「嗯，你先不要放弃。」"},{"op":"text","speaker":"朋也","text":"「也许会有别的社团解散，然后空出顾问来的。」"},{"op":"text","speaker":"名前＿渚","text":"「这种事…应该是很少会有的吧…」"},{"op":"text","speaker":"朋也","text":"「别的呢。还有别的可能啊，比如发生了什么特别的事情，让我们有了重建的机会。」"},{"op":"text","speaker":"朋也","text":"「所以说，不要气馁啊。」"},{"op":"ifFalse","to":325,"condition":["==",["v","f",208],0]},{"op":"text","speaker":"","text":"我不断鼓励着《＄呼称＿朋也→渚》。"},{"op":"goto","to":327},{"op":"ifFalse","to":327,"condition":["==",["v","f",208],1]},{"op":"text","speaker":"","text":"我鼓励着《＄呼称＿朋也→渚》。"},{"op":"bodies","images":["cgng33"]},{"op":"text","speaker":"名前＿渚","text":"「嗯ー…」"},{"op":"text","speaker":"","text":"她撅着小嘴想了一会。"},{"op":"bodies","images":["cgng17"]},{"op":"text","speaker":"名前＿渚","text":"「好的…我明白了。」"},{"op":"text","speaker":"","text":"最终，《＄呼称＿朋也→渚》总会开朗积极地回应。"},{"op":"text","speaker":"","text":"我们一起度过了学校的创立者祭，一个相当于校庆的节日。"},{"op":"text","speaker":"","text":"然后…"},{"op":"text","speaker":"","text":"这一天，是《＄呼称＿朋也→渚》和我在学校度过的最后一天。"},{"op":"background","image":"bg006n1"},{"op":"bodies","images":[]},{"op":"text","speaker":"朋也","text":"「她怎么样了，早苗阿姨。」"},{"op":"bodies","images":["cgsn10"]},{"op":"text","speaker":"早苗","text":"「没事的。你先冷静。」"},{"op":"text","speaker":"朋也","text":"「对不起…是我太勉强她了。」"},{"op":"text","speaker":"朋也","text":"「是我…总是兴冲冲带着她乱跑…」"},{"op":"ifFalse","to":350,"condition":["==",["v","f",136],0]},{"op":"bodies","images":["cgsn11"]},{"op":"text","speaker":"早苗","text":"「请不要这样说。那孩子也一定是愿意和冈崎同学一起这样做的。」"},{"op":"text","speaker":"朋也","text":"「那么，我就更加…更加应该注意她了。」"},{"op":"text","speaker":"早苗","text":"「请不要这么自责。」"},{"op":"text","speaker":"朋也","text":"「………」"},{"op":"goto","to":357},{"op":"ifFalse","to":357,"condition":["==",["v","f",136],1]},{"op":"text","speaker":"早苗","text":"「请不要这么说。她不是你的女朋友吗。」"},{"op":"text","speaker":"朋也","text":"「啊…都知道了啊。」"},{"op":"bodies","images":["cgsn11"]},{"op":"text","speaker":"早苗","text":"「当然啦。毕竟是自己的女儿嘛。」"},{"op":"text","speaker":"朋也","text":"「我这个男朋友做的太不到位了。」"},{"op":"text","speaker":"早苗","text":"「哪有的事。」"},{"op":"bodies","images":["cgsn10"]},{"op":"text","speaker":"早苗","text":"「冈崎同学。」"},{"op":"text","speaker":"朋也","text":"「嗯。」"},{"op":"text","speaker":"早苗","text":"「我能叫你朋也吗。」"},{"op":"text","speaker":"朋也","text":"「嗯，可以的。」"},{"op":"text","speaker":"早苗","text":"「那么，朋也。」"},{"op":"text","speaker":"朋也","text":"「嗯。」"},{"op":"text","speaker":"早苗","text":"「你也看到了，渚是个体弱多病的孩子…以后也要麻烦你多多照顾她。千万拜托了。」"},{"op":"text","speaker":"朋也","text":"「不，我才是要你们多多照顾。我要努力不被她讨厌才行…」"},{"op":"bodies","images":["cgsn11"]},{"op":"text","speaker":"早苗","text":"「放心吧。我们会尽力帮你的。」"},{"op":"text","speaker":"朋也","text":"「那可真是太可靠了。」"},{"op":"bodies","images":["cgsn10"]},{"op":"text","speaker":"早苗","text":"「朋也你也累了吧。渚就交给我，你今天先回去吧。」"},{"op":"text","speaker":"朋也","text":"「真是对不起，我在外面玩了一天…」"},{"op":"text","speaker":"早苗","text":"「没这种事。」"},{"op":"text","speaker":"朋也","text":"「那么，我就先告辞了。」"},{"op":"bodies","images":["cgsn11"]},{"op":"text","speaker":"早苗","text":"「嗯。」"},{"op":"text","speaker":"","text":"《＄呼称＿朋也→渚》她…"},{"op":"text","speaker":"","text":"从创立者祭的第二天开始，就因为发烧卧床在家。"},{"op":"background","image":"bg003"},{"op":"bodies","images":[]},{"op":"text","speaker":"朋也","text":"「《＄呼称＿朋也→渚》…」"},{"op":"text","speaker":"","text":"我走进了充满着《＄呼称＿朋也→渚》温度的房间。"},{"op":"bodies","images":["cgng34e"]},{"op":"set","target":["v","s",0],"value":["call","global.namae",["％Ｅ"]]},{"op":"set","target":["v","s",1],"value":["+","岡","崎さん"]},{"op":"ifFalse","to":386,"condition":["==",["v","s",0],["v","s",1]]},{"op":"text","speaker":"名前＿渚","text":"「《＄呼称＿渚→朋也》…」"},{"op":"text","speaker":"","text":"卧病在床的《＄呼称＿朋也→渚》朝我转过了脸。"},{"op":"text","speaker":"名前＿渚","text":"「…是我坚持不下去了呢。」"},{"op":"text","speaker":"朋也","text":"「嗯？什么事。」"},{"op":"text","speaker":"名前＿渚","text":"「一起边聊天边去上学。」"},{"op":"text","speaker":"朋也","text":"「这也是没办法的吧。又不是你的错。」"},{"op":"text","speaker":"名前＿渚","text":"「就是我的错…都怪我身体虚弱…」"},{"op":"text","speaker":"朋也","text":"「我说了不是你的错吧？」"},{"op":"text","speaker":"名前＿渚","text":"「………」"},{"op":"text","speaker":"名前＿渚","text":"「嗯…对不起。」"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"《＄呼称＿朋也→渚》因为生病变得软弱起来。"},{"op":"text","speaker":"","text":"明明从我们在坡道下相遇那天开始…"},{"op":"text","speaker":"","text":"一直，都在努力着。"},{"op":"text","speaker":"","text":"虽然没能重建演剧部。"},{"op":"text","speaker":"","text":"还是说我们两个，在不知不觉中…"},{"op":"text","speaker":"","text":"在只要我们能在一起的软弱中逃避着。"},{"op":"text","speaker":"","text":"我不想这么认为。"},{"op":"text","speaker":"","text":"果然我们，还在向着未来努力。"},{"op":"text","speaker":"","text":"这一点，今后也不会改变。"},{"op":"text","speaker":"","text":"………。"},{"op":"text","speaker":"","text":"在不不知觉中，《＄呼称＿朋也→渚》闭上了眼睛，睡着了。"},{"op":"text","speaker":"朋也","text":"（真是毫无防备的家伙…）"},{"op":"text","speaker":"","text":"我轻轻抚摸了一下她的脸颊，试着感受她的温度。"},{"op":"text","speaker":"","text":"今后也一定，会有更多的困难在等着我们。"},{"op":"text","speaker":"","text":"不管是她，还是我。"},{"op":"text","speaker":"","text":"我有着如此的预感。"},{"op":"text","speaker":"","text":"因此，现在稍微休息一下也没关系。"},{"op":"text","speaker":"","text":"我拿开了手，站起身。"},{"op":"text","speaker":"","text":"在不吵醒她的情况下，离开了房间。"},{"op":"ifFalse","to":418,"condition":["==",["v","f",29],1]},{"op":"jumpScene","scene":7300,"entry":0},{"op":"background","image":"kuro"},{"op":"bodies","images":[]},{"op":"set","target":["v","g",1004],"value":0},{"op":"set","target":["v","g",1005],"value":0},{"op":"set","target":["v","g",1006],"value":0},{"op":"end"},{"op":"return"}]