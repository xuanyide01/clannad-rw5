[{"op":"set","target":["v","f",1108],"value":0},{"op":"set","target":["v","f",1109],"value":5},{"op":"set","target":["v","f",1110],"value":11},{"op":"set","target":["v","f",1111],"value":0},{"op":"set","target":["v","f",1112],"value":1},{"op":"background","image":"bg080"},{"op":"bodies","images":[]},{"op":"set","target":["v","z",322],"value":1},{"op":"text","speaker":"声","text":"「……朋也…」"},{"op":"text","speaker":"朋也","text":"「………」"},{"op":"text","speaker":"声","text":"「……朋也…君…」"},{"op":"text","speaker":"朋也","text":"「………」"},{"op":"text","speaker":"声","text":"「…朋也君…」"},{"op":"text","speaker":"朋也","text":"「………」"},{"op":"text","speaker":"声","text":"「朋也君！」"},{"op":"background","image":"bg024"},{"op":"bodies","images":[]},{"op":"text","speaker":"朋也","text":"「…唉？」"},{"op":"bodies","images":["cgry15"]},{"op":"text","speaker":"椋","text":"「你怎么了？」"},{"op":"text","speaker":"朋也","text":"「啊…不好意思…藤…」"},{"op":"bodies","images":["cgry13"]},{"op":"text","speaker":"椋","text":"「………」"},{"op":"text","speaker":"朋也","text":"「啊…不对…椋…」"},{"op":"bodies","images":["cgry12"]},{"op":"text","speaker":"椋","text":"「嗯。」"},{"op":"bodies","images":["cgry11"]},{"op":"text","speaker":"椋","text":"「我买冰激凌来了。」"},{"op":"text","speaker":"朋也","text":"「谢谢。」"},{"op":"text","speaker":"","text":"我接过藤林…椋递过来的冰激凌。"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"我身处中庭。"},{"op":"text","speaker":"","text":"蓝天白云。"},{"op":"text","speaker":"","text":"风吹树叶沙沙作响。"},{"op":"text","speaker":"","text":"没什么人来…。"},{"op":"text","speaker":"","text":"椋就靠在我身边的石墙上。"},{"op":"text","speaker":"","text":"时不时地看我几眼…。"},{"op":"bodies","images":["cgry11"]},{"op":"text","speaker":"椋","text":"「朋也君。」"},{"op":"text","speaker":"朋也","text":"「嗯？」"},{"op":"bodies","images":["cgry21"]},{"op":"text","speaker":"椋","text":"「我只是想叫叫看。」"},{"op":"text","speaker":"","text":"她腼腆羞涩地说到。"},{"op":"text","speaker":"","text":"弄得我也怪难为情的…。"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"从教学楼方向传来喧闹声。"},{"op":"text","speaker":"","text":"没错，今天是创立者祭。"},{"op":"text","speaker":"","text":"在这个日子里，连３年级学生都能暂时忘掉升学考好好放松。"},{"op":"text","speaker":"朋也","text":"「对了，藤──…」"},{"op":"bodies","images":["cgry13"]},{"op":"text","speaker":"椋","text":"「………」"},{"op":"text","speaker":"朋也","text":"「…哦…椋。」"},{"op":"bodies","images":["cgry12"]},{"op":"text","speaker":"椋","text":"「嗯。」"},{"op":"text","speaker":"朋也","text":"「你有想去的教室吗？」"},{"op":"text","speaker":"朋也","text":"「１，２年级生们办了各种活动呢？」"},{"op":"bodies","images":["cgry11"]},{"op":"text","speaker":"椋","text":"「不了，我更喜欢像这样两个人独处。」"},{"op":"text","speaker":"朋也","text":"「是…是嘛…」"},{"op":"text","speaker":"","text":"好难为情…。"},{"op":"text","speaker":"","text":"今天椋格外大胆呀…。"},{"op":"background","image":"kuro"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"而且是从早上班会课结束后就开始了──…。"},{"op":"background","image":"bg021a"},{"op":"bodies","images":[]},{"op":"set","target":["v","z",314],"value":1},{"op":"text","speaker":"班主任","text":"「…以上就是注意事项。」"},{"op":"text","speaker":"班主任","text":"「３点记得回教室。」"},{"op":"text","speaker":"班主任","text":"「在此之前可以自由活动，今天你们就先把考试放一边好好去玩吧。」"},{"op":"background","image":"bg021b"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"班主任大致交代了这些后就出了教室。"},{"op":"text","speaker":"","text":"与此同时，教室里瞬间沸腾起来。"},{"op":"text","speaker":"","text":"今年是我们最后一次作为学生参加创立者祭了。"},{"op":"text","speaker":"","text":"还有一点就是…这次我们是完全以宾客的身份来参加，定然是万分期待了。"},{"op":"bodies","images":["cgsh10"]},{"op":"text","speaker":"春原","text":"「冈崎，你打算做什么？」"},{"op":"text","speaker":"朋也","text":"「什么做什么？」"},{"op":"text","speaker":"春原","text":"「我是打算直接回宿舍睡觉的。」"},{"op":"text","speaker":"朋也","text":"「哦…对哦，还有这一手哦。」"},{"op":"bodies","images":["cgry11"]},{"op":"text","speaker":"椋","text":"「朋也君。」"},{"op":"text","speaker":"朋也","text":"「嗯？」"},{"op":"text","speaker":"春原","text":"「喔？」"},{"op":"bodies","images":["cgry21"]},{"op":"text","speaker":"椋","text":"「那个…今天…要不要一起在学校里逛逛…？」"},{"op":"text","speaker":"朋也","text":"「………」"},{"op":"text","speaker":"春原","text":"「………」"},{"op":"bodies","images":["cgry19"]},{"op":"text","speaker":"椋","text":"「怎…怎么了？」"},{"op":"text","speaker":"朋也","text":"「不…只是你刚才叫我的时候有些不适应…」"},{"op":"text","speaker":"春原","text":"「嗯嗯。」"},{"op":"bodies","images":["cgry20"]},{"op":"text","speaker":"椋","text":"「呃…那…那个嘛…」"},{"op":"text","speaker":"","text":"她红着脸…目光在地板墙壁以及我之间忙碌地游走…。"},{"op":"bodies","images":["cgry22a"]},{"op":"text","speaker":"椋","text":"「朋也…君…」"},{"op":"text","speaker":"朋也","text":"「………」"},{"op":"text","speaker":"春原","text":"「………」"},{"op":"text","speaker":"","text":"与春原面面相觑。"},{"op":"text","speaker":"","text":"看来刚才没听错。"},{"op":"text","speaker":"","text":"不过至少昨天她还是用姓来称呼我的吧…。"},{"op":"text","speaker":"朋也","text":"「…怎么突然间就变了…？」"},{"op":"bodies","images":["cgry14a"]},{"op":"text","speaker":"椋","text":"「啊…唔…不可以吗…？」"},{"op":"text","speaker":"朋也","text":"「不，我倒是没意见只是来得有些突然罢了。」"},{"op":"bodies","images":["cgry19a"]},{"op":"text","speaker":"椋","text":"「对…对不起…怪我自作主张改变称呼…」"},{"op":"bodies","images":["cgry22a"]},{"op":"text","speaker":"椋","text":"「可是…这个…我隐约觉得这样比较…」"},{"op":"text","speaker":"椋","text":"「比…比较有恋人的感觉…」"},{"op":"text","speaker":"","text":"这句话让整个教室都为之一惊。"},{"op":"text","speaker":"","text":"全班齐刷刷地看向我们。"},{"op":"text","speaker":"","text":"不一会就听见各处悄声议论。"},{"op":"bodies","images":[]},{"op":"text","speaker":"男学生","text":"「…喂…那俩人真是在交往啊…？」"},{"op":"text","speaker":"男学生","text":"「…昨天那个原来不是开玩笑的啊…」"},{"op":"text","speaker":"男学生","text":"「…话说他真的脚踏两条船…？」"},{"op":"text","speaker":"男学生","text":"「…我倒是觉得班长才是正选吧…？」"},{"op":"text","speaker":"男学生","text":"「…我还打算追班长来着…」"},{"op":"text","speaker":"","text":"他们肆无忌惮地议论着…。"},{"op":"bodies","images":["cgry14a"]},{"op":"text","speaker":"椋","text":"「你…反感这样吗？」"},{"op":"text","speaker":"","text":"她那仿佛是在窥探我反应的目光。"},{"op":"text","speaker":"","text":"看见她这样的眼神我还能说什么。"},{"op":"text","speaker":"朋也","text":"「你喜欢这么叫…就这么叫吧。」"},{"op":"bodies","images":["cgry21"]},{"op":"text","speaker":"椋","text":"「真的吗？谢谢！」"},{"op":"text","speaker":"","text":"她转忧为喜立马笑容满面。"},{"op":"text","speaker":"","text":"虽然脸颊依旧通红，但那表情却是喜上眉梢。"},{"op":"bodies","images":["cgry19"]},{"op":"text","speaker":"椋","text":"「对了，朋也君。」"},{"op":"text","speaker":"朋也","text":"「怎…怎么了？」"},{"op":"bodies","images":["cgry11"]},{"op":"text","speaker":"椋","text":"「你以后可以直接叫我椋哦。」"},{"op":"text","speaker":"朋也","text":"「…椋…？」"},{"op":"bodies","images":["cgry12"]},{"op":"text","speaker":"椋","text":"「是的，这样才更像情侣嘛。」"},{"op":"text","speaker":"朋也","text":"「………」"},{"op":"text","speaker":"","text":"这情况该怎么比喻呢。"},{"op":"text","speaker":"","text":"就像是粉色气氛强行笼盖四周一般…。"},{"op":"text","speaker":"","text":"藤林椋是个这么大胆的人吗…。"},{"op":"bodies","images":["cgsh24"]},{"op":"text","speaker":"春原","text":"「呃…那我回宿舍了。」"},{"op":"text","speaker":"春原","text":"「不当你们的电灯泡了。」"},{"op":"text","speaker":"朋也","text":"「啊…喂！」"},{"op":"bodies","images":["cgry11"]},{"op":"text","speaker":"椋","text":"「我们走吧，朋也君。」"},{"op":"text","speaker":"朋也","text":"「唉？等等…藤──」"},{"op":"bodies","images":["cgry12"]},{"op":"text","speaker":"椋","text":"「要叫我『椋』。」"},{"op":"text","speaker":"朋也","text":"「………」"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"她抓着我的手臂，连拖带拽地走向教室大门。"},{"op":"text","speaker":"","text":"曾几何时发生过这等有趣的画面呢…。"},{"op":"text","speaker":"","text":"我们所认识的那位藤林竟然会在占卜以外的事上采取主动…。"},{"op":"background","image":"bg018"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"来到走廊关上教室门后。"},{"op":"text","speaker":"","text":"听见教室里突然炸开了锅。"},{"op":"text","speaker":"男学生","text":"『喂…喂！那个冈崎居然被拖着走了…？』"},{"op":"text","speaker":"男学生","text":"『莫非他是妻管严…？』"},{"op":"text","speaker":"男学生","text":"『其实那个班长是她双胞胎姐姐假扮的？』"},{"op":"text","speaker":"男学生","text":"『说不定只是演得比较烂的戏码？』"},{"op":"background","image":"kuro"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"………。"},{"op":"text","speaker":"","text":"……。"},{"op":"text","speaker":"","text":"…。"},{"op":"text","speaker":"","text":"然后──…。"},{"op":"background","image":"bg024"},{"op":"bodies","images":[]},{"op":"set","target":["v","z",322],"value":1},{"op":"text","speaker":"","text":"就成了现在这个样子…。"},{"op":"bodies","images":["cgry16"]},{"op":"text","speaker":"椋","text":"「…？怎么了？」"},{"op":"text","speaker":"朋也","text":"「啊不…没什么…」"},{"op":"bodies","images":["cgry15"]},{"op":"text","speaker":"椋","text":"「啊…难道你不喜欢香草味的冰激凌吗？」"},{"op":"text","speaker":"朋也","text":"「唉？那倒不是…」"},{"op":"bodies","images":["cgry12"]},{"op":"text","speaker":"椋","text":"「请吧。」"},{"op":"text","speaker":"","text":"椋说着就把自己有些化掉的冰激凌朝我递了过来。"},{"op":"bodies","images":["cgry11"]},{"op":"text","speaker":"椋","text":"「你可以尝尝看哦。」"},{"op":"text","speaker":"朋也","text":"「哦…谢谢。」"},{"op":"text","speaker":"","text":"我照她说的，在冰激凌边角上咬了一口。"},{"op":"text","speaker":"","text":"又甜又凉的巧克力味在口中散开。"},{"op":"bodies","images":["cgry15"]},{"op":"text","speaker":"椋","text":"「好吃吗？」"},{"op":"text","speaker":"","text":"我点了点头。"},{"op":"bodies","images":["cgry12"]},{"op":"text","speaker":"椋","text":"「啊…我也想尝尝香草味的。」"},{"op":"text","speaker":"朋也","text":"「嗯？哦哦。」"},{"op":"text","speaker":"","text":"于是我将手里的香草冰激凌递向椋。"},{"op":"bodies","images":["cgry22"]},{"op":"text","speaker":"","text":"椋目不转睛地看着眼前的冰激凌，一瞬间看了看我的眼。"},{"op":"text","speaker":"","text":"然后轻轻地用舌头舔了一口冰激凌。"},{"op":"bodies","images":["cgry21"]},{"op":"text","speaker":"椋","text":"「甜甜的真好吃。」"},{"op":"text","speaker":"","text":"她笑容可掬地说到。"},{"op":"text","speaker":"","text":"好可爱…。"},{"op":"text","speaker":"","text":"我真心这么觉得。"},{"op":"bodies","images":["cgry19"]},{"op":"text","speaker":"椋","text":"「？我的脸上沾着东西吗？」"},{"op":"text","speaker":"朋也","text":"「没…没有…」"},{"op":"bodies","images":["cgry15"]},{"op":"text","speaker":"椋","text":"「啊…」"},{"op":"text","speaker":"朋也","text":"「嗯？」"},{"op":"bodies","images":["cgry21"]},{"op":"text","speaker":"椋","text":"「嘻嘻，朋也君脸上沾着哦。」"},{"op":"text","speaker":"朋也","text":"「我脸上？」"},{"op":"bodies","images":["cgry19"]},{"op":"text","speaker":"椋","text":"「啊…别动哦。」"},{"op":"bodies","images":["cgry18"]},{"op":"text","speaker":"","text":"说完，椋便表情认真地向我伸出手。"},{"op":"text","speaker":"","text":"指尖慢慢地靠近我的嘴边…。"},{"op":"text","speaker":"","text":"感觉到被她指尖轻轻地擦拭…。"},{"op":"bodies","images":["cgry11"]},{"op":"text","speaker":"椋","text":"「擦掉了。」"},{"op":"text","speaker":"","text":"她笑着向我展示她指尖上沾着的冰激凌。"},{"op":"text","speaker":"","text":"然后直接将手指含入口中。"},{"op":"text","speaker":"朋也","text":"「呃…」"},{"op":"bodies","images":["cgry16"]},{"op":"text","speaker":"椋","text":"「？」"},{"op":"text","speaker":"","text":"我不经意间发出的声音使得椋一脸茫然。"},{"op":"text","speaker":"","text":"只见她含着手指露出不解的神情。"},{"op":"bodies","images":["cgry15"]},{"op":"text","speaker":"椋","text":"「怎么了吗…？」"},{"op":"text","speaker":"朋也","text":"「呃…那个…」"},{"op":"text","speaker":"","text":"怎么办…她直接把沾在我嘴角的冰激凌送进她口中了…。"},{"op":"text","speaker":"","text":"那…不就几乎是间接接吻了…。"},{"op":"text","speaker":"","text":"之前吃便当咬了下筷子的时候，她还泪流满面地跑了出去…。"},{"op":"text","speaker":"","text":"不对…我们已经接过吻了，所以区区间接接吻已经不会动摇到她了吗…？"},{"op":"text","speaker":"","text":"她见我直勾勾地盯着她的嘴角看，似乎是察觉到我的想法了吧。"},{"op":"bodies","images":["cgry20"]},{"op":"text","speaker":"","text":"只见她眼中灵光一闪。"},{"op":"bodies","images":["cgry21a"]},{"op":"text","speaker":"","text":"不过并没有表露出慌张的神色…反而是面露微笑地看着我。"},{"op":"text","speaker":"椋","text":"「我们怎么看都是情侣吧。」"},{"op":"text","speaker":"朋也","text":"「对…对啊。」"},{"op":"text","speaker":"","text":"感觉节奏被打乱了…。"},{"op":"text","speaker":"","text":"我认识的椋应该不是会说这种话的女生呀…。"},{"op":"text","speaker":"","text":"要说变化也变化得太大了吧…。"},{"op":"bodies","images":["cgry19"]},{"op":"text","speaker":"椋","text":"「………」"},{"op":"text","speaker":"朋也","text":"「…嗯？」"},{"op":"text","speaker":"","text":"回过神来才发现椋正盯着我看。"},{"op":"text","speaker":"朋也","text":"「我脸上还有什么东西吗？」"},{"op":"text","speaker":"","text":"我一边用手背擦着嘴一边问道。"},{"op":"bodies","images":["cgry22"]},{"op":"set","target":["v","z",320],"value":1},{"op":"text","speaker":"椋","text":"「啊…不…不是的…」"},{"op":"text","speaker":"朋也","text":"「…？」"},{"op":"bodies","images":["cgry22a"]},{"op":"text","speaker":"椋","text":"「唔…」"},{"op":"text","speaker":"","text":"椋目光闪烁地观察着我…。"},{"op":"bodies","images":["cgry21a"]},{"op":"text","speaker":"椋","text":"「我只是想…如果现在接吻的话…味道应该会甜甜的吧…」"},{"op":"text","speaker":"","text":"她面红耳赤地说到。"},{"op":"bodies","images":["cgry22a"]},{"op":"text","speaker":"","text":"然后她左顾右盼地看了看四周。"},{"op":"text","speaker":"","text":"…喂…这时候确认周遭环境…莫非？"},{"op":"bodies","images":["cgry19"]},{"op":"text","speaker":"椋","text":"「…朋也君…」"},{"op":"text","speaker":"","text":"她微微抬起下巴整个人靠了过来。"},{"op":"text","speaker":"朋也","text":"「要…要在这儿吗…？」"},{"op":"bodies","images":["cgry21"]},{"op":"text","speaker":"椋","text":"「其…其他人都在教学楼那边…一门心思地在玩呢…」"},{"op":"text","speaker":"朋也","text":"「但是说不定会被人看见吧？」"},{"op":"background","image":"fgky03a"},{"op":"bodies","images":[]},{"op":"text","speaker":"椋","text":"「绝对没问题的。」"},{"op":"text","speaker":"","text":"她越靠越近。"},{"op":"text","speaker":"","text":"我的目光被她的香唇所吸引…。"},{"op":"text","speaker":"","text":"完了…逃不掉了…。"},{"op":"text","speaker":"","text":"虽然心想这样不行…然而却不知为何又有一丝期待…一丝所求…。"},{"op":"text","speaker":"椋","text":"「朋也君…」"},{"op":"background","image":"fgky03b"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"她闭上双眼。"},{"op":"text","speaker":"","text":"不行了…根本抵抗不了…。"},{"op":"text","speaker":"","text":"不知道是出于本能反应还是欲望所驱…。"},{"op":"text","speaker":"","text":"我也闭上眼，将自己的嘴唇贴了过去。"},{"op":"background","image":"kuro"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"然后触碰到一阵柔香…。"},{"op":"text","speaker":"","text":"一开始是冷冰冰的…然后渐渐变得温暖…。"},{"op":"text","speaker":"","text":"接着…就是一阵香甜…。"},{"op":"text","speaker":"","text":"一个充满巧克力香甜的吻…。"},{"op":"text","speaker":"椋","text":"「嗯…呼…」"},{"op":"text","speaker":"","text":"我听到了她呼向我鼻尖的吐气声。"},{"op":"text","speaker":"","text":"我感觉到我心跳突然加速。"},{"op":"text","speaker":"","text":"这个炙热的吻差点让我忘了这里是何处…。"},{"op":"background","image":"fgky03b"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"我贴着她的唇，慢慢睁开眼看了一下。"},{"op":"text","speaker":"","text":"椋的脸离我近得不能再近。"},{"op":"text","speaker":"","text":"这是当然了…毕竟我们在接吻嘛…。"},{"op":"text","speaker":"","text":"自然会近得不能再近了…。"},{"op":"text","speaker":"","text":"唰…。"},{"op":"background","image":"bg024"},{"op":"bodies","images":[]},{"op":"text","speaker":"朋也","text":"「…？」"},{"op":"text","speaker":"朋也","text":"「…──！！！？」"},{"op":"text","speaker":"","text":"我略微偏移了一下视线。"},{"op":"text","speaker":"","text":"看向椋身后稍微远一点的地方。"},{"op":"text","speaker":"","text":"在我看向那边的一瞬间，所见之物令我惊得一下子瞪圆了眼睛。"},{"op":"text","speaker":"","text":"有一名身穿校服的学生正在看着我们。"},{"op":"text","speaker":"","text":"那张熟悉的脸庞上显露出了我从未见过的表情…。"},{"op":"text","speaker":"","text":"她目瞪口呆地定在原地一动不动…。"},{"op":"text","speaker":"","text":"只是给人一种伤心欲泪的感觉──…。"},{"op":"set","target":["v","z",330],"value":1},{"op":"text","speaker":"","text":"──那是杏…。"},{"op":"text","speaker":"","text":"然后她转过身立马跑掉了。"},{"op":"text","speaker":"","text":"几乎与此同时，椋的嘴唇也微微颤抖了一下。"},{"op":"text","speaker":"","text":"然后慢慢地将脸移开。"},{"op":"bodies","images":["cgry19"]},{"op":"text","speaker":"椋","text":"「啊…」"},{"op":"text","speaker":"","text":"紧接着又变得满脸通红。"},{"op":"bodies","images":["cgry22"]},{"op":"text","speaker":"椋","text":"「朋也君…接吻的时候不可以睁着眼啦。」"},{"op":"bodies","images":["cgry21"]},{"op":"text","speaker":"椋","text":"「你这样看着我的脸…挺难为情的…」"},{"op":"text","speaker":"朋也","text":"「哦…不好意思…」"},{"op":"bodies","images":["cgry19"]},{"op":"text","speaker":"椋","text":"「……？」"},{"op":"text","speaker":"朋也","text":"「………」"},{"op":"text","speaker":"椋","text":"「刚才有人在吗…？」"},{"op":"text","speaker":"朋也","text":"「唉？」"},{"op":"bodies","images":["cgry21"]},{"op":"text","speaker":"椋","text":"「我感觉你好像在顾忌周遭似的。」"},{"op":"text","speaker":"朋也","text":"「呃…没有…」"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"我尽量不让椋察觉到偷偷朝杏跑掉的方向看了一眼。"},{"op":"text","speaker":"","text":"她已经不在了。"},{"op":"text","speaker":"朋也","text":"「没…没人在哦。」"},{"op":"text","speaker":"","text":"我只能…这么说…。"},{"op":"bodies","images":["cgry11"]},{"op":"text","speaker":"椋","text":"「是嘛。」"},{"op":"text","speaker":"","text":"椋微微一笑。"},{"op":"bodies","images":["cgry12"]},{"op":"text","speaker":"椋","text":"「这个吻…真的好甜呢。」"},{"op":"text","speaker":"","text":"她仅仅是向我露出了天真…而又幸福的表情。"},{"op":"background","image":"kuro"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"结果…创立者祭我们几乎没去看节目。"},{"op":"text","speaker":"","text":"只是陪伴在对方身边。"},{"op":"text","speaker":"","text":"时而搂肩…时而依偎…时而接吻…。"},{"op":"text","speaker":"","text":"离别时的那一个吻都已经不知道是今天第几个吻了。"},{"op":"text","speaker":"","text":"唯一欣慰的是从那之后就再也没遇到过杏…。"},{"op":"text","speaker":"","text":"明天…就要和椋约会了…。"},{"op":"jumpScene","scene":3512,"entry":0},{"op":"return"}]