[{"op":"set","target":["v","f",1108],"value":0},{"op":"set","target":["v","f",1109],"value":5},{"op":"set","target":["v","f",1110],"value":8},{"op":"set","target":["v","f",1111],"value":4},{"op":"set","target":["v","f",1112],"value":0},{"op":"background","image":"bg033a"},{"op":"bodies","images":[]},{"op":"set","target":["v","z",320],"value":1},{"op":"bodies","images":["cgng10"]},{"op":"set","target":["v","s",0],"value":["call","global.namae",["％Ｅ"]]},{"op":"set","target":["v","s",1],"value":["+","岡","崎さん"]},{"op":"ifFalse","to":12,"condition":["==",["v","s",0],["v","s",1]]},{"op":"text","speaker":"渚","text":"「早上好，＄朋也君。」"},{"op":"text","speaker":"朋也","text":"「嗯，早上好。」"},{"op":"bodies","images":["cgng17"]},{"op":"set","target":["v","s",0],"value":["call","global.namae",["％Ｅ"]]},{"op":"set","target":["v","s",1],"value":["+","岡","崎さん"]},{"op":"ifFalse","to":18,"condition":["==",["v","s",0],["v","s",1]]},{"op":"text","speaker":"渚","text":"「这个，＄朋也君。」"},{"op":"text","speaker":"","text":"她轻声跟我说着，以免被风子听到。"},{"op":"bodies","images":["cgng10"]},{"op":"text","speaker":"渚","text":"「伊吹老师联系我了。」"},{"op":"text","speaker":"渚","text":"「老师会来参加创立者祭。让我们三点在校门口等她。」"},{"op":"text","speaker":"朋也","text":"「这样啊…太好了。」"},{"op":"bodies","images":["cgng23"]},{"op":"text","speaker":"渚","text":"「是啊。」"},{"op":"text","speaker":"","text":"这样一来…就万事俱备了。"},{"op":"background","image":"bg017"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"在创立者祭前的这段时间，风子也依然在努力着。"},{"op":"text","speaker":"","text":"只是每过一天，她被忽略的次数都在增加。"},{"op":"text","speaker":"","text":"毫无反应直接走远的学生背影。"},{"op":"bodies","images":["cgfu40"]},{"op":"text","speaker":"","text":"以及抱着海星呆立在原地的风子。"},{"op":"text","speaker":"渚","text":"「小风，下一次一定会顺利的。」"},{"op":"text","speaker":"","text":"要是没有＄渚，真不敢想象场面会有多尴尬。"},{"op":"text","speaker":"","text":"对于不断给风子打气的＄渚，我的内心只有感谢。"},{"op":"text","speaker":"","text":"………。"},{"op":"text","speaker":"","text":"不过，要是她能见到公子老师，对她道上一句祝福。"},{"op":"text","speaker":"","text":"或许现在的这些努力也就不再需要了。"},{"op":"text","speaker":"","text":"就是因为自己的声音不能被公子老师听见，她才会这么拼命的。"},{"op":"text","speaker":"","text":"这样一来，或许风子也会真的来到我们身边。"},{"op":"text","speaker":"","text":"或许就能从此过上快乐的校园生活。"},{"op":"text","speaker":"朋也","text":"（一定会是这样。）"},{"op":"text","speaker":"朋也","text":"（受了这么多伤，努力了那么久，到创立者祭就结束了。）"},{"op":"text","speaker":"朋也","text":"（祝一切顺利啊，风子。）"},{"op":"text","speaker":"","text":"风子又跑向了另一个学生，我冲着她的背影默念道。"},{"op":"background","image":"kuro"},{"op":"bodies","images":[]},{"op":"jumpScene","scene":1511,"entry":0},{"op":"return"}]