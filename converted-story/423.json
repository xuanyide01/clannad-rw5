[{"op":"set","target":["v","f",1108],"value":0},{"op":"set","target":["v","f",1109],"value":4},{"op":"set","target":["v","f",1110],"value":23},{"op":"set","target":["v","f",1111],"value":3},{"op":"set","target":["v","f",1112],"value":1},{"op":"ifFalse","to":8,"condition":["==",["v","f",320],2]},{"op":"callScene","scene":7600,"entry":2},{"op":"goto","to":37},{"op":"ifFalse","to":16,"condition":["==",["v","f",11],1]},{"op":"callScene","scene":6423,"entry":0},{"op":"ifFalse","to":14,"condition":["==",["v","f",815],1]},{"op":"set","target":["v","f",817],"value":1},{"op":"set","target":["v","z",313],"value":1},{"op":"goto","to":445},{"op":"set","target":["v","f",818],"value":1},{"op":"goto","to":564},{"op":"ifFalse","to":19,"condition":["==",["v","f",215],1]},{"op":"callScene","scene":2423,"entry":0},{"op":"goto","to":37},{"op":"background","image":"bg033"},{"op":"bodies","images":[]},{"op":"set","target":["v","z",303],"value":1},{"op":"text","speaker":"","text":"时间早已过了１０点。"},{"op":"text","speaker":"","text":"按照这个步子走的话，今天我的课就是从第三节开始上了。"},{"op":"background","image":"bg012"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"………。"},{"op":"ifFalse","to":37,"condition":["&&",["==",["v","f",10],0],["==",["v","f",410],0]]},{"op":"text","speaker":"","text":"我突然回想起来。"},{"op":"text","speaker":"","text":"那个和我一起攀登坡道的女生。"},{"op":"ifFalse","to":32,"condition":["==",["v","f",2],1]},{"op":"text","speaker":"","text":"我记得…她叫古河。"},{"op":"text","speaker":"","text":"之后，再也没见过她不安地伫立在这里。"},{"op":"text","speaker":"","text":"任何人踏出第一步都需要勇气。"},{"op":"text","speaker":"","text":"但只要踏出这一步，哪怕置身在忙碌仓皇的生活中…"},{"op":"text","speaker":"","text":"也能找到许多崭新的事物。"},{"op":"text","speaker":"","text":"只要不像我这样…从忙碌和仓皇中脱逃，就一定可以做到。"},{"op":"background","image":"kuro"},{"op":"bodies","images":[]},{"op":"ifFalse","to":42,"condition":["==",["v","f",128],1]},{"op":"callScene","scene":1423,"entry":0},{"op":"goto","to":46},{"op":"background","image":"bg021b"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"邻座依旧是空空如也。"},{"op":"text","speaker":"","text":"放好书包入座后，我能做的也就只剩眺望窗外了。"},{"op":"background","image":"bg021a"},{"op":"bodies","images":[]},{"op":"set","target":["v","z",312],"value":1},{"op":"text","speaker":"","text":"………。"},{"op":"ifFalse","to":55,"condition":["==",["v","f",305],1]},{"op":"callScene","scene":3423,"entry":0},{"op":"background","image":"kuro"},{"op":"bodies","images":[]},{"op":"goto","to":94},{"op":"ifFalse","to":94,"condition":["==",["v","f",305],0]},{"op":"background","image":"bg021b"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"课间休息。"},{"op":"text","speaker":"男子","text":"「幽灵？」"},{"op":"text","speaker":"","text":"我前排的两个男生还没来得及放下手上的课本就聊了起来。"},{"op":"text","speaker":"男子A","text":"「没错，听说最近一直有人目击到那个女学生的幽灵。」"},{"op":"text","speaker":"男子B","text":"「不是吧…？」"},{"op":"text","speaker":"","text":"毫无营养的话题。但就算我不想听，声音还是会传进我的耳朵。"},{"op":"text","speaker":"男子A","text":"「有人认识那个女生，说她绝对就是幽灵。」"},{"op":"text","speaker":"男子B","text":"「真的假的…」"},{"op":"text","speaker":"男子A","text":"「真的…据说那个女生…」"},{"op":"text","speaker":"男子A","text":"「两年前遭遇了车祸。」"},{"op":"text","speaker":"男子A","text":"「住院治疗了很久，但最后还是没能救回来…」"},{"op":"text","speaker":"男子A","text":"「出车祸的时候，正巧是刚开学的那段时间…」"},{"op":"text","speaker":"男子A","text":"「因为没法享受自己的高中生活，所以留下了遗恨…」"},{"op":"text","speaker":"男子A","text":"「然后就变成了幽灵，时不时回学校转转…」"},{"op":"text","speaker":"男子A","text":"「真是个有点心酸的故事。」"},{"op":"text","speaker":"男子B","text":"「不过…你不觉得有问题吗？」"},{"op":"text","speaker":"男子A","text":"「嗯？」"},{"op":"text","speaker":"男子B","text":"「传播这个故事的人也是三年级的吧？」"},{"op":"text","speaker":"男子A","text":"「是啊。」"},{"op":"text","speaker":"男子B","text":"「那就没跑了。」"},{"op":"text","speaker":"男子A","text":"「什么没跑了。」"},{"op":"text","speaker":"男子B","text":"「那人想把我们的注意力从学习上分散开啊。」"},{"op":"text","speaker":"男子A","text":"「啥…？」"},{"op":"text","speaker":"男子B","text":"「也就是说…想削弱自己的潜在对手。」"},{"op":"text","speaker":"男子A","text":"「哦ー，被你这么一说…好像还真有可能。」"},{"op":"text","speaker":"男子B","text":"「还是别太当回事的好。」"},{"op":"text","speaker":"男子A","text":"「你说的也有道理…」"},{"op":"text","speaker":"男子A","text":"「不过总感觉这个传言有鼻有眼的。」"},{"op":"text","speaker":"男子A","text":"「然后电视台的过来采访，事情说不定会闹得很大。」"},{"op":"text","speaker":"男子B","text":"「做梦吧你。」"},{"op":"text","speaker":"","text":"要是春原听到这个，会有什么反应呢。"},{"op":"text","speaker":"","text":"大概会迫不及待地拽着我去验证真伪吧。"},{"op":"text","speaker":"","text":"我瞟了眼旁边的空位。"},{"op":"text","speaker":"朋也","text":"（还好他不在…）"},{"op":"text","speaker":"","text":"世上怎么可能有幽灵呢。"},{"op":"set","target":["v","f",135],"value":1},{"op":"ifFalse","to":97,"condition":["==",["v","f",410],1]},{"op":"callScene","scene":4423,"entry":0},{"op":"goto","to":330},{"op":"background","image":"bg021a"},{"op":"bodies","images":[]},{"op":"set","target":["v","z",312],"value":1},{"op":"text","speaker":"","text":"………"},{"op":"background","image":"bg021e"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"第四节课结束，午休开始了。"},{"op":"ifFalse","to":137,"condition":["==",["v","f",213],1]},{"op":"bodies","images":["cgsh12"]},{"op":"text","speaker":"春原","text":"「今天午饭去食堂解决？」"},{"op":"text","speaker":"朋也","text":"「别说得好像你一直在这里似的，你刚刚才来的吧？」"},{"op":"text","speaker":"春原","text":"「算是啦。」"},{"op":"text","speaker":"朋也","text":"「要约饭的话，好歹也提前跟我招呼一下。不然我的计划都要打乱了。」"},{"op":"bodies","images":["cgsh15"]},{"op":"text","speaker":"春原","text":"「问题是，现在已经不是说早安的时间了啊。」"},{"op":"text","speaker":"朋也","text":"「的确不是。」"},{"op":"text","speaker":"春原","text":"「那你要我怎样啊。」"},{"op":"text","speaker":"朋也","text":"「这个嘛…」"},{"op":"choice","id":"423:45780","target":["v","f",1089],"items":[{"text":"改说午安","value":0,"serial":45780},{"text":"加点特别的反应","value":1,"serial":45790},{"text":"先来个自我介绍","value":2,"serial":45800}]},{"op":"ifFalse","to":121,"condition":["==",["v","f",1089],0]},{"op":"text","speaker":"朋也","text":"「都已经是中午了，要说也应该说午安吧。」"},{"op":"bodies","images":["cgsh12"]},{"op":"text","speaker":"春原","text":"「嗯，你说的是。明天开始就这么说吧。」"},{"op":"goto","to":135},{"op":"ifFalse","to":131,"condition":["==",["v","f",1089],1]},{"op":"text","speaker":"朋也","text":"「见到我时要加点特别的反应。这个是不能少的。」"},{"op":"bodies","images":["cgsh18"]},{"op":"text","speaker":"春原","text":"「要什么样的反应啊？」"},{"op":"text","speaker":"朋也","text":"「怎么都行，你看着办啊。」"},{"op":"text","speaker":"朋也","text":"「我举个例子…」"},{"op":"text","speaker":"朋也","text":"「咦，这不是冈崎吗？好久不见，你还好吗？我很好。诸如此类的。」"},{"op":"bodies","images":["cgsh13"]},{"op":"text","speaker":"春原","text":"「嗯，确实有好久不见的感觉。那下次开始我就这么做吧。」"},{"op":"goto","to":135},{"op":"ifFalse","to":135,"condition":["==",["v","f",1089],2]},{"op":"text","speaker":"朋也","text":"「先来个自我介绍。」"},{"op":"bodies","images":["cgsh15"]},{"op":"text","speaker":"春原","text":"「虽然不清楚这是为什么，但如果你硬要说这才合规矩的话，那下次开始我就这么做吧。」"},{"op":"set","target":["v","f",813],"value":["v","f",1089]},{"op":"goto","to":262},{"op":"ifFalse","to":194,"condition":["==",["v","f",813],0]},{"op":"bodies","images":["cgsh12"]},{"op":"text","speaker":"春原","text":"「午安。」"},{"op":"bodies","images":["cgsh25"]},{"op":"text","speaker":"春原","text":"「去吃午饭吧。」"},{"op":"text","speaker":"朋也","text":"「………」"},{"op":"bodies","images":["cgsh18"]},{"op":"text","speaker":"春原","text":"「怎么样？我按你要求招呼了。这样总行了吧？」"},{"op":"text","speaker":"朋也","text":"「有够爽朗的啊…」"},{"op":"bodies","images":["cgsh20"]},{"op":"text","speaker":"春原","text":"「嗯？」"},{"op":"text","speaker":"朋也","text":"「就你而言，未免太过爽朗了。」"},{"op":"text","speaker":"春原","text":"「咦？是吗？」"},{"op":"text","speaker":"朋也","text":"「不错。和你的形象偏差太大了。这反差让我一整哆嗦。」"},{"op":"bodies","images":["cgsh15"]},{"op":"text","speaker":"春原","text":"「那不就没意义了嘛。」"},{"op":"text","speaker":"朋也","text":"「是啊…完全没有意义。」"},{"op":"bodies","images":["cgsh18"]},{"op":"text","speaker":"春原","text":"「那下次开始你要我怎么弄啊？」"},{"op":"text","speaker":"朋也","text":"「我想想…」"},{"op":"choice","id":"423:46100","target":["v","f",1089],"items":[{"text":"含口水在嘴里说话","value":0,"serial":46100},{"text":"句尾加上『还有马桶盖子』","value":1,"serial":46110},{"text":"学腹语师说话","value":2,"serial":46120}]},{"op":"ifFalse","to":167,"condition":["==",["v","f",1089],0]},{"op":"text","speaker":"朋也","text":"「含口水在嘴里说话。」"},{"op":"bodies","images":["cgsh27"]},{"op":"text","speaker":"春原","text":"「那算什么，简直就是惩罚游戏啊。」"},{"op":"text","speaker":"朋也","text":"「那要不明天请早来？」"},{"op":"bodies","images":["cgsh21"]},{"op":"text","speaker":"春原","text":"「那是不可能的！」"},{"op":"text","speaker":"朋也","text":"「那就含口水再说话。」"},{"op":"goto","to":188},{"op":"ifFalse","to":177,"condition":["==",["v","f",1089],1]},{"op":"text","speaker":"朋也","text":"「说话时句尾加上，还有马桶盖子。」"},{"op":"bodies","images":["cgsh27"]},{"op":"text","speaker":"春原","text":"「啥？搞什么…这简直就是惩罚游戏啊。」"},{"op":"text","speaker":"春原","text":"「怎么可能说这种蠢话！」"},{"op":"text","speaker":"朋也","text":"「那要不明天请早来？」"},{"op":"bodies","images":["cgsh21"]},{"op":"text","speaker":"春原","text":"「那是不可能的！」"},{"op":"text","speaker":"朋也","text":"「那就愿赌服输吧。」"},{"op":"goto","to":188},{"op":"ifFalse","to":188,"condition":["==",["v","f",1089],2]},{"op":"text","speaker":"朋也","text":"「学腹语师说话。」"},{"op":"bodies","images":["cgsh20"]},{"op":"text","speaker":"春原","text":"「你说的腹语师，是我理解的那个腹语师吧？」"},{"op":"text","speaker":"朋也","text":"「没错，就是腹语师。」"},{"op":"bodies","images":["cgsh16"]},{"op":"text","speaker":"春原","text":"「搞什么，弄得和惩罚游戏似的。」"},{"op":"text","speaker":"朋也","text":"「那要不明天请早来？」"},{"op":"bodies","images":["cgsh21"]},{"op":"text","speaker":"春原","text":"「那是不可能的！」"},{"op":"text","speaker":"朋也","text":"「那就学腹语师说话吧。」"},{"op":"set","target":["v","f",816],"value":["v","f",1089]},{"op":"bodies","images":["cgsh16"]},{"op":"text","speaker":"春原","text":"「嘁…你赢了。我学还不成吗…」"},{"op":"text","speaker":"朋也","text":"「哦哦，我期待得很呢。」"},{"op":"goto","to":262},{"op":"goto","to":219},{"op":"ifFalse","to":208,"condition":["==",["v","f",813],1]},{"op":"bodies","images":["cgsh27"]},{"op":"text","speaker":"春原","text":"「哎呀？」"},{"op":"bodies","images":["cgsh25"]},{"op":"text","speaker":"春原","text":"「这不是冈崎吗，好久不见！」"},{"op":"bodies","images":["cgsh12"]},{"op":"text","speaker":"春原","text":"「你还好吗？我好得很。」"},{"op":"text","speaker":"","text":"我把手贴上春原的额头，看看他是不是发烧了。"},{"op":"text","speaker":"","text":"…没有。"},{"op":"text","speaker":"朋也","text":"「我告诉你，春原…其实我们昨天也见面了。」"},{"op":"bodies","images":["cgsh23"]},{"op":"text","speaker":"春原","text":"「我当然知道了！」"},{"op":"text","speaker":"朋也","text":"「我告诉你，春原。就半天没见面的人呢，是不会说好久不见的。」"},{"op":"goto","to":219},{"op":"ifFalse","to":219,"condition":["==",["v","f",813],2]},{"op":"bodies","images":["cgsh25"]},{"op":"text","speaker":"春原","text":"「哟，我是春原，１７岁，和你一样，是这里的学生。」"},{"op":"bodies","images":["cgsh12"]},{"op":"text","speaker":"春原","text":"「要不要一起吃个午饭？」"},{"op":"text","speaker":"","text":"我把手贴上春原的额头，看看他是不是发烧了。"},{"op":"text","speaker":"","text":"…没有。"},{"op":"text","speaker":"朋也","text":"「我告诉你，春原…其实我和你早就认识了。」"},{"op":"bodies","images":["cgsh23"]},{"op":"text","speaker":"春原","text":"「这还用你告诉我吗！」"},{"op":"text","speaker":"朋也","text":"「听我说，春原。人们是不会对已经认识的人再做自我介绍的。」"},{"op":"text","speaker":"春原","text":"「别说得好像我是神经病一样！」"},{"op":"text","speaker":"朋也","text":"「咦？原来不是啊？」"},{"op":"bodies","images":["cgsh17"]},{"op":"text","speaker":"春原","text":"「我正常得很！还不是你叫我说我才这么说的！」"},{"op":"text","speaker":"朋也","text":"「咦？有这回事？」"},{"op":"bodies","images":["cgsh16"]},{"op":"text","speaker":"春原","text":"「不是吧，你随口说说的吗…混蛋，亏我还按你要求说了…」"},{"op":"text","speaker":"朋也","text":"「不好意思不好意思。」"},{"op":"text","speaker":"朋也","text":"「那要不接下来这么办吧。」"},{"op":"bodies","images":["cgsh15"]},{"op":"text","speaker":"春原","text":"「什么啊…」"},{"op":"choice","id":"423:46630","target":["v","f",1089],"items":[{"text":"像站台上即将分开的恋人那样","value":0,"serial":46630},{"text":"像牺牲生命拯救地球的宇航员那样","value":1,"serial":46640},{"text":"像光靠回忆杀就能编好几本的漫画那样","value":2,"serial":46650}]},{"op":"ifFalse","to":238,"condition":["==",["v","f",1089],0]},{"op":"text","speaker":"朋也","text":"「像站台上即将分开的恋人那样约我试试。」"},{"op":"bodies","images":["cgsh24"]},{"op":"text","speaker":"春原","text":"「等等，那啥，我不是很懂你的意思。」"},{"op":"text","speaker":"朋也","text":"「我相信你能做到。」"},{"op":"text","speaker":"春原","text":"「不，就算我做得到，可是为什么我非这么做不可啊。」"},{"op":"goto","to":253},{"op":"ifFalse","to":245,"condition":["==",["v","f",1089],1]},{"op":"text","speaker":"朋也","text":"「像牺牲生命拯救地球的宇航员一样约我试试。」"},{"op":"bodies","images":["cgsh24"]},{"op":"text","speaker":"春原","text":"「等等，那啥，我不是很懂你的意思。」"},{"op":"text","speaker":"朋也","text":"「我相信你能做到。」"},{"op":"text","speaker":"春原","text":"「不，就算我做得到，可是为什么我非这么做不可啊。」"},{"op":"goto","to":253},{"op":"ifFalse","to":253,"condition":["==",["v","f",1089],2]},{"op":"text","speaker":"朋也","text":"「像光靠回忆杀就能编好几本的漫画那样约我试试。」"},{"op":"bodies","images":["cgsh24"]},{"op":"text","speaker":"春原","text":"「等等，那啥，我不是很懂你的意思。」"},{"op":"text","speaker":"朋也","text":"「这不遍地都是吗？那种战斗到高潮的时候突然开始一大段回忆杀的漫画。」"},{"op":"text","speaker":"春原","text":"「是不是遍地都是我不敢说，但的确是有…」"},{"op":"text","speaker":"朋也","text":"「所以啊，你先跑来跟我约饭，然后穿插一段回忆杀。」"},{"op":"text","speaker":"春原","text":"「等等，回忆杀加是能加，但我这是图个啥…」"},{"op":"set","target":["v","f",816],"value":["+",["v","f",1089],3]},{"op":"text","speaker":"朋也","text":"「为了让我能够自然而然地回应说，好，一起吧！连这都需要我点醒你吗？」"},{"op":"bodies","images":["cgsh16"]},{"op":"text","speaker":"春原","text":"「你是说真的吧。只要我这么搞，你就肯跟我一起去吃饭的吧。」"},{"op":"text","speaker":"朋也","text":"「那要看你演技如何了。」"},{"op":"bodies","images":["cgsh15"]},{"op":"text","speaker":"春原","text":"「你都说了是演技了，那肯定不自然了啊…」"},{"op":"bodies","images":["cgsh18"]},{"op":"text","speaker":"春原","text":"「行，怕你不成。试试就试试。」"},{"op":"ifFalse","to":267,"condition":["==",["v","f",215],1]},{"op":"callScene","scene":2423,"entry":1},{"op":"background","image":"kuro"},{"op":"bodies","images":[]},{"op":"goto","to":330},{"op":"background","image":"kuro"},{"op":"bodies","images":[]},{"op":"background","image":"bg025"},{"op":"bodies","images":[]},{"op":"bodies","images":["cgsh15"]},{"op":"text","speaker":"春原","text":"「看来今天也只能靠面包了。」"},{"op":"text","speaker":"朋也","text":"「是啊。」"},{"op":"background","image":"bg018"},{"op":"bodies","images":[]},{"op":"bodies","images":["cgsh10"]},{"op":"text","speaker":"春原","text":"「我又想到个新的打工途径。」"},{"op":"text","speaker":"朋也","text":"「说来听听。」"},{"op":"bodies","images":["cgsh12"]},{"op":"text","speaker":"春原","text":"「你不觉得其实我还挺帅的？」"},{"op":"ifFalse","to":287,"condition":["&&",["&&",["&&",["&&",["&&",["&&",["==",["v","f",300],0],["==",["v","f",3],1]],["&&",["==",["v","f",405],1],["==",["v","f",410],0]]],["&&",["==",["v","f",129],1],["==",["v","f",130],0]]],["&&",["==",["v","f",500],1],["==",["v","f",501],0]]],["==",["v","f",630],0]],["||",["&&",["==",["v","f",213],1],["==",["v","f",214],0]],["&&",["==",["v","f",214],1],["==",["v","f",215],0]]]]},{"op":"choice","id":"423:46980","target":["v","f",1089],"items":[{"text":"是啊","value":0,"serial":46980},{"text":"不好意思，不觉得","value":1,"serial":46990}]},{"op":"ifFalse","to":286,"condition":["==",["v","f",1089],0]},{"op":"jumpScene","scene":666,"entry":0},{"op":"goto","to":287},{"op":"ifFalse","to":287,"condition":["==",["v","f",1089],1]},{"op":"text","speaker":"朋也","text":"「不好意思，不觉得。」"},{"op":"bodies","images":["cgsh16"]},{"op":"text","speaker":"春原","text":"「你稍微附和一下会死啊？这天没法聊了！」"},{"op":"text","speaker":"朋也","text":"「行行，你是个超级无敌大帅哥。简称你糙哥。」"},{"op":"text","speaker":"春原","text":"「我总感觉糙哥的脸肯定很粗糙啊。」"},{"op":"text","speaker":"朋也","text":"「行了，我们的糙哥春原和打工又有什么关系呢？」"},{"op":"bodies","images":["cgsh10"]},{"op":"text","speaker":"春原","text":"「当然是靠我这张脸赚钱啦。」"},{"op":"text","speaker":"朋也","text":"「………」"},{"op":"text","speaker":"朋也","text":"「…马戏团？」"},{"op":"bodies","images":["cgsh23"]},{"op":"text","speaker":"春原","text":"「凭什么啊！」"},{"op":"text","speaker":"春原","text":"「我要做模特，做·模·特！」"},{"op":"text","speaker":"朋也","text":"「模特…？」"},{"op":"bodies","images":["cgsh12"]},{"op":"text","speaker":"春原","text":"「没错，我现在发现了。其实我很适合做模特。」"},{"op":"text","speaker":"春原","text":"「我的肌肉不多不少很均衡。」"},{"op":"text","speaker":"春原","text":"「说不定会有什么时尚杂志来邀我呢。」"},{"op":"text","speaker":"春原","text":"「然后说不定还能从模特华丽转型，在演艺界里出道。」"},{"op":"bodies","images":["cgsh13"]},{"op":"text","speaker":"春原","text":"「不好，说不定我会变成明星。」"},{"op":"text","speaker":"春原","text":"「拍摄影视剧，在演艺界里磨砺自己…」"},{"op":"bodies","images":["cgsh12"]},{"op":"text","speaker":"春原","text":"「然后许多小辈的来找我做靠山，就像石原军团一样，搞个春原军团出来。」"},{"op":"bodies","images":["cgsh25"]},{"op":"text","speaker":"春原","text":"「等到那时，冈崎，我会把你也招揽进我的军团来。」"},{"op":"text","speaker":"朋也","text":"「才不要，我可不想加入全是动物的军团。」"},{"op":"bodies","images":["cgsh23"]},{"op":"text","speaker":"春原","text":"「跟你说了不是马戏团！」"},{"op":"background","image":"bg021e"},{"op":"bodies","images":[]},{"op":"bodies","images":["cgsh12"]},{"op":"text","speaker":"春原","text":"「不过要是自己出了名，估计就有的好折腾的了。」"},{"op":"text","speaker":"朋也","text":"「你是糙哥没问题的，我信你。」"},{"op":"bodies","images":["cgsh16"]},{"op":"text","speaker":"春原","text":"「果然这不是什么好词吧…」"},{"op":"ifFalse","to":328,"condition":["==",["v","f",504],1]},{"op":"callScene","scene":5423,"entry":0},{"op":"background","image":"kuro"},{"op":"bodies","images":[]},{"op":"goto","to":330},{"op":"ifFalse","to":330,"condition":["==",["v","f",504],0]},{"op":"text","speaker":"","text":"今天的午休也在和春原的蠢话中结束了。"},{"op":"background","image":"bg021a"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"………。"},{"op":"ifFalse","to":379,"condition":["==",["v","f",128],1]},{"op":"background","image":"bg021b"},{"op":"bodies","images":[]},{"op":"set","target":["v","z",312],"value":1},{"op":"text","speaker":"朋也","text":"（呼…好疲倦…）"},{"op":"text","speaker":"","text":"看了看邻座。"},{"op":"text","speaker":"","text":"春原趴在桌上呼呼大睡。"},{"op":"text","speaker":"","text":"确实，像这样一觉睡到放学是打发上课时间最轻松的做法。"},{"op":"choice","id":"423:47380","target":["v","f",1089],"items":[{"text":"睡觉","value":0,"serial":47380},{"text":"散散心","value":1,"serial":47390}]},{"op":"ifFalse","to":348,"condition":["==",["v","f",1089],0]},{"op":"text","speaker":"","text":"能这样是最好不过了…明明很疲倦，可不知为什么我就是没有睡意。"},{"op":"background","image":"bg021"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"结果下一节课我也只能一直望着窗外打发时间…。"},{"op":"goto","to":374},{"op":"ifFalse","to":374,"condition":["==",["v","f",1089],1]},{"op":"text","speaker":"","text":"明明很疲倦，可不知为什么我就是没有睡意。"},{"op":"text","speaker":"朋也","text":"（是因为没怎么运动吧…）"},{"op":"text","speaker":"","text":"我走出教室想散散心。"},{"op":"set","target":["v","f",819],"value":1},{"op":"background","image":"bg018"},{"op":"bodies","images":[]},{"op":"text","speaker":"朋也","text":"（去买点饮料吧…）"},{"op":"background","image":"kuro"},{"op":"bodies","images":[]},{"op":"background","image":"bg018"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"回来路上。"},{"op":"text","speaker":"","text":"一阵急促的脚步声…"},{"op":"text","speaker":"","text":"一个娇小的身影从我身边跑过。"},{"op":"choice","id":"423:47520","target":["v","f",1089],"items":[{"text":"叫住她","value":0,"serial":47520},{"text":"随她去吧","value":1,"serial":47530}]},{"op":"ifFalse","to":368,"condition":["==",["v","f",1089],0]},{"op":"set","target":["v","f",126],"value":["+",["v","f",126],1]},{"op":"callScene","scene":1003,"entry":0},{"op":"goto","to":374},{"op":"ifFalse","to":374,"condition":["==",["v","f",1089],1]},{"op":"text","speaker":"","text":"我目送那娇小的身影跑开。"},{"op":"text","speaker":"朋也","text":"（她真在派发那东西吗…）"},{"op":"text","speaker":"","text":"她手里好像拿着之前送过给我的星型雕刻。"},{"op":"text","speaker":"朋也","text":"（哎，好好努力吧。）"},{"op":"text","speaker":"","text":"然后，我径直走回了教室。"},{"op":"background","image":"bg021a"},{"op":"bodies","images":[]},{"op":"set","target":["v","z",313],"value":1},{"op":"text","speaker":"","text":"………。"},{"op":"goto","to":379},{"op":"background","image":"kuro"},{"op":"bodies","images":[]},{"op":"background","image":"bg021h"},{"op":"bodies","images":[]},{"op":"set","target":["v","z",313],"value":1},{"op":"text","speaker":"","text":"接着第六节课的班会结束后，到了放学时间。"},{"op":"ifFalse","to":388,"condition":["==",["v","f",215],1]},{"op":"callScene","scene":2423,"entry":2},{"op":"goto","to":924},{"op":"ifFalse","to":424,"condition":["==",["v","f",410],1]},{"op":"bodies","images":["cgsh12"]},{"op":"text","speaker":"春原","text":"「终于熬到放学了。」"},{"op":"text","speaker":"","text":"春原站了起来，摆出一个胜利的造型。"},{"op":"text","speaker":"朋也","text":"「咦，你在这里的啊？」"},{"op":"bodies","images":["cgsh13"]},{"op":"text","speaker":"春原","text":"「整个下午我都在你旁边睡觉。」"},{"op":"bodies","images":["cgsh12"]},{"op":"text","speaker":"春原","text":"「顺便一提，梦里我和你在吃同一根Pocky！」"},{"op":"text","speaker":"朋也","text":"「呕…」"},{"op":"text","speaker":"春原","text":"「今天放学总能陪我转转了吧！」"},{"op":"text","speaker":"朋也","text":"「可以。」"},{"op":"bodies","images":["cgsh13"]},{"op":"text","speaker":"春原","text":"「好，我们走。多姿多彩的放学生活正等着我们！」"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"春原拿起书包走出了教室。"},{"op":"text","speaker":"","text":"………。"},{"op":"text","speaker":"","text":"……。"},{"op":"text","speaker":"","text":"…。"},{"op":"bodies","images":["cgsh23"]},{"op":"text","speaker":"春原","text":"「喂，你不一起来吗！」"},{"op":"text","speaker":"春原","text":"「等等，你刚刚不是说『可以』的吗！？」"},{"op":"text","speaker":"朋也","text":"「我就看看你会不会中招。」"},{"op":"text","speaker":"春原","text":"「一般人都会中招的吧！？」"},{"op":"text","speaker":"朋也","text":"「那啥，挺有意思的。你可以走了。」"},{"op":"bodies","images":["cgsh16"]},{"op":"text","speaker":"春原","text":"「逗我玩还不肯陪我…」"},{"op":"text","speaker":"春原","text":"「冈崎…你继续这样子的话…」"},{"op":"bodies","images":["cgsh23"]},{"op":"text","speaker":"春原","text":"「我就去交别的朋友了！！混蛋ーーーー！！」"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"留下这句话之后，春原头也不回地跑开了。"},{"op":"text","speaker":"","text":"我拿起书包站起身来。"},{"op":"set","target":["v","f",805],"value":["+",["v","f",805],1]},{"op":"callScene","scene":4423,"entry":1},{"op":"goto","to":924},{"op":"bodies","images":["cgsh12"]},{"op":"text","speaker":"春原","text":"「终于熬到放学了。」"},{"op":"text","speaker":"","text":"春原站了起来，摆出一个胜利的造型。"},{"op":"text","speaker":"朋也","text":"「今天还有什么活动吗？」"},{"op":"bodies","images":["cgsh13"]},{"op":"text","speaker":"春原","text":"「有。让我的房间变得更加信息化。」"},{"op":"text","speaker":"朋也","text":"「要放个计算器？」"},{"op":"bodies","images":["cgsh21"]},{"op":"text","speaker":"春原","text":"「这哪信息化了！」"},{"op":"text","speaker":"朋也","text":"「那要怎么搞。」"},{"op":"bodies","images":["cgsh12"]},{"op":"text","speaker":"春原","text":"「把昨天借来的电视机接上游戏机。」"},{"op":"text","speaker":"朋也","text":"「那真是信息化超前得没人能想到。」"},{"op":"bodies","images":["cgsh25"]},{"op":"text","speaker":"春原","text":"「是吧。」"},{"op":"bodies","images":["cgsh13"]},{"op":"text","speaker":"春原","text":"「明明有电视，却不拿来玩点什么的话就太浪费了。」"},{"op":"text","speaker":"朋也","text":"「如果能白玩游戏的话，帮你一下也无妨。」"},{"op":"bodies","images":["cgsh12"]},{"op":"text","speaker":"春原","text":"「我们得先去借来才行。」"},{"op":"text","speaker":"朋也","text":"「结果又是这套路啊…」"},{"op":"ifFalse","to":483,"condition":["==",["v","f",817],1]},{"op":"background","image":"bg015y"},{"op":"bodies","images":[]},{"op":"set","target":["v","f",1118],"value":3},{"op":"bodies","images":["cgsh10"]},{"op":"text","speaker":"春原","text":"「冈崎，再来帮我一把。」"},{"op":"text","speaker":"","text":"走出楼梯口，春原便不停地戳我的胳膊。"},{"op":"text","speaker":"朋也","text":"「帮什么？」"},{"op":"bodies","images":["cgsh12"]},{"op":"text","speaker":"春原","text":"「让我的房间变得更加信息化。」"},{"op":"text","speaker":"朋也","text":"「要放个计算器？」"},{"op":"bodies","images":["cgsh21"]},{"op":"text","speaker":"春原","text":"「这哪信息化了！」"},{"op":"text","speaker":"朋也","text":"「那要怎么搞。」"},{"op":"bodies","images":["cgsh12"]},{"op":"text","speaker":"春原","text":"「把昨天借来的电视机接上游戏机。」"},{"op":"text","speaker":"朋也","text":"「那真是信息化超前得没人能想到。」"},{"op":"bodies","images":["cgsh25"]},{"op":"text","speaker":"春原","text":"「是吧。」"},{"op":"bodies","images":["cgsh12"]},{"op":"text","speaker":"春原","text":"「明明有电视，却不拿来玩点什么的话就太浪费了。」"},{"op":"text","speaker":"朋也","text":"「如果能白玩游戏的话，帮你一下也无妨。」"},{"op":"text","speaker":"春原","text":"「我们得先去借来才行。」"},{"op":"text","speaker":"朋也","text":"「结果又是这套路啊…」"},{"op":"background","image":"bg012y"},{"op":"bodies","images":[]},{"op":"set","target":["v","f",1118],"value":4},{"op":"text","speaker":"朋也","text":"「那今天就这样吧。」"},{"op":"bodies","images":["cgng10"]},{"op":"text","speaker":"古河","text":"「好的，谢谢你能陪我。」"},{"op":"text","speaker":"古河","text":"「那么，再会。」"},{"op":"text","speaker":"朋也","text":"「嗯，拜拜。」"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"走下坡道，我和古河道别。"},{"op":"bodies","images":["cgsh12"]},{"op":"text","speaker":"春原","text":"「拜拜。」"},{"op":"bodies","images":["cgsh25"]},{"op":"text","speaker":"春原","text":"「好，我们走。」"},{"op":"background","image":"kuro"},{"op":"bodies","images":[]},{"op":"background","image":"bg033y"},{"op":"bodies","images":[]},{"op":"set","target":["v","f",1118],"value":4},{"op":"set","target":["v","z",314],"value":1},{"op":"bodies","images":["cgsh13"]},{"op":"text","speaker":"春原","text":"「嘿嘿，简直是小菜一碟。」"},{"op":"text","speaker":"","text":"走在我旁边的春原直接抱着游戏机本体。"},{"op":"text","speaker":"","text":"而我拿着装有手柄和游戏卡的纸袋。这些都是从低年级学生那边借来的。"},{"op":"bodies","images":["cgsh12"]},{"op":"text","speaker":"春原","text":"「游戏总不会再出什么幺蛾子了吧。」"},{"op":"text","speaker":"朋也","text":"「我有点在意那人说游戏是弟弟的。」"},{"op":"bodies","images":["cgsh13"]},{"op":"text","speaker":"春原","text":"「不就是弟弟更喜欢打游戏吗。」"},{"op":"text","speaker":"朋也","text":"「是这样倒好了。」"},{"op":"bodies","images":["cgsh25"]},{"op":"text","speaker":"春原","text":"「我们回去就战个痛吧。战到手指皮都裂开来为止。」"},{"op":"text","speaker":"","text":"要不要那么拼。"},{"op":"background","image":"bg046yt"},{"op":"bodies","images":[]},{"op":"set","target":["v","f",1118],"value":3},{"op":"bodies","images":["cgsh25"]},{"op":"text","speaker":"春原","text":"「好，开始接线。」"},{"op":"text","speaker":"","text":"回到房间，春原就迫不及待地把游戏机接上电视。"},{"op":"bodies","images":["cgsh10"]},{"op":"text","speaker":"春原","text":"「你把线插那里去。」"},{"op":"text","speaker":"","text":"春原递给我一条连接线。"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"我插。"},{"op":"bodies","images":["cgsh23"]},{"op":"text","speaker":"春原","text":"「呜哇啊啊啊啊啊啊啊ーー！」"},{"op":"text","speaker":"","text":"因为春原屁股就在眼前晃荡，我便往那边插过去了。"},{"op":"text","speaker":"春原","text":"「你干什么啊！」"},{"op":"text","speaker":"春原","text":"「插游戏机上去啊！」"},{"op":"bodies","images":[]},{"op":"text","speaker":"朋也","text":"「是是，抱歉。」"},{"op":"bodies","images":["cgsh12"]},{"op":"text","speaker":"春原","text":"「好，安装完毕。」"},{"op":"text","speaker":"春原","text":"「接下来只要把游戏卡插进去就行了。」"},{"op":"bodies","images":["cgsh13"]},{"op":"text","speaker":"春原","text":"「来选一盘你喜欢的。」"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"我从纸袋里挑出一盘游戏卡插进游戏机里。"},{"op":"bodies","images":["cgsh25"]},{"op":"text","speaker":"春原","text":"「开关，打开！」"},{"op":"text","speaker":"","text":"春原打开了开关。"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"显像管里映出了游戏标题。"},{"op":"text","speaker":"春原","text":"「………」"},{"op":"bodies","images":["cgsh27"]},{"op":"text","speaker":"春原","text":"「…算数游戏？」"},{"op":"text","speaker":"朋也","text":"「你不擅长这一类吧。」"},{"op":"bodies","images":["cgsh25"]},{"op":"text","speaker":"春原","text":"「不错，就靠这个学会九九乘法吧。」"},{"op":"set","target":["v","z",322],"value":1},{"op":"bodies","images":["cgsh23"]},{"op":"text","speaker":"春原","text":"「喂，怎么是教育游戏啊！」"},{"op":"text","speaker":"朋也","text":"「因为那人弟弟还小吧。」"},{"op":"bodies","images":["cgsh27"]},{"op":"text","speaker":"春原","text":"「…哈？」"},{"op":"bodies","images":["cgsh16"]},{"op":"text","speaker":"春原","text":"「我又有了不详的预感…」"},{"op":"text","speaker":"朋也","text":"「是啊。你自己来看看？」"},{"op":"text","speaker":"春原","text":"「好…好吧…」"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"春原翻看起纸袋里的东西。"},{"op":"text","speaker":"春原","text":"「这是，幼儿动画益智游戏…」"},{"op":"text","speaker":"春原","text":"「这盘是拼图游戏…」"},{"op":"text","speaker":"春原","text":"「没有…没有…」"},{"op":"text","speaker":"春原","text":"「没有动作游戏，也没射击游戏…」"},{"op":"bodies","images":["cgsh23"]},{"op":"text","speaker":"春原","text":"「没有一盘适合我们这种青少年的游戏ーーー！」"},{"op":"text","speaker":"朋也","text":"「都叫你事先确认一下了。」"},{"op":"text","speaker":"朋也","text":"「还有，别喊什么青少年的。」"},{"op":"bodies","images":["cgsh26"]},{"op":"text","speaker":"春原","text":"「嘿，嘿嘿…呜嘿嘿…」"},{"op":"text","speaker":"朋也","text":"「哦，下调自己的智商，然后玩这游戏吗。有你的。」"},{"op":"text","speaker":"春原","text":"「４乘５是…我想想…是２０吧～」"},{"op":"text","speaker":"朋也","text":"「哦ー，好聪明。」"},{"op":"text","speaker":"春原","text":"「嘿嘿～」"},{"op":"set","target":["v","f",1118],"value":0},{"op":"ifFalse","to":572,"condition":["==",["v","f",818],1]},{"op":"background","image":"kuro"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"晚上，我照例来到了春原的房间。"},{"op":"background","image":"bg046n"},{"op":"bodies","images":[]},{"op":"goto","to":578},{"op":"ifFalse","to":578,"condition":["==",["v","f",818],0]},{"op":"background","image":"kuro"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"在天黑之前，我先回家换了身衣服，然后再回到春原的房间。"},{"op":"background","image":"bg046nt"},{"op":"bodies","images":[]},{"op":"set","target":["v","z",313],"value":1},{"op":"text","speaker":"朋也","text":"「………」"},{"op":"text","speaker":"朋也","text":"「…春原？」"},{"op":"text","speaker":"","text":"我没看见屋主的身影。"},{"op":"text","speaker":"朋也","text":"（上厕所去了吗…）"},{"op":"text","speaker":"","text":"我来到我的指定座位，开始翻阅起杂志。"},{"op":"text","speaker":"声","text":"「春原～」"},{"op":"text","speaker":"","text":"听到走廊里有人喊他。是美佐枝小姐。"},{"op":"text","speaker":"声","text":"「春原，在不在ー？」"},{"op":"text","speaker":"朋也","text":"「人不在。」"},{"op":"text","speaker":"声","text":"「有你的电话～」"},{"op":"text","speaker":"朋也","text":"「都说了不在了。」"},{"op":"text","speaker":"","text":"源源不断的呼喊声让我不免有点烦躁，我打算窝进被炉躲一躲。"},{"op":"text","speaker":"声","text":"「是你妹妹打来的～」"},{"op":"ifFalse","to":596,"condition":["==",["v","f",812],1]},{"op":"text","speaker":"","text":"传说中的春原妹妹吗…。"},{"op":"text","speaker":"","text":"我想象了一下。"},{"op":"goto","to":603},{"op":"ifFalse","to":603,"condition":["==",["v","f",812],0]},{"op":"text","speaker":"","text":"唰。"},{"op":"text","speaker":"","text":"我猛地站起身。"},{"op":"text","speaker":"朋也","text":"「妹妹！？」"},{"op":"text","speaker":"朋也","text":"「那家伙…居然还有个妹妹…」"},{"op":"text","speaker":"","text":"…我还真不知道。"},{"op":"text","speaker":"","text":"春原的妹妹吗。肯定不是什么正经货色。"},{"op":"text","speaker":"","text":"不过春原长得还算秀气，他妹妹估计也难看不到哪儿去。"},{"op":"text","speaker":"","text":"不过，就春原那性格来看…"},{"op":"set","target":["v","z",327],"value":1},{"op":"text","speaker":"","text":"「哥哥，是我哦。呜呼呼呼…咕咕…叽叽叽…嗝ーーーー！」"},{"op":"text","speaker":"","text":"肯定是这种，前言不搭后语性格判若两人的家伙。"},{"op":"text","speaker":"","text":"等等，刚才我想象中的不只是性格，就连容貌都变了吧。"},{"op":"text","speaker":"","text":"而春原那家伙则是这样…"},{"op":"text","speaker":"","text":"「哟，老妹，好久不见…嗝嗝…咕哇咕哇咕哇…唉呀，不小心把听筒给吃了！」"},{"op":"text","speaker":"","text":"说不定他们之间是这样交流的。"},{"op":"text","speaker":"","text":"太可怕了…就在我所不知道的地方，妖怪之间正进行着交流…。"},{"op":"text","speaker":"","text":"正当我瑟瑟发抖，缩成一团时…"},{"op":"set","target":["v","z",314],"value":1},{"op":"text","speaker":"声","text":"「这不是在吗。」"},{"op":"bodies","images":["cgms15"]},{"op":"text","speaker":"","text":"美佐枝小姐擅自拉开了门，从上往下俯视着我。"},{"op":"text","speaker":"朋也","text":"「我是冈崎。」"},{"op":"bodies","images":["cgms10"]},{"op":"text","speaker":"美佐枝","text":"「你们不是很要好吗。代他听一下有什么事吧。」"},{"op":"text","speaker":"朋也","text":"「为什么要我去…」"},{"op":"bodies","images":["cgms15h"]},{"op":"text","speaker":"美佐枝","text":"「好像有什么很重要的事情。」"},{"op":"text","speaker":"美佐枝","text":"「别看是春原的妹妹，她是个很懂礼貌的好孩子哦。」"},{"op":"text","speaker":"朋也","text":"「真的假的…？」"},{"op":"bodies","images":["cgms10"]},{"op":"text","speaker":"美佐枝","text":"「嗯，所以去代接一下吧。」"},{"op":"choice","id":"423:49260","target":["v","f",1089],"items":[{"text":"代接电话","value":0,"serial":49260},{"text":"不接电话","value":1,"serial":49270}]},{"op":"ifFalse","to":631,"condition":["==",["v","f",1089],0]},{"op":"goto","to":718},{"op":"ifFalse","to":718,"condition":["==",["v","f",1089],1]},{"op":"text","speaker":"朋也","text":"「既然是重要的事情，更不应该让别人代接吧？」"},{"op":"bodies","images":["cgms17h"]},{"op":"text","speaker":"美佐枝","text":"「是吗？」"},{"op":"text","speaker":"朋也","text":"「我估计他也快回来了，你让他妹妹过会儿再打吧。」"},{"op":"bodies","images":["cgms14h"]},{"op":"text","speaker":"美佐枝","text":"「唉…知道了。也只好这样了。」"},{"op":"text","speaker":"","text":"她只是想省掉再传呼一次的麻烦吧。"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"美佐枝小姐不情不愿地走了。"},{"op":"bodies","images":["cgsh16b"]},{"op":"text","speaker":"春原","text":"「呼…差点把命给搭上了…」"},{"op":"text","speaker":"朋也","text":"「出什么事了。」"},{"op":"text","speaker":"春原","text":"「啊…晚饭里肯定有什么东西不干不净的…」"},{"op":"text","speaker":"春原","text":"「我吃坏肚子去蹲坑，结果橄榄球部的那群人也陆陆续续进来…」"},{"op":"text","speaker":"春原","text":"「然后不停地敲我蹲那坑的门。」"},{"op":"text","speaker":"春原","text":"「结果我内裤都还没穿上，就被他们给拽了出来…」"},{"op":"text","speaker":"春原","text":"「该死的…晚饭！」"},{"op":"text","speaker":"朋也","text":"「你是不是搞错仇恨的对象了？」"},{"op":"bodies","images":["cgsh23b"]},{"op":"text","speaker":"春原","text":"「没有！」"},{"op":"text","speaker":"朋也","text":"「哦，是吗。」"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"敲了两声门，美佐枝小姐露面了。"},{"op":"bodies","images":["cgms10"]},{"op":"text","speaker":"美佐枝","text":"「啊，春原回来了。那就好，有你妹妹打来的电话。」"},{"op":"bodies","images":["cgsh20b"]},{"op":"text","speaker":"春原","text":"「…啊？」"},{"op":"text","speaker":"","text":"春原脸色一变。"},{"op":"text","speaker":"春原","text":"「哦，知道了…」"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"春原跟在美佐枝小姐身后走出了房间。"},{"op":"text","speaker":"","text":"………。"},{"op":"text","speaker":"","text":"现在那边正开展着妖怪之间的对话。"},{"op":"text","speaker":"朋也","text":"（好恐怖…）"},{"op":"bodies","images":["cgsh16b"]},{"op":"text","speaker":"春原","text":"「呼…」"},{"op":"text","speaker":"","text":"大概过了五分钟，春原回来了。"},{"op":"text","speaker":"春原","text":"「真是的，那丫头…」"},{"op":"text","speaker":"朋也","text":"「是你妹妹？」"},{"op":"text","speaker":"春原","text":"「是啊。」"},{"op":"text","speaker":"春原","text":"「真让人头大，明明已经那么大了…」"},{"op":"text","speaker":"朋也","text":"「还没长出羽毛吗？」"},{"op":"bodies","images":["cgsh23b"]},{"op":"text","speaker":"春原","text":"「永远都不会长好吗！」"},{"op":"bodies","images":["cgsh16b"]},{"op":"text","speaker":"春原","text":"「你把我妹妹想象成什么样了…」"},{"op":"text","speaker":"朋也","text":"「像你这样的。」"},{"op":"text","speaker":"春原","text":"「我也不长羽毛吧。」"},{"op":"text","speaker":"朋也","text":"「可是看你一副快长的样子。」"},{"op":"text","speaker":"春原","text":"「怎么个样子…」"},{"op":"ifFalse","to":687,"condition":["==",["v","f",812],0]},{"op":"text","speaker":"朋也","text":"「话说，我还真不知道你有个妹妹。」"},{"op":"bodies","images":["cgsh15b"]},{"op":"text","speaker":"春原","text":"「你又没问，我没必要特意告诉你吧。」"},{"op":"goto","to":690},{"op":"ifFalse","to":690,"condition":["==",["v","f",812],1]},{"op":"text","speaker":"朋也","text":"「让我见一面嘛。我突然有点兴趣了。」"},{"op":"text","speaker":"春原","text":"「不要…」"},{"op":"text","speaker":"朋也","text":"「为啥。难道你把人家封印在地下室了？」"},{"op":"bodies","images":["cgsh23b"]},{"op":"text","speaker":"春原","text":"「光天化日，走得可欢了！」"},{"op":"bodies","images":["cgsh16b"]},{"op":"text","speaker":"春原","text":"「我告诉你啊，冈崎…」"},{"op":"text","speaker":"春原","text":"「我妹妹肯定比你想象中要更乖巧可爱。」"},{"op":"text","speaker":"朋也","text":"「不是吧，莫非…你是妹控？」"},{"op":"bodies","images":["cgsh17b"]},{"op":"text","speaker":"春原","text":"「还不是因为你胡扯什么羽毛什么封印，把我妹说的像妖怪一样！」"},{"op":"bodies","images":["cgsh16b"]},{"op":"text","speaker":"春原","text":"「和你那种想象相比，我妹妹肯定要更乖巧可爱。」"},{"op":"text","speaker":"朋也","text":"「来来，照片拿来看一眼。」"},{"op":"bodies","images":["cgsh15b"]},{"op":"text","speaker":"春原","text":"「我没照片。」"},{"op":"text","speaker":"春原","text":"「她要是不打电话过来，我都要忘了我还有个妹妹。」"},{"op":"bodies","images":["cgsh18b"]},{"op":"text","speaker":"春原","text":"「这就是我对我妹关心的程度。Really？」"},{"op":"text","speaker":"朋也","text":"「你英语用错了。」"},{"op":"bodies","images":["cgsh15b"]},{"op":"text","speaker":"春原","text":"「反正你也见不到她，这个话题就此打住。」"},{"op":"text","speaker":"朋也","text":"「是吗。」"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"我继续看起杂志来。"},{"op":"text","speaker":"春原","text":"「真是的，那丫头…」"},{"op":"text","speaker":"春原","text":"「也有她可爱的地方嘛…」"},{"op":"text","speaker":"","text":"一副想我多听多问的架势。"},{"op":"text","speaker":"","text":"我决定无视。"},{"op":"goto","to":924},{"op":"text","speaker":"朋也","text":"「嘁…」"},{"op":"text","speaker":"","text":"我不情愿地站起身来。"},{"op":"background","image":"bg045n"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"我走到走廊里，接起那个倒挂悬空的听筒。"},{"op":"text","speaker":"朋也","text":"「嗝ーーー！」"},{"op":"text","speaker":"声","text":"『哇…怎么了？』"},{"op":"text","speaker":"","text":"看来应该用正常方式打招呼。"},{"op":"text","speaker":"朋也","text":"「喂喂。」"},{"op":"text","speaker":"声","text":"『啊，是哥哥吗？』"},{"op":"text","speaker":"朋也","text":"「嗯，是我，我就是你人生中最大污点的哥哥。」"},{"op":"text","speaker":"朋也","text":"「原谅哥哥的这副德性吧…」"},{"op":"text","speaker":"声","text":"『你在说什么呢？』"},{"op":"text","speaker":"","text":"轻易地被略过了。"},{"op":"text","speaker":"声","text":"『我说，哥哥。我去你那儿一趟，可以吗？』"},{"op":"text","speaker":"朋也","text":"「我这儿？你说的是哪？」"},{"op":"text","speaker":"声","text":"『当然是你的宿舍啦。』"},{"op":"text","speaker":"朋也","text":"「对不住，妹妹啊…其实我在蹲局子呢。」"},{"op":"text","speaker":"朋也","text":"「哥哥我搞砸了事，被抓进去了…」"},{"op":"text","speaker":"声","text":"『又说这种怪话来脱身。』"},{"op":"text","speaker":"声","text":"『这次我真的会过来哦。』"},{"op":"text","speaker":"声","text":"『你什么时候方便？』"},{"op":"text","speaker":"朋也","text":"「周末。」"},{"op":"text","speaker":"","text":"我不假思索就回答了。"},{"op":"text","speaker":"声","text":"『那么，就这周六。我争取傍晚时候到。』"},{"op":"text","speaker":"声","text":"『你要我带什么礼物？』"},{"op":"text","speaker":"声","text":"『啊，快没时间了，赶紧说。』"},{"op":"text","speaker":"朋也","text":"「泥偶。」"},{"op":"text","speaker":"声","text":"『明白，那我挂了。』"},{"op":"text","speaker":"","text":"…嘟ー嘟ー嘟…"},{"op":"text","speaker":"","text":"挂断了。"},{"op":"text","speaker":"朋也","text":"（我刚才，最后说了什么来着…）"},{"op":"text","speaker":"朋也","text":"（算了，大概不是什么要紧事…）"},{"op":"text","speaker":"朋也","text":"「呼…」"},{"op":"text","speaker":"","text":"我回到房间。"},{"op":"ifFalse","to":757,"condition":["==",["v","f",815],0]},{"op":"background","image":"bg046n"},{"op":"bodies","images":[]},{"op":"goto","to":760},{"op":"ifFalse","to":760,"condition":["==",["v","f",815],1]},{"op":"background","image":"bg046nt"},{"op":"bodies","images":[]},{"op":"set","target":["v","z",322],"value":1},{"op":"bodies","images":["cgsh13b"]},{"op":"text","speaker":"春原","text":"「哟，去给妹子打电话啦？」"},{"op":"text","speaker":"","text":"春原已经回来了。"},{"op":"text","speaker":"朋也","text":"「嗯，你算是猜对了一半…」"},{"op":"bodies","images":["cgsh20b"]},{"op":"text","speaker":"春原","text":"「一半是妹子？那剩下一半是啥啊…」"},{"op":"text","speaker":"朋也","text":"「你应该猜得出的。」"},{"op":"bodies","images":["cgsh18b"]},{"op":"text","speaker":"春原","text":"「给点提示嘛，提示。」"},{"op":"text","speaker":"朋也","text":"「提示啊…」"},{"op":"text","speaker":"朋也","text":"「嗝ーーー！」"},{"op":"bodies","images":["cgsh16b"]},{"op":"text","speaker":"春原","text":"「越来越搞不懂了…」"},{"op":"text","speaker":"朋也","text":"「既是人，又不是人…」"},{"op":"bodies","images":["cgsh27b"]},{"op":"text","speaker":"春原","text":"「真的假的…你认识的人好牛啊。」"},{"op":"text","speaker":"朋也","text":"「不就是你妹妹吗。」"},{"op":"bodies","images":["cgsh20b"]},{"op":"text","speaker":"春原","text":"「你说啥？」"},{"op":"text","speaker":"朋也","text":"「刚才打来电话的。」"},{"op":"bodies","images":["cgsh23b"]},{"op":"text","speaker":"春原","text":"「喂，你说谁的妹妹不是人啊！」"},{"op":"text","speaker":"春原","text":"「喂，嗝ーーー！又是什么鬼啊！」"},{"op":"text","speaker":"春原","text":"「喂，你怎么会和我妹妹搭上话的！」"},{"op":"text","speaker":"春原","text":"「喂，这槽点也太多了吧！」"},{"op":"text","speaker":"春原","text":"「呼哧…呼哧…」"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"啪…。"},{"op":"text","speaker":"","text":"我停下阅读杂志，抬起头。"},{"op":"text","speaker":"朋也","text":"「哦，你说完啦？」"},{"op":"bodies","images":["cgsh23b"]},{"op":"text","speaker":"春原","text":"「你这个人啊！」"},{"op":"text","speaker":"","text":"他抓着我的脖子，晃来晃去。"},{"op":"bodies","images":[]},{"op":"text","speaker":"朋也","text":"「放手啦，二货。」"},{"op":"text","speaker":"朋也","text":"「是美佐枝小姐喊我去替你接电话的。」"},{"op":"bodies","images":["cgsh20b"]},{"op":"text","speaker":"春原","text":"「是对面打来的？」"},{"op":"text","speaker":"朋也","text":"「是啊。」"},{"op":"bodies","images":["cgsh15b"]},{"op":"text","speaker":"春原","text":"「说什么了？」"},{"op":"text","speaker":"朋也","text":"「说要过来。」"},{"op":"bodies","images":["cgsh20b"]},{"op":"text","speaker":"春原","text":"「没说要换我来接电话？」"},{"op":"text","speaker":"朋也","text":"「不是，这个嘛…」"},{"op":"text","speaker":"朋也","text":"「春原…你冷静点听我说。」"},{"op":"bodies","images":["cgsh15b"]},{"op":"text","speaker":"春原","text":"「怎么了…」"},{"op":"text","speaker":"朋也","text":"「我学着你的样子说话，你妹妹居然就真信了。」"},{"op":"text","speaker":"朋也","text":"「我回答说周末可以…」"},{"op":"text","speaker":"朋也","text":"「她就说周六傍晚到这边。」"},{"op":"bodies","images":["cgsh16b"]},{"op":"text","speaker":"春原","text":"「………」"},{"op":"text","speaker":"朋也","text":"「我要是不这么干，你都不会见她一面对吧，真拿你没办法。」"},{"op":"bodies","images":["cgsh23b"]},{"op":"text","speaker":"春原","text":"「你别装的像个爱管闲事的朋友似的！」"},{"op":"bodies","images":["cgsh16b"]},{"op":"text","speaker":"春原","text":"「你根本不知道我妹妹怎么回事。」"},{"op":"text","speaker":"朋也","text":"「我想，应该没有超出我想象的范围。」"},{"op":"bodies","images":["cgsh23b"]},{"op":"text","speaker":"春原","text":"「就你那想象的范围，永远超不出的好吗！」"},{"op":"text","speaker":"春原","text":"「我话说在前头，她只是个很普通的女孩。」"},{"op":"text","speaker":"朋也","text":"「怎么，是这样的吗？」"},{"op":"bodies","images":["cgsh14b"]},{"op":"text","speaker":"春原","text":"「是啊。很普通的女孩子。稍微有点兄控…」"},{"op":"text","speaker":"朋也","text":"「肉麻死了。」"},{"op":"bodies","images":["cgsh23b"]},{"op":"text","speaker":"春原","text":"「我这句话很帅的好吧！」"},{"op":"text","speaker":"朋也","text":"「于是你妹妹过来这边，有什么问题吗？」"},{"op":"bodies","images":["cgsh16b"]},{"op":"text","speaker":"春原","text":"「问题在于她的目的啊。」"},{"op":"text","speaker":"朋也","text":"「目的？还有这种东西吗？」"},{"op":"text","speaker":"春原","text":"「是啊…」"},{"op":"text","speaker":"春原","text":"「那家伙…是来检查我过得好不好的。」"},{"op":"text","speaker":"朋也","text":"「你这不是好得都快死了吗。」"},{"op":"text","speaker":"春原","text":"「嗯，身体方面的话…话说都快死了是什么情况？」"},{"op":"text","speaker":"朋也","text":"「如果不是身体方面的话，莫非是那边。」"},{"op":"text","speaker":"春原","text":"「是啊…」"},{"op":"text","speaker":"朋也","text":"「是身为艺人的素质方面啊…」"},{"op":"bodies","images":["cgsh23b"]},{"op":"text","speaker":"春原","text":"「不是啦。」"},{"op":"text","speaker":"朋也","text":"「那是什么？」"},{"op":"text","speaker":"春原","text":"「是精神方面啊。」"},{"op":"bodies","images":["cgsh16b"]},{"op":"text","speaker":"春原","text":"「她是非常支持我去踢足球的…」"},{"op":"text","speaker":"春原","text":"「而且我还摆架子说，就算是笨蛋球踢得好也能升学…」"},{"op":"text","speaker":"朋也","text":"「你也知道自己是笨蛋啊。」"},{"op":"bodies","images":["cgsh23b"]},{"op":"text","speaker":"春原","text":"「知道啊，请你放过我行不行！」"},{"op":"bodies","images":["cgsh16b"]},{"op":"text","speaker":"春原","text":"「所以…我现在这个样子，她很担心我…」"},{"op":"text","speaker":"朋也","text":"「过年的时候，你不是能回去看她的吗？」"},{"op":"text","speaker":"春原","text":"「不，我今年没回去。」"},{"op":"text","speaker":"春原","text":"「而且我在家的时候爱面子，吹了些有的没的…」"},{"op":"bodies","images":["cgsh14b"]},{"op":"text","speaker":"春原","text":"「所以我估计那家伙是想过来，亲眼看看我平时的状态…」"},{"op":"text","speaker":"朋也","text":"「嗯…话说，你妹妹几岁了？」"},{"op":"bodies","images":["cgsh16b"]},{"op":"text","speaker":"春原","text":"「你这问题好突兀啊。」"},{"op":"text","speaker":"朋也","text":"「行了，你就说吧。」"},{"op":"bodies","images":["cgsh15b"]},{"op":"text","speaker":"春原","text":"「１３。」"},{"op":"text","speaker":"朋也","text":"「这么说…初中二年级啊…」"},{"op":"text","speaker":"朋也","text":"「现在不该上学吗？怎么会想到这个当口过来的？」"},{"op":"bodies","images":["cgsh16b"]},{"op":"text","speaker":"春原","text":"「啧…逃学来的吗…」"},{"op":"text","speaker":"朋也","text":"「这点上倒是和她哥一个样。」"},{"op":"text","speaker":"春原","text":"「都是一根筋啊。」"},{"op":"text","speaker":"朋也","text":"「你嘛，就是橡皮筋，小朋友玩的那种。」"},{"op":"text","speaker":"春原","text":"「你别老是乱补充了。」"},{"op":"text","speaker":"朋也","text":"「话说，你打算怎么办？」"},{"op":"bodies","images":["cgsh15b"]},{"op":"text","speaker":"春原","text":"「还能怎么办，她不是要来吗？」"},{"op":"text","speaker":"朋也","text":"「你别问我啊。」"},{"op":"bodies","images":["cgsh23b"]},{"op":"text","speaker":"春原","text":"「不是你决定的吗！」"},{"op":"text","speaker":"朋也","text":"「哦，对。我都忘了。」"},{"op":"bodies","images":["cgsh16b"]},{"op":"text","speaker":"春原","text":"「到底该怎么办啊…」"},{"op":"text","speaker":"朋也","text":"「让她看看你过得很好不就行了。」"},{"op":"bodies","images":["cgsh18b"]},{"op":"text","speaker":"春原","text":"「要怎么给她看啊。」"},{"op":"text","speaker":"朋也","text":"「我把你痛扁一顿，然后你还一直哈哈哈哈狂笑，怎么样？」"},{"op":"bodies","images":["cgsh23b"]},{"op":"text","speaker":"春原","text":"「这是有病吧。」"},{"op":"text","speaker":"朋也","text":"「也对…」"},{"op":"bodies","images":["cgsh15b"]},{"op":"text","speaker":"朋也","text":"「那么，我把你痛扁一顿，你一副绰绰有余的样子，说完全不痛不痒，怎么样？」"},{"op":"bodies","images":["cgsh23b"]},{"op":"text","speaker":"春原","text":"「凭什么全是我被痛扁一顿的主意啊！」"},{"op":"text","speaker":"朋也","text":"「你要求真多…」"},{"op":"bodies","images":["cgsh16b"]},{"op":"text","speaker":"春原","text":"「我刚说了，不是这种层面上的过得好啊。」"},{"op":"text","speaker":"春原","text":"「也就是说…」"},{"op":"bodies","images":["cgsh14b"]},{"op":"text","speaker":"春原","text":"「问题在于梦想破灭的我，是不是还能找到另外一种幸福…」"},{"op":"text","speaker":"朋也","text":"「另外一种幸福啊…」"},{"op":"bodies","images":["cgsh16b"]},{"op":"text","speaker":"","text":"我直勾勾地盯着春原的脸。"},{"op":"text","speaker":"","text":"事到如今，究竟还会有什么样的幸福降临在这人头上呢？"},{"op":"text","speaker":"朋也","text":"「没有。」"},{"op":"bodies","images":["cgsh15b"]},{"op":"text","speaker":"春原","text":"「什么没有啊？」"},{"op":"text","speaker":"朋也","text":"「那啥，我是说你不会有幸福的。」"},{"op":"bodies","images":["cgsh16b"]},{"op":"text","speaker":"春原","text":"「你若无其事地说出了超级刻薄的话。」"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"春原叹着气，盘腿坐下。"},{"op":"text","speaker":"朋也","text":"「行啦，你也别这么丧气啦。」"},{"op":"text","speaker":"朋也","text":"「不都是你自作自受吗？」"},{"op":"bodies","images":["cgsh23b"]},{"op":"text","speaker":"春原","text":"「百分百是因为你好吧！」"},{"op":"text","speaker":"朋也","text":"「不，我是说你之所以会没有幸福，全是你自作自受。」"},{"op":"text","speaker":"春原","text":"「你这是若无其事地重复了一遍刻薄的话。」"},{"op":"bodies","images":["cgsh16b"]},{"op":"text","speaker":"春原","text":"「哎…」"},{"op":"text","speaker":"","text":"春原的肩膀耷拉得更低了。"},{"op":"text","speaker":"朋也","text":"「不过，这也不能说不是我埋下的种…退一万步说…」"},{"op":"text","speaker":"朋也","text":"「所以呢，我会给你想办法的。」"},{"op":"bodies","images":["cgsh27b"]},{"op":"text","speaker":"春原","text":"「真的？话说，再之前那句话我怎么听着有点不舒服…」"},{"op":"text","speaker":"朋也","text":"「放心，就交给我吧。」"},{"op":"set","target":["v","f",17],"value":1},{"op":"background","image":"kuro"},{"op":"bodies","images":[]},{"op":"jumpScene","scene":424,"entry":0},{"op":"return"}]