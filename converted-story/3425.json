[{"op":"set","target":["v","f",1108],"value":0},{"op":"set","target":["v","f",1109],"value":4},{"op":"set","target":["v","f",1110],"value":25},{"op":"set","target":["v","f",1111],"value":5},{"op":"set","target":["v","f",1112],"value":1},{"op":"background","image":"kuro"},{"op":"bodies","images":[]},{"op":"set","target":["v","z",322],"value":1},{"op":"text","speaker":"","text":"一步…一步…一步…一步…。"},{"op":"background","image":"bg018"},{"op":"bodies","images":[]},{"op":"text","speaker":"朋也","text":"「………」"},{"op":"text","speaker":"","text":"我一个人在走廊上走着…。"},{"op":"text","speaker":"","text":"一步…一步…一步…一步…。"},{"op":"text","speaker":"朋也","text":"「啊…」"},{"op":"text","speaker":"","text":"手里提着书包。"},{"op":"text","speaker":"","text":"已经放学，不会有人说什么…。"},{"op":"text","speaker":"","text":"一步…一步…一步…一步…。"},{"op":"text","speaker":"朋也","text":"「………」"},{"op":"text","speaker":"","text":"我止住脚步，转身回头，远处看见了杏的身影…。"},{"op":"text","speaker":"","text":"她手叉着腰，紧紧地盯着我。"},{"op":"text","speaker":"","text":"没办法，我再次迈开了脚步。"},{"op":"text","speaker":"","text":"一步…一步…一步…一步…。"},{"op":"text","speaker":"朋也","text":"「唉…」"},{"op":"text","speaker":"","text":"叹不完的气。"},{"op":"text","speaker":"","text":"手中的书包里分明没什么，却感觉格外的沉重。"},{"op":"text","speaker":"","text":"我已经很久没有带着忧郁回家过了。"},{"op":"text","speaker":"朋也","text":"「我怎么就这么没学习能力呢…」"},{"op":"text","speaker":"","text":"我如同苛责着自己的愚笨般，疯狂的摇头。"},{"op":"text","speaker":"","text":"昨天刚吃过苦，今天又这样…。"},{"op":"text","speaker":"朋也","text":"「校门…吗。」"},{"op":"text","speaker":"","text":"嘴里念叨着目的地，我失落地垂下了头。"},{"op":"text","speaker":"","text":"连叹气的力气都没了。"},{"op":"background","image":"kuro"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"这要从１０分钟前说起──…。"},{"op":"background","image":"bg021h"},{"op":"bodies","images":[]},{"op":"set","target":["v","z",314],"value":1},{"op":"bodies","images":["cgsh10"]},{"op":"text","speaker":"春原","text":"「冈崎，我们回去吧。」"},{"op":"text","speaker":"朋也","text":"「好啊。」"},{"op":"text","speaker":"","text":"听到春原的话，我拿起书包站了起来。"},{"op":"ifFalse","to":60,"condition":["==",["v","f",17],1]},{"op":"bodies","images":["cgsh12"]},{"op":"text","speaker":"春原","text":"「对了，我来房间一趟。有话对你说。」"},{"op":"text","speaker":"朋也","text":"「我不去。我怕你对我动手动脚的。」"},{"op":"bodies","images":["cgsh21"]},{"op":"text","speaker":"春原","text":"「我才不会对男的动手动脚！」"},{"op":"text","speaker":"朋也","text":"「你这么生气反而很可疑啊。」"},{"op":"bodies","images":["cgsh16"]},{"op":"text","speaker":"春原","text":"「妹妹明天就来了。」"},{"op":"text","speaker":"朋也","text":"「啊。」"},{"op":"text","speaker":"","text":"我忽然想起确实是有这么一件事。"},{"op":"bodies","images":["cgsh20"]},{"op":"text","speaker":"春原","text":"「你知道吗，你脸上写着你忘记了…」"},{"op":"text","speaker":"朋也","text":"「没有啊，我只是不记得了而已。」"},{"op":"bodies","images":["cgsh21"]},{"op":"text","speaker":"春原","text":"「意思一样的好吗！」"},{"op":"text","speaker":"春原","text":"「话说，都这样了你该不会是想跑路吧…」"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"唰啦…。"},{"op":"bodies","images":["cgky12"]},{"op":"text","speaker":"杏","text":"「呀，找到了。」"},{"op":"bodies","images":["cgsh27"]},{"op":"text","speaker":"春原","text":"「呜哇！藤林杏！」"},{"op":"text","speaker":"朋也","text":"「…你来干什么。你妹妹可已经回去了。」"},{"op":"bodies","images":["cgky11"]},{"op":"text","speaker":"杏","text":"「我知道，我在走廊上遇见她了。」"},{"op":"text","speaker":"朋也","text":"「那你来这里干嘛。」"},{"op":"bodies","images":["cgky33"]},{"op":"text","speaker":"杏","text":"「呵呵ー」"},{"op":"text","speaker":"","text":"她用露出富有深意的笑容看着我。"},{"op":"text","speaker":"","text":"从她的表情中，我感到了一丝不安。"},{"op":"text","speaker":"朋也","text":"「春原，我们回去吧。」"},{"op":"bodies","images":["cgsh19"]},{"op":"text","speaker":"春原","text":"「啊？可杏不是找你有事吗？」"},{"op":"text","speaker":"朋也","text":"「她找我会有什么事？」"},{"op":"bodies","images":["cgky12"]},{"op":"text","speaker":"杏","text":"「有大事♪」"},{"op":"text","speaker":"朋也","text":"「我们走吧。」"},{"op":"text","speaker":"杏","text":"「喂你等等啊，我有重要的话要对你说。」"},{"op":"text","speaker":"朋也","text":"「放开我。我没话要和你说。」"},{"op":"bodies","images":["cgky11"]},{"op":"text","speaker":"杏","text":"「可我有！」"},{"op":"bodies","images":["cgsh24"]},{"op":"text","speaker":"春原","text":"「呃…请问，我是不是妨碍到你们了？」"},{"op":"bodies","images":["cgky10"]},{"op":"text","speaker":"杏","text":"「啊，嗯，妨碍大了。」"},{"op":"text","speaker":"杏","text":"「赶紧走人。」"},{"op":"bodies","images":["cgsh16"]},{"op":"text","speaker":"春原","text":"「呃…要是您语气能温和一点就更好了…」"},{"op":"bodies","images":["cgky12"]},{"op":"text","speaker":"杏","text":"「赶紧滚♪」"},{"op":"bodies","images":["cgsh26"]},{"op":"text","speaker":"春原","text":"「这笑容好扎心！」"},{"op":"bodies","images":["cgky12"]},{"op":"text","speaker":"杏","text":"「朋也，你可还不能走啊。」"},{"op":"text","speaker":"朋也","text":"「为什么啊。」"},{"op":"text","speaker":"","text":"当我惊讶的看向杏，她一把把我拉向她"},{"op":"text","speaker":"","text":"仿佛是不愿放我走似的，她紧紧抱住我的手臂。"},{"op":"text","speaker":"","text":"然后在我耳边悄悄的说到。"},{"op":"bodies","images":["cgky11"]},{"op":"text","speaker":"杏","text":"（在校门口等你。）"},{"op":"text","speaker":"朋也","text":"（…谁要等我啊）"},{"op":"text","speaker":"杏","text":"（明知故问。）"},{"op":"text","speaker":"朋也","text":"（………）"},{"op":"bodies","images":["cgky24"]},{"op":"text","speaker":"杏","text":"（撮合你和椋的大作战第２部。）"},{"op":"text","speaker":"","text":"她咧嘴一笑，对我竖起了大拇指。"},{"op":"text","speaker":"朋也","text":"（放开我，我要从后门走。）"},{"op":"bodies","images":["cgky13"]},{"op":"text","speaker":"杏","text":"（不ー可ー以。）"},{"op":"text","speaker":"","text":"说着，我的手臂被她抱得更紧了。"},{"op":"text","speaker":"朋也","text":"（放开。）"},{"op":"text","speaker":"杏","text":"（不放。）"},{"op":"text","speaker":"朋也","text":"（我告诉你，我不去。）"},{"op":"text","speaker":"杏","text":"（你给我去。）"},{"op":"text","speaker":"朋也","text":"（不去。）"},{"op":"text","speaker":"杏","text":"（去。）"},{"op":"text","speaker":"朋也","text":"（………）"},{"op":"text","speaker":"杏","text":"（………）"},{"op":"text","speaker":"","text":"不行…两个人互不相让，这样只会浪费时间…。"},{"op":"text","speaker":"朋也","text":"（…对了杏。）"},{"op":"bodies","images":["cgky11"]},{"op":"text","speaker":"杏","text":"（嗯？想通要去了？）"},{"op":"text","speaker":"朋也","text":"（你那里碰到我了。）"},{"op":"bodies","images":["cgky15"]},{"op":"text","speaker":"杏","text":"（…碰到你了？哪里？）"},{"op":"text","speaker":"朋也","text":"（真软啊。）"},{"op":"bodies","images":["cgky18"]},{"op":"text","speaker":"杏","text":"「………」"},{"op":"bodies","images":["cgky16"]},{"op":"text","speaker":"杏","text":"「！！」"},{"op":"text","speaker":"","text":"哧！地一声，她的脸变得通红。"},{"op":"bodies","images":["cgky20a"]},{"op":"text","speaker":"","text":"她急忙放手，似乎是要遮挡胸脯一般，双手抱在胸前狠狠地盯着我，"},{"op":"text","speaker":"杏","text":"「啊…啊…啊啊～…你这个人！」"},{"op":"text","speaker":"朋也","text":"「慢着！怎么成我的不是了！」"},{"op":"bodies","images":["cgky14a"]},{"op":"text","speaker":"杏","text":"「没怎么！就是看不惯你！」"},{"op":"text","speaker":"朋也","text":"「恼羞成怒啊你！」"},{"op":"text","speaker":"","text":"太不讲道理了。"},{"op":"text","speaker":"","text":"明明是自己把胸压在我手上…当然了，我心里也觉得占了那么几分便宜…。"},{"op":"text","speaker":"","text":"可为什么会变成是我不好了呢！"},{"op":"bodies","images":["cgsh24"]},{"op":"text","speaker":"春原","text":"「那个…如果妨碍到你们了的话，我就先回去了。」"},{"op":"bodies","images":["cgky13a"]},{"op":"text","speaker":"杏","text":"「唉？你怎么还在啊。立马给我走人。」"},{"op":"bodies","images":["cgsh26"]},{"op":"text","speaker":"春原","text":"「您能不能别那么冲…」"},{"op":"bodies","images":["cgky14a"]},{"op":"text","speaker":"杏","text":"「３秒之内你还不消失，我就拔你眉毛拔到我不想拔了为止。」"},{"op":"bodies","images":["cgsh22"]},{"op":"text","speaker":"春原","text":"「是…我马上消失…」"},{"op":"text","speaker":"朋也","text":"「喂，等我啊，我也要回去。」"},{"op":"bodies","images":["cgky13a"]},{"op":"text","speaker":"杏","text":"「我不是说你不能走吗？」"},{"op":"bodies","images":["cgsh20"]},{"op":"ifFalse","to":165,"condition":["==",["v","f",17],1]},{"op":"text","speaker":"春原","text":"「啊，冈崎，我妹的事情就不麻烦你了。」"},{"op":"text","speaker":"春原","text":"「你好像也挺忙的，我自己想想办法就行了。」"},{"op":"bodies","images":["cgsh16"]},{"op":"text","speaker":"春原","text":"「还有，身为朋友劝你一句…，找女人的时候最好甄选一下。」"},{"op":"goto","to":166},{"op":"text","speaker":"春原","text":"「啊，冈崎，身为朋友劝你一句…，找女人的时候最好甄选一下。」"},{"op":"bodies","images":["cgky14"]},{"op":"bodies","images":["cgsh27"]},{"op":"text","speaker":"春原","text":"「难道不是吗？」"},{"op":"text","speaker":"朋也","text":"「你别在这里啰啰嗦嗦的！」"},{"op":"bodies","images":["cgky14"]},{"op":"text","speaker":"杏","text":"「赶紧给我走啦！」"},{"op":"bodies","images":["cgsh27"]},{"op":"text","speaker":"春原","text":"「是，是！」"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"春原如兔子一般从教室跑了出去。"},{"op":"text","speaker":"","text":"我和杏看着他的背影，小叹了一口气。"},{"op":"text","speaker":"朋也","text":"「唉，不该让他先回去的！」"},{"op":"bodies","images":["cgky12"]},{"op":"text","speaker":"杏","text":"「啊哈哈哈哈，完美。这就是你的命啊。」"},{"op":"text","speaker":"朋也","text":"「我要回去。现在追他还来得及。」"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"我把书包夹在腋下，脚下正要踏出第一步。"},{"op":"text","speaker":"","text":"就在这时…。"},{"op":"bodies","images":["cgky31"]},{"op":"text","speaker":"杏","text":"「哼～…到头来还是要找阳平啊～」"},{"op":"text","speaker":"朋也","text":"「…啊？」"},{"op":"text","speaker":"杏","text":"「原来你一个人什么都做不到啊」"},{"op":"text","speaker":"朋也","text":"「你什么意思…？」"},{"op":"set","target":["v","z",323],"value":1},{"op":"bodies","images":["cgky31a"]},{"op":"text","speaker":"杏","text":"「嗯？我意思就是你怂了。」"},{"op":"text","speaker":"朋也","text":"「什么？！」"},{"op":"text","speaker":"杏","text":"「你就是一个连女孩都不敢送的胆小鬼。」"},{"op":"bodies","images":["cgky31b"]},{"op":"text","speaker":"杏","text":"「不过，每个人性格都不同，我觉得这也是没办法的事情…」"},{"op":"bodies","images":["cgky33b"]},{"op":"text","speaker":"杏","text":"「不过你真是比阳平还要废柴啊～」"},{"op":"text","speaker":"","text":"杏故意叹了一口气，抬起双手耸了耸肩，摆出一副没办法的样子。"},{"op":"text","speaker":"","text":"我…我比阳平还要废柴…？"},{"op":"text","speaker":"","text":"我还从没受到过比这句话更具侮辱性的语句。"},{"op":"text","speaker":"朋也","text":"「有种。」"},{"op":"bodies","images":["cgky15a"]},{"op":"text","speaker":"","text":"我缓缓晃动着身体，迈出脚步。"},{"op":"text","speaker":"朋也","text":"「你说她在校门口？」"},{"op":"bodies","images":["cgky12a"]},{"op":"text","speaker":"杏","text":"「嗯，对啊。」"},{"op":"background","image":"kuro"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"然后──…"},{"op":"background","image":"bg018"},{"op":"bodies","images":[]},{"op":"set","target":["v","z",322],"value":1},{"op":"text","speaker":"","text":"一步…一步…一步…一步…。"},{"op":"text","speaker":"朋也","text":"「………」"},{"op":"text","speaker":"","text":"所以才会这样…。"},{"op":"text","speaker":"朋也","text":"「…唉…」"},{"op":"text","speaker":"","text":"被摆了一道…。"},{"op":"text","speaker":"","text":"我直到走出教室才意识到自己中计。"},{"op":"text","speaker":"","text":"步伐特别沉重。"},{"op":"text","speaker":"","text":"还是找个地方等藤林放弃吧…。"},{"op":"text","speaker":"朋也","text":"「………」"},{"op":"choice","id":"3425:2031750","target":["v","f",1089],"items":[{"text":"找个地方消磨时间","value":0,"serial":2031750},{"text":"直接走向校门","value":1,"serial":2031760}]},{"op":"ifFalse","to":332,"condition":["==",["v","f",1089],0]},{"op":"background","image":"kuro"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"………。"},{"op":"text","speaker":"","text":"……。"},{"op":"text","speaker":"","text":"…。"},{"op":"background","image":"bg084"},{"op":"bodies","images":[]},{"op":"set","target":["v","z",316],"value":1},{"op":"set","target":["v","f",1118],"value":4},{"op":"text","speaker":"","text":"耀眼的夕阳…。"},{"op":"background","image":"bg024y"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"我在没有人的中庭溜达了３０多分钟。"},{"op":"text","speaker":"","text":"校园里已经没有了人的气息。"},{"op":"text","speaker":"","text":"只能听到些许教学楼后面传来的操场上参加社团活动的人的声音。"},{"op":"text","speaker":"","text":"说实话真是个大麻烦…。"},{"op":"text","speaker":"","text":"想把我和刚成为同班同学不久的人凑在一起。"},{"op":"text","speaker":"","text":"再说了，一般哪有这样的姐妹。"},{"op":"text","speaker":"","text":"溺爱也要有个限度啊，真是的。"},{"op":"text","speaker":"朋也","text":"「…差不多可以了吧…」"},{"op":"text","speaker":"","text":"看了看周围，我从石墙上起身。"},{"op":"text","speaker":"","text":"就在那一瞬间──…！"},{"op":"text","speaker":"","text":"叮！！"},{"op":"text","speaker":"","text":"我的耳旁飞过一样热呼呼的东西，石墙的一部分变得粉碎。"},{"op":"text","speaker":"朋也","text":"「…啊…？」"},{"op":"text","speaker":"","text":"唰…几根发丝飞舞在空中。"},{"op":"text","speaker":"","text":"回头一看，嵌入在石墙中的…是一本汉语词典…。"},{"op":"text","speaker":"","text":"难…难道说…。"},{"op":"set","target":["v","z",323],"value":1},{"op":"text","speaker":"杏","text":"「朋也～…」"},{"op":"text","speaker":"","text":"不，不敢回头…。"},{"op":"text","speaker":"","text":"我的全身被一股危险的气息笼罩，让我不得动弹…。"},{"op":"text","speaker":"","text":"这…就是恐怖吗…？？"},{"op":"text","speaker":"","text":"我感觉背后的空气在晃动。"},{"op":"text","speaker":"","text":"一只手，搭上了我的右肩。"},{"op":"text","speaker":"","text":"从本应感受到温暖的那一部位，我却感到了一股贯穿全身的寒意。"},{"op":"text","speaker":"杏","text":"「胆～子不小啊～…敢放鸽子了啊？嗯？」"},{"op":"text","speaker":"朋也","text":"「不…不是…这个…杏…小姐？」"},{"op":"text","speaker":"","text":"抓在我肩膀上的手越来越紧，手指慢慢陷入肉里…。"},{"op":"text","speaker":"杏","text":"「还是说你写好遗书了呢～？」"},{"op":"text","speaker":"杏","text":"「给我看看，我会在你面前读完然后一把火烧掉的。拿出来啊？」"},{"op":"text","speaker":"朋也","text":"「我…不…啊──，我！」"},{"op":"text","speaker":"","text":"我甩开搭在我肩上的手，重新看向了杏。"},{"op":"bodies","images":["cgky32"]},{"op":"text","speaker":"","text":"隆隆隆隆隆隆隆！！"},{"op":"text","speaker":"朋也","text":"「呃！」"},{"op":"text","speaker":"","text":"转头的瞬间，我差点被吓得没了呼吸。"},{"op":"text","speaker":"","text":"她把手重重地搭在了我的两肩。"},{"op":"text","speaker":"","text":"杏愤怒的脸几乎要碰到了我鼻尖。"},{"op":"text","speaker":"","text":"在外人看来，或许是杏在勾引我，或追求我，但那是因为他们没有看见杏的表情。"},{"op":"bodies","images":["cgky14"]},{"op":"text","speaker":"杏","text":"「你知不知道！椋是以什么样的心情在那等你的！」"},{"op":"text","speaker":"朋也","text":"「………」"},{"op":"text","speaker":"杏","text":"「她都快哭了你知不知道！」"},{"op":"text","speaker":"朋也","text":"「你等等…你的意思是说我不好了？」"},{"op":"text","speaker":"杏","text":"「是啊！」"},{"op":"text","speaker":"朋也","text":"「你发什么疯！」"},{"op":"bodies","images":["cgky20"]},{"op":"text","speaker":"杏","text":"「什…！」"},{"op":"text","speaker":"","text":"她的脸上因愤怒涨地血红。"},{"op":"text","speaker":"朋也","text":"「这还不是因为你瞎操心惹出来的。」"},{"op":"text","speaker":"杏","text":"「什么叫瞎操心！我是为了她才──」"},{"op":"text","speaker":"朋也","text":"「藤林她拜托过你吗？」"},{"op":"bodies","images":["cgky16a"]},{"op":"text","speaker":"杏","text":"「啊？没，没有啊怎么了…」"},{"op":"text","speaker":"朋也","text":"「还有，我的意见你有问过吗？」"},{"op":"bodies","images":["cgky18a"]},{"op":"text","speaker":"杏","text":"「这…不需要。」"},{"op":"text","speaker":"朋也","text":"「那意思是，我随便和你妹妹聊几句然后就和她交往也没问题是吧？」"},{"op":"bodies","images":["cgky14a"]},{"op":"text","speaker":"杏","text":"「那怎么可以！你要用心对待她！」"},{"op":"bodies","images":["cgky13a"]},{"op":"text","speaker":"朋也","text":"「可你恰恰就是在逼我那么做。」"},{"op":"text","speaker":"朋也","text":"「把我的意愿弃置一旁，不就是这个意思吗？」"},{"op":"text","speaker":"朋也","text":"「和一个不喜欢的人在一起，怎么可能会发展的下去。」"},{"op":"bodies","images":["cgky14a"]},{"op":"text","speaker":"杏","text":"「那你也不用放鸽子吧！」"},{"op":"bodies","images":["cgky13a"]},{"op":"text","speaker":"朋也","text":"「这你说的也是…」"},{"op":"text","speaker":"朋也","text":"「不管怎么样，你就是爱瞎操心。」"},{"op":"text","speaker":"朋也","text":"「连对方是个什么人都都不清楚，怎么能一起回去，一起去吃饭呢？」"},{"op":"text","speaker":"朋也","text":"「就算聊天也没话题，剩下的只会是尴尬。」"},{"op":"text","speaker":"朋也","text":"「要真的那么做了，我和她的关系反而会越来越远。」"},{"op":"bodies","images":["cgky13"]},{"op":"text","speaker":"杏","text":"「………」"},{"op":"text","speaker":"","text":"杏一脸不满地后退了。"},{"op":"set","target":["v","z",315],"value":1},{"op":"text","speaker":"杏","text":"「…干嘛啊…说得那么冠冕堂皇的…」"},{"op":"text","speaker":"朋也","text":"「但我没说错啊，不是吗？」"},{"op":"bodies","images":["cgky18"]},{"op":"text","speaker":"杏","text":"「………」"},{"op":"text","speaker":"","text":"杏还是一脸愤然，却点了点头。"},{"op":"text","speaker":"朋也","text":"「那我就回去啦。」"},{"op":"text","speaker":"杏","text":"「………」"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"我叹着气，从杏的身旁走过。"},{"op":"text","speaker":"杏","text":"「…朋也。」"},{"op":"text","speaker":"朋也","text":"「…干嘛，还有什么事吗？」"},{"op":"bodies","images":["cgky22a"]},{"op":"text","speaker":"","text":"我转头看向身旁的杏。"},{"op":"text","speaker":"杏","text":"「你，有喜欢的女孩子吗？」"},{"op":"text","speaker":"朋也","text":"「不知道啊。现在大概还没有吧。」"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"我耸了耸肩回答她。"},{"op":"set","target":["v","f",1118],"value":0},{"op":"set","target":["v","f",307],"value":1},{"op":"set","target":["v","f",314],"value":1},{"op":"jumpScene","scene":444,"entry":0},{"op":"text","speaker":"","text":"…走吧…。"},{"op":"background","image":"bg015y"},{"op":"bodies","images":[]},{"op":"set","target":["v","f",1118],"value":3},{"op":"set","target":["v","z",316],"value":1},{"op":"text","speaker":"","text":"斜阳染红了风景。"},{"op":"text","speaker":"","text":"地上的影子拖得长长的。"},{"op":"text","speaker":"","text":"长长的影子直射到我脚边，而人却远远地…。"},{"op":"text","speaker":"","text":"在荡漾着浓浓哀愁的景象中──…。"},{"op":"text","speaker":"","text":"她就站在那里。"},{"op":"text","speaker":"","text":"背靠着校门的墙，双手抱住书包，静静地低头看着地面。"},{"op":"text","speaker":"朋也","text":"「………」"},{"op":"text","speaker":"","text":"该不会是像昨天午饭时一样，变成我让她来的吧？"},{"op":"text","speaker":"","text":"我调整了拿包的姿势，心里做好觉悟，向校门走去。"},{"op":"bodies","images":["cgry19"]},{"op":"text","speaker":"椋","text":"「…啊…」"},{"op":"text","speaker":"","text":"藤林发现了我，抬起头。"},{"op":"text","speaker":"","text":"脸上染着一层不同于夕阳的红色。"},{"op":"text","speaker":"朋也","text":"「抱歉，等很久了吧。」"},{"op":"bodies","images":["cgry21"]},{"op":"text","speaker":"椋","text":"「没，没有等很久。」"},{"op":"text","speaker":"椋","text":"「我也才刚到。」"},{"op":"text","speaker":"","text":"骗人…。"},{"op":"text","speaker":"","text":"你分明比我早出教室很久好吗…。"},{"op":"bodies","images":["cgry22"]},{"op":"text","speaker":"椋","text":"「啊…那个…」"},{"op":"text","speaker":"","text":"藤林扭扭捏捏的，眼神也游走不定。"},{"op":"text","speaker":"","text":"似乎是要说些什么，但又害羞地说不出话来。"},{"op":"text","speaker":"朋也","text":"「总之，我们先回去吧。」"},{"op":"bodies","images":["cgry19"]},{"op":"text","speaker":"椋","text":"「好，好！」"},{"op":"bodies","images":[]},{"op":"background","image":"bg034y"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"在夕阳下变成了深紫色的沥青路。"},{"op":"text","speaker":"","text":"这个季节日落后依旧寒冷。"},{"op":"text","speaker":"","text":"吹来的风带着一丝凉意预告着夜晚的到来。"},{"op":"text","speaker":"","text":"两条影子均速地向前移动。"},{"op":"text","speaker":"","text":"一条是我，一条是藤林…。"},{"op":"text","speaker":"","text":"我们都…沉默着。"},{"op":"text","speaker":"","text":"我脸朝前，眼睛瞄向走在身边的人。"},{"op":"text","speaker":"","text":"藤林的脸还是红红一片，低着头走路。"},{"op":"text","speaker":"","text":"我想，如果我不开口，这种僵持只怕会一直持续到我们分开。"},{"op":"text","speaker":"","text":"气氛闷得让人难受。"},{"op":"text","speaker":"","text":"我先试着聊一聊她擅长的吧。"},{"op":"text","speaker":"朋也","text":"「我说藤林。」"},{"op":"bodies","images":["cgry20"]},{"op":"text","speaker":"椋","text":"「嗯，在。」"},{"op":"text","speaker":"","text":"藤林一个猛回头，看得我都担心她会不会伤到脖子。"},{"op":"text","speaker":"","text":"脸上的红晕似乎又深了几分。"},{"op":"text","speaker":"朋也","text":"「我记得你，好像很喜欢占卜对吧。」"},{"op":"bodies","images":["cgry19"]},{"op":"text","speaker":"椋","text":"「啊？是的。」"},{"op":"text","speaker":"朋也","text":"「怎么会喜欢占卜的？」"},{"op":"bodies","images":["cgry21"]},{"op":"text","speaker":"椋","text":"「怎么会…其实…我…」"},{"op":"text","speaker":"朋也","text":"「是有什么特别的原因吗？」"},{"op":"bodies","images":["cgry22"]},{"op":"text","speaker":"椋","text":"「不，不是这样的…」"},{"op":"bodies","images":["cgry22a"]},{"op":"text","speaker":"椋","text":"「其实…」"},{"op":"bodies","images":["cgry19a"]},{"op":"text","speaker":"椋","text":"「因为，我是女生…」"},{"op":"text","speaker":"","text":"她似乎是探视着我的表情般看着我回答道。"},{"op":"text","speaker":"","text":"…这…算哪门子的回答？"},{"op":"bodies","images":["cgry21a"]},{"op":"text","speaker":"椋","text":"「每个女生都是生来就喜欢占卜的。」"},{"op":"text","speaker":"","text":"而且还说得那么肯定…。"},{"op":"text","speaker":"朋也","text":"「但那是让别人给自己占卜吧？」"},{"op":"bodies","images":["cgry19a"]},{"op":"text","speaker":"椋","text":"「…？」"},{"op":"text","speaker":"朋也","text":"「我想应该没多少人会自己去占卜吧。」"},{"op":"bodies","images":["cgry19"]},{"op":"text","speaker":"椋","text":"「是，是这样的吗…？」"},{"op":"text","speaker":"朋也","text":"「至今为止，在我们学校我还没见到过除你以外会自己占卜的人。」"},{"op":"bodies","images":["cgry21"]},{"op":"text","speaker":"椋","text":"「…呃…可自己占卜也是很有趣的。」"},{"op":"text","speaker":"椋","text":"「明明是别人的事，却会像自己的事一样激动的。」"},{"op":"text","speaker":"朋也","text":"「也是，毕竟每个人的玩法都不一样。」"},{"op":"bodies","images":["cgry19"]},{"op":"text","speaker":"椋","text":"「啊…」"},{"op":"text","speaker":"","text":"藤林轻叫了一声，似乎想到了什么。"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"然后从上衣的口袋里，取出她常用的扑克牌。"},{"op":"bodies","images":["cgry11"]},{"op":"text","speaker":"椋","text":"「那，那个，冈崎君你有没有想要占卜的事情？」"},{"op":"text","speaker":"朋也","text":"「那…就今天的晚饭吧。」"},{"op":"bodies","images":["cgry12"]},{"op":"text","speaker":"椋","text":"「好的！」"},{"op":"text","speaker":"","text":"她微笑着点了点头，开始洗牌。"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"占卜时的藤林看上去真的是很快活啊…。"},{"op":"text","speaker":"","text":"不过…扑克牌要怎么占卜晚饭啊？"},{"op":"text","speaker":"","text":"藤林浑然不知我的担心，自己轻轻地抽出了两张牌。"},{"op":"text","speaker":"","text":"这…不应该是我来抽的吗。"},{"op":"bodies","images":["cgry18a"]},{"op":"text","speaker":"椋","text":"「呃…冈崎君今天的晚饭是…」"},{"op":"bodies","images":["cgry12a"]},{"op":"text","speaker":"椋","text":"「哇，好棒啊。是吃全套法式大餐呢。」"},{"op":"text","speaker":"","text":"错的太离谱了…。"},{"op":"text","speaker":"朋也","text":"「我能问一下吗…？」"},{"op":"bodies","images":["cgry15a"]},{"op":"text","speaker":"椋","text":"「什么？」"},{"op":"text","speaker":"朋也","text":"「扑克牌是怎么占卜出我晚饭吃法式大餐的。」"},{"op":"bodies","images":["cgry18"]},{"op":"text","speaker":"椋","text":"「嗯…是这两张牌…」"},{"op":"text","speaker":"","text":"两张牌被她纤细的手指捏住。"},{"op":"text","speaker":"","text":"一张是红心A，另一张是黑桃K…。"},{"op":"bodies","images":["cgry15"]},{"op":"text","speaker":"椋","text":"「A和K分别代表开始和结束，也就是代表了全部。」"},{"op":"text","speaker":"","text":"所以你才会觉得是全套大餐吗…。"},{"op":"text","speaker":"椋","text":"「而这张黑桃K…」"},{"op":"bodies","images":["cgry11"]},{"op":"text","speaker":"椋","text":"「他的胡子很像皮埃尔先生。」"},{"op":"text","speaker":"","text":"…那是谁啊？"},{"op":"bodies","images":["cgry12"]},{"op":"text","speaker":"椋","text":"「不觉得就和法国的绅士一样吗？」"},{"op":"text","speaker":"朋也","text":"「呃…你问我我也不知道啊…」"},{"op":"text","speaker":"","text":"我还没见到过有这样粗糙胡子的K呢…。"},{"op":"text","speaker":"朋也","text":"「不过…按你的占卜结果来说，我今天的晚饭会很豪华是吧。」"},{"op":"bodies","images":["cgry11"]},{"op":"text","speaker":"椋","text":"「是的。」"},{"op":"text","speaker":"朋也","text":"「这样啊…」"},{"op":"text","speaker":"","text":"那就是说，应该会是一顿寒酸的晚饭了吧。"},{"op":"text","speaker":"","text":"不，搞不好连晚饭都没有…。"},{"op":"bodies","images":["cgry19"]},{"op":"text","speaker":"椋","text":"「那…那个…」"},{"op":"text","speaker":"朋也","text":"「嗯？怎么了？」"},{"op":"bodies","images":["cgry22"]},{"op":"text","speaker":"椋","text":"「我也能问你一个问题吗…？」"},{"op":"text","speaker":"","text":"不知道是不是问题很难问出口，藤林低头看着地面这样说到。"},{"op":"text","speaker":"朋也","text":"「可以啊，问吧。」"},{"op":"bodies","images":["cgry19"]},{"op":"text","speaker":"椋","text":"「嗯，好…」"},{"op":"text","speaker":"","text":"她缩着肩，低着头偷偷地看着我。"},{"op":"text","speaker":"椋","text":"「那…那个…」"},{"op":"text","speaker":"椋","text":"「我…该怎么说…」"},{"op":"bodies","images":["cgry22"]},{"op":"text","speaker":"椋","text":"「………」"},{"op":"text","speaker":"朋也","text":"「说啊。你不是有事情要问我吗？」"},{"op":"bodies","images":["cgry14"]},{"op":"text","speaker":"椋","text":"「啊，对，对不起…」"},{"op":"text","speaker":"","text":"她吓得更是缩起身子，向我道歉。"},{"op":"text","speaker":"朋也","text":"「你到底要问什么？」"},{"op":"bodies","images":["cgry22"]},{"op":"text","speaker":"椋","text":"「那…那个…这算…那个…」"},{"op":"text","speaker":"椋","text":"「约…约…」"},{"op":"text","speaker":"朋也","text":"「约…？」"},{"op":"bodies","images":["cgry19"]},{"op":"text","speaker":"椋","text":"「这算是约会…吗？」"},{"op":"text","speaker":"朋也","text":"「………？」"},{"op":"text","speaker":"","text":"约会？"},{"op":"text","speaker":"","text":"一起回去这么点事就是约会？"},{"op":"bodies","images":["cgry20"]},{"op":"text","speaker":"椋","text":"「啊…我…那个…」"},{"op":"text","speaker":"椋","text":"「我姐姐告诉我，放学一起回去就和约会差不多…」"},{"op":"text","speaker":"椋","text":"「如果不是对你有意思，是不会和你一起回去的…」"},{"op":"bodies","images":["cgry22"]},{"op":"text","speaker":"椋","text":"「所以…我…可是…」"},{"op":"bodies","images":["cgry22a"]},{"op":"text","speaker":"","text":"她似乎也不知道自己在说什么，眼神左右摇摆不定。"},{"op":"text","speaker":"","text":"随后…。"},{"op":"bodies","images":["cgry21"]},{"op":"text","speaker":"椋","text":"「…真的对不起…给你添麻烦了…」"},{"op":"text","speaker":"","text":"最终她说出了这样一句话。"},{"op":"bodies","images":["cgry19"]},{"op":"text","speaker":"椋","text":"「我…这是第一次…所以也不知道该说什么好…」"},{"op":"bodies","images":["cgry22"]},{"op":"text","speaker":"椋","text":"「但是冈崎君你能邀请我…我…真的很开心…」"},{"op":"text","speaker":"椋","text":"「………」"},{"op":"bodies","images":["cgry21"]},{"op":"text","speaker":"椋","text":"「可…还是很无聊吧…和我这种人一起回去…」"},{"op":"text","speaker":"椋","text":"「真的…对不起…」"},{"op":"text","speaker":"朋也","text":"「…我说…」"},{"op":"text","speaker":"","text":"我挠了挠头叹了一口气。"},{"op":"text","speaker":"朋也","text":"「…你有什么想去地方吗？」"},{"op":"bodies","images":["cgry19"]},{"op":"text","speaker":"椋","text":"「…啊？」"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"不等迷惑的藤林，我迈出脚步。"},{"op":"text","speaker":"","text":"稍晚，后方传来了脚步声。"},{"op":"text","speaker":"","text":"过了一会，藤林追上了我。"},{"op":"bodies","images":["cgry19"]},{"op":"text","speaker":"朋也","text":"「我说啊…或许我不应该这么说，但你姐姐很受人欢迎对吧？」"},{"op":"text","speaker":"椋","text":"「啊？啊，是…是的…」"},{"op":"text","speaker":"朋也","text":"「你们是双胞胎，长得也一样。你不觉得自己有潜力能成为你姐姐一样的人吗？」"},{"op":"bodies","images":["cgry22"]},{"op":"text","speaker":"椋","text":"「是…是吗…？」"},{"op":"text","speaker":"朋也","text":"「嗯，我这想法是有些肤浅。」"},{"op":"text","speaker":"朋也","text":"「但重要的还是心态对吧。」"},{"op":"text","speaker":"朋也","text":"「就像刚才一样，如果什么事都往坏的方面去想，我觉得是不好的。」"},{"op":"bodies","images":["cgry23"]},{"op":"text","speaker":"椋","text":"「啊…对…对不起…」"},{"op":"text","speaker":"朋也","text":"「像这样总是道歉也不太好吧？」"},{"op":"bodies","images":["cgry14"]},{"op":"text","speaker":"椋","text":"「对…对不…」"},{"op":"text","speaker":"","text":"她再一次想要道歉，又急忙捂住了嘴巴。"},{"op":"text","speaker":"","text":"看着她紧张的眼神，我不禁笑了出来。"},{"op":"text","speaker":"朋也","text":"「你不妨可以往好的方面想一想。」"},{"op":"bodies","images":["cgry15"]},{"op":"text","speaker":"椋","text":"「好的…方面？」"},{"op":"text","speaker":"朋也","text":"「对啊，消极的性格是天生的没办法。但思考方式是可以改变的。」"},{"op":"bodies","images":["cgry18"]},{"op":"text","speaker":"椋","text":"「嗯…」"},{"op":"bodies","images":["cgry15"]},{"op":"text","speaker":"朋也","text":"「你看，我现在和你一起回去。」"},{"op":"text","speaker":"朋也","text":"「如果我真的讨厌你，就不会和你走在一起。这点自信你总该能有吧？」"},{"op":"bodies","images":["cgry19"]},{"op":"text","speaker":"","text":"是的…。"},{"op":"text","speaker":"","text":"是杏让我和藤林一起回去的。可最终选择的还是我。"},{"op":"text","speaker":"","text":"杏并没有逼迫我。"},{"op":"text","speaker":"","text":"所以我其实是能拒绝的。"},{"op":"bodies","images":["cgry22"]},{"op":"text","speaker":"椋","text":"「自信…」"},{"op":"text","speaker":"椋","text":"「………」"},{"op":"bodies","images":["cgry21"]},{"op":"text","speaker":"椋","text":"「…好的…」"},{"op":"text","speaker":"椋","text":"「虽然我不知道能不能做好…可…」"},{"op":"text","speaker":"椋","text":"「既然冈崎君说了…那我…就努力一下。」"},{"op":"text","speaker":"朋也","text":"「嗯。」"},{"op":"text","speaker":"朋也","text":"「那你怎么想的呢？」"},{"op":"bodies","images":["cgry19"]},{"op":"text","speaker":"椋","text":"「啊？」"},{"op":"text","speaker":"朋也","text":"「你想去的地方。有吗？」"},{"op":"bodies","images":["cgry22"]},{"op":"text","speaker":"椋","text":"「啊…呃…那…那个…」"},{"op":"text","speaker":"","text":"她又再次缩起肩膀，低头看着地面。"},{"op":"text","speaker":"朋也","text":"「你不才说要努力吗？」"},{"op":"bodies","images":["cgry20"]},{"op":"text","speaker":"椋","text":"「啊…哇哇…呃…」"},{"op":"bodies","images":["cgry22"]},{"op":"text","speaker":"椋","text":"「………」"},{"op":"text","speaker":"朋也","text":"「哪里都可以的。」"},{"op":"bodies","images":["cgry19"]},{"op":"text","speaker":"椋","text":"「那…那…那就…」"},{"op":"background","image":"bg035y"},{"op":"bodies","images":[]},{"op":"set","target":["v","z",317],"value":1},{"op":"text","speaker":"","text":"四周传来的打击声和喊叫声，惨叫声…。"},{"op":"text","speaker":"","text":"这里是吵闹的电音世界。"},{"op":"text","speaker":"","text":"游戏厅…。"},{"op":"text","speaker":"","text":"我们两个站在一个被塑料帘子围着的机器前。"},{"op":"text","speaker":"朋也","text":"「…大头贴？」"},{"op":"bodies","images":["cgry12"]},{"op":"text","speaker":"椋","text":"「这，这是叫天宫图的一种占卜。」"},{"op":"text","speaker":"朋也","text":"「天…什么？」"},{"op":"bodies","images":["cgry11"]},{"op":"text","speaker":"椋","text":"「天宫图。」"},{"op":"text","speaker":"椋","text":"「简单地说…就是…这张天体配置图。」"},{"op":"text","speaker":"朋也","text":"「我不懂啊…」"},{"op":"bodies","images":["cgry14"]},{"op":"text","speaker":"椋","text":"「啊…对…对不起…」"},{"op":"bodies","images":["cgry15"]},{"op":"text","speaker":"椋","text":"「天体配置图…就是截取某一个时间点上的天体的位置，把他们图样化出来的东西。」"},{"op":"text","speaker":"椋","text":"「然后根据这个，计算天体的位置关系，占卜人的运势和前景。」"},{"op":"bodies","images":["cgry11"]},{"op":"text","speaker":"椋","text":"「某个时间点其实有很多。但占卜通常都会用人出生时的天体配置图。」"},{"op":"text","speaker":"朋也","text":"「呃…我还是不明白…」"},{"op":"bodies","images":["cgry14a"]},{"op":"text","speaker":"椋","text":"「那…呜…呃…那个…」"},{"op":"text","speaker":"朋也","text":"「再说的简单一点。」"},{"op":"bodies","images":["cgry21a"]},{"op":"text","speaker":"椋","text":"「就是占星术。」"},{"op":"text","speaker":"","text":"一开始这样说不就好了…。"},{"op":"text","speaker":"朋也","text":"「那你是想玩那个吗」"},{"op":"bodies","images":["cgry22a"]},{"op":"text","speaker":"椋","text":"「啊…我…」"},{"op":"text","speaker":"","text":"她的眼睛看着我的表情，带着些羞涩。"},{"op":"text","speaker":"","text":"可她的意识在已经飞到那个占卜的机器上，时不时的向那边瞄一眼。"},{"op":"text","speaker":"","text":"其实她是在顾虑我而已吧。"},{"op":"text","speaker":"朋也","text":"「唉…」"},{"op":"text","speaker":"","text":"我叹了一口气，抬腿往前走。"},{"op":"bodies","images":["cgry14"]},{"op":"text","speaker":"椋","text":"「啊…」"},{"op":"text","speaker":"","text":"耳中传来一声短暂的哀声。"},{"op":"text","speaker":"朋也","text":"「…干什么呢？」"},{"op":"bodies","images":["cgry19"]},{"op":"text","speaker":"椋","text":"「啊？」"},{"op":"text","speaker":"朋也","text":"「你不是要玩这个吗？占星术。」"},{"op":"bodies","images":["cgry20"]},{"op":"text","speaker":"椋","text":"「啊…」"},{"op":"text","speaker":"","text":"这次的声音和刚才不同。"},{"op":"text","speaker":"","text":"藤林小跑着跟在我后面。"},{"op":"background","image":"kuro"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"撩起塑料帘子，站到机器前。"},{"op":"text","speaker":"","text":"外面的光被帘子遮挡，屏幕上发出的青白色光芒，把这里营造成了一片神秘的空间。"},{"op":"text","speaker":"","text":"音量不大的背景音乐…。"},{"op":"text","speaker":"","text":"屏幕中以地球为首的太阳系星体，围绕着太阳不停的转动。"},{"op":"background","image":"fgky02j"},{"op":"bodies","images":[]},{"op":"text","speaker":"朋也","text":"「做的还真逼真啊。」"},{"op":"text","speaker":"椋","text":"「嗯…」"},{"op":"text","speaker":"朋也","text":"「这个灵不灵啊？」"},{"op":"text","speaker":"椋","text":"「我也不知道…？我是第一次玩这个…」"},{"op":"text","speaker":"朋也","text":"「这样呀。呃…两个人一起的话是３００日元…」"},{"op":"text","speaker":"椋","text":"「啊，好的。」"},{"op":"text","speaker":"朋也","text":"「不用了。我请你。」"},{"op":"text","speaker":"","text":"我叫住想要拿出钱包的藤林，然后从口袋里掏出了硬币。"},{"op":"text","speaker":"","text":"叮叮…叮…。"},{"op":"text","speaker":"","text":"叮呤～"},{"op":"text","speaker":"","text":"投完币后，屏幕里的星体，就像被太阳吸住了一样，聚集在屏幕当中。"},{"op":"text","speaker":"","text":"然后按下开始按钮。"},{"op":"text","speaker":"","text":"屏幕渐渐转白，显示出了输入名字的画面。"},{"op":"text","speaker":"朋也","text":"「…怎么输入啊？」"},{"op":"background","image":"fgky02l"},{"op":"set","target":["v","a",500],"value":0},{"op":"bodies","images":[]},{"op":"text","speaker":"椋","text":"「应该…是用这个水晶球输入的。」"},{"op":"text","speaker":"朋也","text":"「这个啊？」"},{"op":"text","speaker":"","text":"机器的正当中，有一个假的水晶球。"},{"op":"text","speaker":"","text":"转动水晶球，就能够输入姓名。"},{"op":"text","speaker":"","text":"羽毛模样的光标，配合着水晶球的转动而移动。"},{"op":"background","image":"fgky02j"},{"op":"set","target":["v","a",500],"value":0},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"转啊转啊转啊…叮。"},{"op":"text","speaker":"","text":"转啊转啊…叮。"},{"op":"text","speaker":"","text":"转啊转啊转啊转啊…叮。"},{"op":"text","speaker":"","text":"输入完姓名，接着是选择性别的画面。"},{"op":"text","speaker":"","text":"画面上漂浮着『♂』和『♀』两种记号。"},{"op":"text","speaker":"","text":"这个就没有什么好犹豫的了。"},{"op":"text","speaker":"","text":"把箭头移动到『♂』，决定。"},{"op":"text","speaker":"","text":"接着是输入生日和出生时间。"},{"op":"text","speaker":"","text":"话说…我可不知道我具体的出生时间啊…？"},{"op":"background","image":"fgky02l"},{"op":"set","target":["v","a",500],"value":0},{"op":"bodies","images":[]},{"op":"text","speaker":"椋","text":"「我想，大致的时间…应该…就可以了。」"},{"op":"text","speaker":"朋也","text":"「你说得对。」"},{"op":"text","speaker":"","text":"那就随便写个…嗯，就填AM９：００吧。"},{"op":"background","image":"fgky02j"},{"op":"set","target":["v","a",500],"value":0},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"叮。"},{"op":"text","speaker":"","text":"接着显示的是一张日本地图。"},{"op":"text","speaker":"朋也","text":"「…要选出生地点？」"},{"op":"text","speaker":"","text":"左上角会显示出箭头点到的地方的经纬度。"},{"op":"background","image":"fgky02l"},{"op":"set","target":["v","a",500],"value":0},{"op":"bodies","images":[]},{"op":"text","speaker":"椋","text":"「这个也是大致就可以了。」"},{"op":"text","speaker":"朋也","text":"「噢。」"},{"op":"background","image":"fgky02j"},{"op":"set","target":["v","a",500],"value":0},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"我应该是这里出生的，那就差不多是这里一带吧。"},{"op":"text","speaker":"","text":"…如果是生在外国的人该怎么办呢…。"},{"op":"text","speaker":"","text":"叮呤～"},{"op":"text","speaker":"","text":"屏幕上白色的光一闪而过，又一次回到输入姓名的画面。"},{"op":"text","speaker":"朋也","text":"「好了，该你了。」"},{"op":"background","image":"fgky02k"},{"op":"set","target":["v","a",500],"value":0},{"op":"bodies","images":[]},{"op":"text","speaker":"椋","text":"「好，好的。」"},{"op":"text","speaker":"","text":"藤林慌慌张张地把手放在水晶球上"},{"op":"text","speaker":"椋","text":"「呃…这个…」"},{"op":"text","speaker":"","text":"转啊…转…转…转啊…叮。"},{"op":"text","speaker":"椋","text":"「啊…哇哇…」"},{"op":"text","speaker":"","text":"转啊…转啊…转啊转…转啊…叮。"},{"op":"text","speaker":"椋","text":"「哇…咦…？哎呀…哇…」"},{"op":"text","speaker":"","text":"她笨拙地操控着光标，输入自己的姓名。"},{"op":"text","speaker":"","text":"不知道光错过了多少次自己的名字，花了将近我两倍的时间，才终于输好『椋』。"},{"op":"text","speaker":"","text":"接着是选『♂』与『♀』。"},{"op":"text","speaker":"椋","text":"「………」"},{"op":"text","speaker":"朋也","text":"「…？怎么了？」"},{"op":"background","image":"fgky02j"},{"op":"set","target":["v","a",500],"value":0},{"op":"bodies","images":[]},{"op":"text","speaker":"椋","text":"「啊…？呃…没，没事。」"},{"op":"text","speaker":"","text":"说着她移动起水晶球。"},{"op":"text","speaker":"","text":"箭头一摇一晃地移向『♂』。"},{"op":"text","speaker":"朋也","text":"「…原来你是男的啊？」"},{"op":"background","image":"fgky02l"},{"op":"set","target":["v","a",500],"value":0},{"op":"bodies","images":[]},{"op":"text","speaker":"椋","text":"「啊？」"},{"op":"text","speaker":"朋也","text":"「那个记号是男的意思。」"},{"op":"background","image":"fgky02j"},{"op":"set","target":["v","a",500],"value":0},{"op":"bodies","images":[]},{"op":"text","speaker":"椋","text":"「啊…不是不是，我是女的。」"},{"op":"text","speaker":"朋也","text":"「你该不会是…不知道这两个记号的意思吧？」"},{"op":"text","speaker":"椋","text":"「那个…我有时候会弄错。」"},{"op":"text","speaker":"椋","text":"「因为…它们长得很像。」"},{"op":"text","speaker":"","text":"…像吗？"},{"op":"text","speaker":"","text":"话说，你刚才没看到我选『♂』吗？"},{"op":"text","speaker":"朋也","text":"「你听好。男性的记号上不是有个像箭头一样的突起吗？」"},{"op":"text","speaker":"椋","text":"「啊，是的，有的。」"},{"op":"text","speaker":"朋也","text":"「其实那就是代表了箭头。」"},{"op":"text","speaker":"椋","text":"「箭头…吗？」"},{"op":"text","speaker":"朋也","text":"「也就是通过狩猎来代表男性。」"},{"op":"text","speaker":"椋","text":"「啊…原来是这样…」"},{"op":"text","speaker":"朋也","text":"「这样就容易记了吧？」"},{"op":"background","image":"fgky02l"},{"op":"set","target":["v","a",500],"value":0},{"op":"bodies","images":[]},{"op":"text","speaker":"椋","text":"「嗯，容易记了很多。」"},{"op":"text","speaker":"朋也","text":"「那你选哪个？要是选男的，我可就不知道该怎么好了。」"},{"op":"background","image":"fgky02j"},{"op":"set","target":["v","a",500],"value":0},{"op":"bodies","images":[]},{"op":"text","speaker":"椋","text":"「呃…我是，这边。」"},{"op":"text","speaker":"","text":"藤林急忙转动水晶球，把箭头移到『♀』处。"},{"op":"background","image":"fgky02k"},{"op":"set","target":["v","a",500],"value":0},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"接下来是输入生日和出生时间。"},{"op":"text","speaker":"","text":"她还是摇摇晃晃地输入着每一个字。"},{"op":"text","speaker":"朋也","text":"「哦…９月９号啊。」"},{"op":"text","speaker":"椋","text":"「嗯，是的。」"},{"op":"text","speaker":"","text":"藤林点了点头，输入了出生时间。"},{"op":"text","speaker":"","text":"尽管箭头一摇一晃，但目标却很明确。"},{"op":"text","speaker":"朋也","text":"「你…怎么知道自己的出生时间的？」"},{"op":"background","image":"fgky02l"},{"op":"set","target":["v","a",500],"value":0},{"op":"bodies","images":[]},{"op":"text","speaker":"椋","text":"「啊…？啊…是的…我是听妈妈说的…」"},{"op":"text","speaker":"朋也","text":"「为什么会去问…」"},{"op":"text","speaker":"椋","text":"「那个…我觉得占卜…应该会要…所以…」"},{"op":"text","speaker":"朋也","text":"「那你自己也会像这样占卜的吗？」"},{"op":"text","speaker":"椋","text":"「啊。是的…有时候会…」"},{"op":"text","speaker":"朋也","text":"「这样啊…」"},{"op":"text","speaker":"","text":"本想对她说…经常不中吧。但又生生的把这句话咽了下去。"},{"op":"text","speaker":"","text":"她占卜是因为喜欢。所以对这样的她说那种话，实在是太残酷了。"},{"op":"background","image":"fgky02k"},{"op":"set","target":["v","a",500],"value":0},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"过了一会，藤林输入完了出生地点。"},{"op":"background","image":"fgky02j"},{"op":"set","target":["v","a",500],"value":0},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"叮呤～"},{"op":"text","speaker":"","text":"屏幕又闪过一道白光，进入了下一画面。"},{"op":"text","speaker":"","text":"画面背景是漫天星的夜空，上面显示着一些文字──这是占卜的菜单。"},{"op":"text","speaker":"","text":"画面中有一些选项。"},{"op":"text","speaker":"","text":"第一个要选的就是。"},{"op":"text","speaker":"朋也","text":"「两个人的关系…吗。」"},{"op":"choice","id":"3425:2035670","target":["v","f",1089],"items":[{"text":"朋友","value":0,"serial":2035670},{"text":"恋人","value":1,"serial":2035680},{"text":"夫妻","value":2,"serial":2035690}]},{"op":"ifFalse","to":783,"condition":["==",["v","f",1089],0]},{"op":"text","speaker":"","text":"我把羽毛型的光标移到『朋友』上，确认。"},{"op":"text","speaker":"","text":"叮呤～"},{"op":"background","image":"fgky02l"},{"op":"set","target":["v","a",500],"value":0},{"op":"bodies","images":[]},{"op":"text","speaker":"椋","text":"「………」"},{"op":"text","speaker":"朋也","text":"「嗯？有什么不对吗？」"},{"op":"background","image":"fgky02j"},{"op":"set","target":["v","a",500],"value":0},{"op":"bodies","images":[]},{"op":"text","speaker":"椋","text":"「嗯…是的…」"},{"op":"ifFalse","to":808,"condition":["==",["v","f",1089],1]},{"op":"text","speaker":"朋也","text":"「………」"},{"op":"text","speaker":"","text":"既然都来了…。"},{"op":"text","speaker":"","text":"那就选有趣一点的选项来占卜好了。"},{"op":"text","speaker":"","text":"我把羽毛型的光标移向『恋人』选项。"},{"op":"text","speaker":"椋","text":"「…～…」"},{"op":"text","speaker":"","text":"我听到了身旁紧张的声音。"},{"op":"text","speaker":"","text":"把光标移过去之前，我瞄了藤林一眼。"},{"op":"text","speaker":"朋也","text":"「…呜哇！」"},{"op":"text","speaker":"","text":"藤林脸红地像要马上昏倒了一样。"},{"op":"background","image":"fgky02l"},{"op":"set","target":["v","a",500],"value":0},{"op":"bodies","images":[]},{"op":"text","speaker":"椋","text":"「啊…」"},{"op":"text","speaker":"朋也","text":"「应，应该是朋友对吧。」"},{"op":"text","speaker":"","text":"我匆忙把箭头移到『朋友』上，确认。"},{"op":"text","speaker":"","text":"叮呤～"},{"op":"background","image":"fgky02j"},{"op":"set","target":["v","a",500],"value":0},{"op":"bodies","images":[]},{"op":"text","speaker":"朋也","text":"「………」"},{"op":"text","speaker":"椋","text":"「………」"},{"op":"text","speaker":"","text":"看来她不是一个能开这种玩笑的女孩。"},{"op":"text","speaker":"","text":"藤林满脸通红，紧盯着屏幕。"},{"op":"text","speaker":"","text":"就这样，我们之间的氛围变得有些尴尬。"},{"op":"ifFalse","to":844,"condition":["==",["v","f",1089],2]},{"op":"text","speaker":"朋也","text":"「选夫妻吧。」"},{"op":"background","image":"fgky02l"},{"op":"set","target":["v","a",500],"value":0},{"op":"bodies","images":[]},{"op":"text","speaker":"椋","text":"「呃…？」"},{"op":"text","speaker":"朋也","text":"「难得来一次，这样比较有趣嘛。」"},{"op":"text","speaker":"","text":"我转动水晶球，把光标往『夫妻』上移动。"},{"op":"text","speaker":"椋","text":"「不…不可以。」"},{"op":"text","speaker":"朋也","text":"「啊？」"},{"op":"text","speaker":"","text":"藤林的小手突然抓住我的袖子。"},{"op":"text","speaker":"椋","text":"「占卜一定要认真。」"},{"op":"text","speaker":"朋也","text":"「可这就是个游戏吧？」"},{"op":"text","speaker":"椋","text":"「游戏也是占卜，要认真。」"},{"op":"background","image":"fgky02k"},{"op":"set","target":["v","a",500],"value":0},{"op":"bodies","images":[]},{"op":"text","speaker":"椋","text":"「不然会被诅咒的。」"},{"op":"text","speaker":"朋也","text":"「真的假的？」"},{"op":"background","image":"fgky02l"},{"op":"set","target":["v","a",500],"value":0},{"op":"bodies","images":[]},{"op":"text","speaker":"椋","text":"「是，真的。」"},{"op":"text","speaker":"朋也","text":"「就这个游戏机？」"},{"op":"text","speaker":"椋","text":"「我们回去之前，一定会有１３只黑猫从我们面前走过的。」"},{"op":"text","speaker":"朋也","text":"「这倒是挺讨厌…」"},{"op":"text","speaker":"椋","text":"「这会让心情糟透的。」"},{"op":"text","speaker":"朋也","text":"「…是吗？」"},{"op":"text","speaker":"椋","text":"「是的。」"},{"op":"text","speaker":"","text":"藤林很少见的做出了肯定。"},{"op":"text","speaker":"","text":"在她喜欢的领域里，有她绝不能让步的一些东西啊。"},{"op":"text","speaker":"朋也","text":"「那就认真点，选这个吧。」"},{"op":"text","speaker":"","text":"我转动水晶球，把光标移动到『朋友』上，确定。"},{"op":"background","image":"fgky02j"},{"op":"set","target":["v","a",500],"value":0},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"菜单消失了，画面上只留下星星和夜空。"},{"op":"text","speaker":"","text":"过了一会，夜空上又一次出现了文字。"},{"op":"text","speaker":"朋也","text":"「嗯…？请把手叠放在水晶上…吗？」"},{"op":"text","speaker":"","text":"应该说的就是刚才用作移动的水晶球了吧。"},{"op":"text","speaker":"","text":"于是我把手放在了水晶上。"},{"op":"text","speaker":"椋","text":"「………」"},{"op":"text","speaker":"朋也","text":"「嗯？怎么了？」"},{"op":"background","image":"fgky02l"},{"op":"set","target":["v","a",500],"value":0},{"op":"bodies","images":[]},{"op":"text","speaker":"椋","text":"「那…那个…」"},{"op":"text","speaker":"朋也","text":"「手不放上来就玩不下去啦。」"},{"op":"background","image":"fgky02j"},{"op":"set","target":["v","a",500],"value":0},{"op":"bodies","images":[]},{"op":"text","speaker":"椋","text":"「好，好的…」"},{"op":"text","speaker":"","text":"在我的催促下，藤林小心翼翼的把手放上来。"},{"op":"background","image":"fgky02d"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"柔软的手贴在我的手背上。"},{"op":"text","speaker":"朋也","text":"「你的手，好暖和呀。」"},{"op":"background","image":"fgky02l"},{"op":"bodies","images":[]},{"op":"text","speaker":"椋","text":"「啊？」"},{"op":"text","speaker":"朋也","text":"「唉，别放手啊。玩不下去了。」"},{"op":"text","speaker":"椋","text":"「啊…对，对不起。」"},{"op":"background","image":"fgky02d"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"手又一次贴了上来。"},{"op":"text","speaker":"","text":"也许是她意识到要把手重叠到我的手上，所以这一次的感觉，比上一次稍微僵硬了一些。"},{"op":"text","speaker":"朋也","text":"「那我摁决定了哦。」"},{"op":"text","speaker":"椋","text":"「嗯，好，好的。」"},{"op":"text","speaker":"","text":"我用手背感受着藤林手心发出的温暖，在确认了她把手叠在我手上后，我摁下了决定按钮。"},{"op":"text","speaker":"","text":"画面上再次出现星体，围绕着太阳旋转。"},{"op":"background","image":"fgky02e"},{"op":"set","target":["v","a",500],"value":0},{"op":"bodies","images":[]},{"op":"set","target":["v","z",303],"value":1},{"op":"text","speaker":"","text":"传来的背景音乐也变得带了些神秘的色彩。"},{"op":"text","speaker":"","text":"外界和这里被帘子阻断，里面的氛围格外的逼真。"},{"op":"text","speaker":"","text":"想来占卜店里的氛围也是差不多的吧。"},{"op":"text","speaker":"","text":"而藤林似乎是被感动了似的，紧盯着画面。"},{"op":"text","speaker":"","text":"不，她大约的确是被感动了。"},{"op":"text","speaker":"","text":"证据就是她的手，没有刚才那么僵硬了。"},{"op":"text","speaker":"朋也","text":"「嗯？」"},{"op":"text","speaker":"","text":"画面突然发生了变化。"},{"op":"text","speaker":"","text":"旋转的星体分别排到了左右两侧。"},{"op":"text","speaker":"","text":"闪了几下后，渐渐消失了。"},{"op":"text","speaker":"","text":"在这同时，手下的水晶球开始发出淡淡的光芒。"},{"op":"text","speaker":"","text":"不一会，所有的星球全都消失，只留下太阳向我们靠近。"},{"op":"text","speaker":"","text":"太阳一路加速变得越来越大。撑满屏幕后，画面变成一片白色，最后消失…。"},{"op":"text","speaker":"朋也","text":"「哦？」"},{"op":"background","image":"fgky02d"},{"op":"set","target":["v","a",500],"value":0},{"op":"bodies","images":[]},{"op":"text","speaker":"椋","text":"「哇…」"},{"op":"text","speaker":"","text":"画面变成了划过流星的夜空。"},{"op":"text","speaker":"","text":"与此同时，我们刚输入的名字也浮现在画面中。"},{"op":"text","speaker":"","text":"接下来也还有字…。"},{"op":"text","speaker":"","text":"看来有结果了。"},{"op":"background","image":"fgky02e"},{"op":"set","target":["v","a",500],"value":0},{"op":"bodies","images":[]},{"op":"text","speaker":"椋","text":"「………」"},{"op":"text","speaker":"","text":"看着她盯着屏幕认真的侧脸。"},{"op":"text","speaker":"","text":"认真…能拼尽全力做一些事…。"},{"op":"text","speaker":"","text":"能有让自己认真的事情，也许是一件让人羡慕的事情…"},{"op":"text","speaker":"","text":"即便那是游戏或是占卜，是旁人看来毫无趣味可言的东西…。"},{"op":"text","speaker":"","text":"而我，却没有这样的东西…。"},{"op":"background","image":"fgky02f"},{"op":"set","target":["v","a",500],"value":0},{"op":"bodies","images":[]},{"op":"text","speaker":"椋","text":"「冈崎君…？」"},{"op":"text","speaker":"朋也","text":"「啊？」"},{"op":"text","speaker":"椋","text":"「那个…你怎么了…」"},{"op":"text","speaker":"朋也","text":"「什么怎么了…？」"},{"op":"text","speaker":"椋","text":"「那…那个…你刚才的脸色很严肃。」"},{"op":"text","speaker":"朋也","text":"「哦…抱歉。」"},{"op":"background","image":"fgky02d"},{"op":"set","target":["v","a",500],"value":0},{"op":"bodies","images":[]},{"op":"text","speaker":"椋","text":"「我想，结果应该不会太坏的…」"},{"op":"text","speaker":"","text":"藤林稍稍看了一眼屏幕。"},{"op":"text","speaker":"","text":"而我也被带着，一起看向了屏幕。"},{"op":"text","speaker":"","text":"『这一周你们会很聊得来，也很容易能感受到对方的心情。』"},{"op":"text","speaker":"","text":"『你们两个非常投机，请去寻找共同的兴趣爱好，一起去各种地方游玩，相信就能过得非常开心且有意义。』"},{"op":"text","speaker":"","text":"『只是需要注意不可以太过鲁莽。不必要的独占欲会让两人的距离越来越远。』"},{"op":"text","speaker":"","text":"『与其严肃对待，不如以朋友相待。』"},{"op":"text","speaker":"","text":"『幸运物品是，布偶·防水布。』"},{"op":"text","speaker":"","text":"『幸运色是，白色。』"},{"op":"text","speaker":"朋也","text":"「…的确不是什么坏结果。」"},{"op":"text","speaker":"","text":"在我小声嘟囔的同时，文字从画面上消失，又变成了流星的夜空。"},{"op":"text","speaker":"","text":"机器的下方…差不多是膝盖的地方，吱吱吱…打印出来了一张纸。"},{"op":"text","speaker":"朋也","text":"「嗯？这是什么？」"},{"op":"background","image":"fgky02f"},{"op":"set","target":["v","a",500],"value":0},{"op":"bodies","images":[]},{"op":"text","speaker":"椋","text":"「啊…是结果…。刚才占卜的结果。」"},{"op":"text","speaker":"朋也","text":"「哦，原来是这样的。」"},{"op":"background","image":"kuro"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"吱吱…吱…吱～～…吱…。"},{"op":"background","image":"bg035y"},{"op":"bodies","images":[]},{"op":"set","target":["v","f",1118],"value":4},{"op":"set","target":["v","z",317],"value":1},{"op":"text","speaker":"","text":"结果全部打印出来了。"},{"op":"text","speaker":"","text":"藤林拿起那一堆纸，看着我。"},{"op":"bodies","images":["cgry15"]},{"op":"text","speaker":"椋","text":"「啊…这个…给你…」"},{"op":"text","speaker":"朋也","text":"「…嗯？我不需要。」"},{"op":"bodies","images":["cgry19"]},{"op":"text","speaker":"椋","text":"「啊…那…我能留下吗？」"},{"op":"text","speaker":"朋也","text":"「可以啊…可你要了干嘛？」"},{"op":"bodies","images":["cgry20a"]},{"op":"text","speaker":"椋","text":"「啊…这…我…」"},{"op":"text","speaker":"朋也","text":"「？」"},{"op":"bodies","images":["cgry22a"]},{"op":"text","speaker":"椋","text":"「那个…收…收集起来。」"},{"op":"text","speaker":"朋也","text":"「…呃？」"},{"op":"bodies","images":["cgry21a"]},{"op":"text","speaker":"椋","text":"「…我要…收集…」"},{"op":"text","speaker":"朋也","text":"「………」"},{"op":"text","speaker":"","text":"我知道常有人会收集贴纸，可没想到会有人收集占卜游戏的结果条…。"},{"op":"bodies","images":["cgry19a"]},{"op":"text","speaker":"椋","text":"「…请问…我果然…很，很奇怪吗…？」"},{"op":"text","speaker":"朋也","text":"「没啊，没什么好奇怪的吧？」"},{"op":"text","speaker":"朋也","text":"「这都是个人的爱好。」"},{"op":"text","speaker":"朋也","text":"「也算是一种回忆嘛。」"},{"op":"bodies","images":["cgry21a"]},{"op":"text","speaker":"椋","text":"「是的。」"},{"op":"bodies","images":["cgry15"]},{"op":"text","speaker":"","text":"她点了点头，然后突然想到了什么似的睁开了眼睛。"},{"op":"text","speaker":"朋也","text":"「怎么了？」"},{"op":"bodies","images":["cgry18"]},{"op":"text","speaker":"椋","text":"「…我要买新的文件夹…」"},{"op":"text","speaker":"朋也","text":"「…？收集用的？」"},{"op":"bodies","images":["cgry19"]},{"op":"text","speaker":"椋","text":"「是，是的…收集新种类用的…」"},{"op":"text","speaker":"朋也","text":"「占星术吗？」"},{"op":"text","speaker":"","text":"话说，她该不会每一种占卜都准备了一个文件夹吧？"},{"op":"bodies","images":["cgry21"]},{"op":"text","speaker":"椋","text":"「不是的，天宫图的文件夹我已经有了…只是…」"},{"op":"text","speaker":"朋也","text":"「…只是？」"},{"op":"bodies","images":["cgry22"]},{"op":"text","speaker":"椋","text":"「～～～…」"},{"op":"text","speaker":"","text":"她脸上突然变得一片通红，低下了头。"},{"op":"text","speaker":"朋也","text":"「要是不方便说的话，没必要勉强告诉我的…？」"},{"op":"bodies","images":["cgry21"]},{"op":"text","speaker":"椋","text":"「嗯，好的…」"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"藤林从书包里拿出透明的文件夹，把占卜的结果条小心翼翼地夹在里面，又放回了书包。"},{"op":"text","speaker":"朋也","text":"「那我们走吧。」"},{"op":"bodies","images":["cgry19"]},{"op":"text","speaker":"椋","text":"「啊…好的。」"},{"op":"bodies","images":[]},{"op":"background","image":"bg033y"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"走出游戏机厅后，我们再次走上了回家的道路。"},{"op":"text","speaker":"","text":"地面的影子也要比之前长了几分。"},{"op":"text","speaker":"朋也","text":"「我说，要不帮我占卜一下明天的运势吧。」"},{"op":"bodies","images":["cgry15"]},{"op":"text","speaker":"椋","text":"「啊？哦…好的…那么…」"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"藤林从口袋里掏出了扑克牌。"},{"op":"text","speaker":"","text":"一边走着，一边用笨拙的手法洗牌…。"},{"op":"bodies","images":["cgry11b"]},{"op":"text","speaker":"椋","text":"「请。」"},{"op":"text","speaker":"朋也","text":"「那就这张吧。」"},{"op":"text","speaker":"","text":"我从牌堆里抽出了一张。"},{"op":"text","speaker":"","text":"是黑桃２。"},{"op":"bodies","images":["cgry18a"]},{"op":"text","speaker":"椋","text":"「结果是…和往常一样，会是个安宁的日子。」"},{"op":"text","speaker":"朋也","text":"「这样啊…」"},{"op":"bodies","images":["cgry11"]},{"op":"text","speaker":"","text":"藤林的『占卜』我已经看透了。"},{"op":"text","speaker":"","text":"也就是说，明天我会被卷进各种的骚乱当中…。"},{"op":"text","speaker":"朋也","text":"「谢啦。我会小心的。」"},{"op":"bodies","images":["cgry16"]},{"op":"text","speaker":"椋","text":"「…小心？」"},{"op":"text","speaker":"朋也","text":"「呃…没什么。你别在意。」"},{"op":"set","target":["v","f",1118],"value":0},{"op":"jumpScene","scene":3426,"entry":0},{"op":"return"}]