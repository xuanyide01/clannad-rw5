[{"op":"set","target":["v","f",1108],"value":0},{"op":"set","target":["v","f",1109],"value":4},{"op":"set","target":["v","f",1110],"value":19},{"op":"set","target":["v","f",1111],"value":6},{"op":"set","target":["v","f",1112],"value":1},{"op":"set","target":["v","z",303],"value":1},{"op":"ifFalse","to":9,"condition":["==",["v","f",9],1]},{"op":"callScene","scene":6419,"entry":0},{"op":"goto","to":14},{"op":"ifFalse","to":14,"condition":["==",["v","f",9],0]},{"op":"background","image":"bg033c"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"从早上开始天就阴着。"},{"op":"text","speaker":"","text":"天气预报说，下午开始会下雨。"},{"op":"background","image":"kuro"},{"op":"bodies","images":[]},{"op":"background","image":"bg021bc"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"春原不知所踪。"},{"op":"ifFalse","to":26,"condition":["==",["v","f",9],0]},{"op":"ifFalse","to":23,"condition":["==",["v","f",302],0]},{"op":"text","speaker":"","text":"真不打算来了啊…。"},{"op":"goto","to":25},{"op":"ifFalse","to":25,"condition":["==",["v","f",302],1]},{"op":"text","speaker":"","text":"昨晚经历了那样的遭遇之后，应该又在哪里怀疑人生了吧。"},{"op":"goto","to":28},{"op":"ifFalse","to":28,"condition":["==",["v","f",9],1]},{"op":"text","speaker":"","text":"肯定又迟到了吧。"},{"op":"background","image":"bg021ac"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"………。"},{"op":"background","image":"bg021bc"},{"op":"bodies","images":[]},{"op":"ifFalse","to":36,"condition":["==",["v","f",208],1]},{"op":"callScene","scene":2419,"entry":0},{"op":"goto","to":74},{"op":"set","target":["v","z",312],"value":1},{"op":"text","speaker":"","text":"第一节课结束后，双眼充血的春原出现了。"},{"op":"bodies","images":["cgsh12"]},{"op":"text","speaker":"春原","text":"「呀，早。」"},{"op":"ifFalse","to":56,"condition":["==",["v","f",9],0]},{"op":"ifFalse","to":48,"condition":["==",["v","f",302],0]},{"op":"text","speaker":"朋也","text":"「你似乎没睡够？」"},{"op":"bodies","images":["cgsh25"]},{"op":"text","speaker":"春原","text":"「昨天玩了一晚上的游戏书！」"},{"op":"text","speaker":"春原","text":"「这能证明我不是个胆小鬼了吧，嗯。」"},{"op":"text","speaker":"","text":"你的毅力还真诡异。"},{"op":"goto","to":53},{"op":"ifFalse","to":53,"condition":["==",["v","f",302],1]},{"op":"text","speaker":"朋也","text":"「咦？你哭了一个晚上？」"},{"op":"bodies","images":["cgsh16"]},{"op":"text","speaker":"春原","text":"「才没这种事！」"},{"op":"text","speaker":"","text":"说完后使劲地揉了揉眼睛。"},{"op":"bodies","images":["cgsh12"]},{"op":"text","speaker":"春原","text":"「但是，不觉得周六让人充满期待吗。」"},{"op":"goto","to":58},{"op":"ifFalse","to":58,"condition":["==",["v","f",9],1]},{"op":"text","speaker":"春原","text":"「不觉得周六让人充满期待吗。」"},{"op":"text","speaker":"朋也","text":"「有什么好期待的。」"},{"op":"text","speaker":"春原","text":"「不管怎么说，只要上三节课就结束了啊。」"},{"op":"text","speaker":"朋也","text":"「一般是四节课。」"},{"op":"bodies","images":["cgsh10"]},{"op":"text","speaker":"春原","text":"「放学后一起出去玩吧。」"},{"op":"bodies","images":["cgsh12"]},{"op":"text","speaker":"春原","text":"「偶尔也去向其他学校的妹子们搭个讪呀。」"},{"op":"text","speaker":"朋也","text":"「下午开始要下雨的。」"},{"op":"bodies","images":["cgsh27"]},{"op":"text","speaker":"春原","text":"「哇，不会吧！？」"},{"op":"text","speaker":"朋也","text":"「你走在路上都不看的吗？」"},{"op":"text","speaker":"朋也","text":"「睁大你的眼，天色都阴沉成这样了。」"},{"op":"bodies","images":["cgsh16"]},{"op":"text","speaker":"春原","text":"「怎么这样…周六晚上狂热的Saturday Night Fever没戏了…」"},{"op":"text","speaker":"朋也","text":"「同一个意思你说了两次。」"},{"op":"set","target":["v","f",811],"value":1},{"op":"callScene","scene":3419,"entry":0},{"op":"background","image":"kuro"},{"op":"bodies","images":[]},{"op":"background","image":"bg021dc"},{"op":"bodies","images":[]},{"op":"set","target":["v","z",313],"value":1},{"op":"text","speaker":"","text":"回教室拿书包的时候，春原独自在等着。"},{"op":"bodies","images":["cgsh13"]},{"op":"text","speaker":"春原","text":"「冈崎，你终于回来了。」"},{"op":"text","speaker":"朋也","text":"「哦，活过来了啊，真厉害。」"},{"op":"text","speaker":"春原","text":"「什么活不活的，我压根没被干掉。」"},{"op":"bodies","images":["cgsh10"]},{"op":"text","speaker":"春原","text":"「我，避，开，了。」"},{"op":"text","speaker":"朋也","text":"「既然你都这么说了，我是不是就当是这样好了…你说呢…」"},{"op":"text","speaker":"朋也","text":"「求我？」"},{"op":"text","speaker":"春原","text":"「求你了。」"},{"op":"text","speaker":"朋也","text":"「明白了，你能避开，好厉害。」"},{"op":"bodies","images":["cgsh13"]},{"op":"text","speaker":"春原","text":"「一般般啦。」"},{"op":"ifFalse","to":98,"condition":["==",["v","f",811],1]},{"op":"bodies","images":["cgsh12"]},{"op":"text","speaker":"春原","text":"「说来你接下来打算干什么去？去放飞自我？」"},{"op":"text","speaker":"朋也","text":"「都说了，要下雨的。」"},{"op":"goto","to":109},{"op":"ifFalse","to":109,"condition":["==",["v","f",811],0]},{"op":"bodies","images":["cgsh12"]},{"op":"text","speaker":"春原","text":"「那么，一起去哪里玩玩吧。」"},{"op":"text","speaker":"春原","text":"「偶尔也去向其他学校的妹子们搭个讪呀。」"},{"op":"text","speaker":"朋也","text":"「就要下雨了。」"},{"op":"bodies","images":["cgsh27"]},{"op":"text","speaker":"春原","text":"「哇，不会吧。」"},{"op":"text","speaker":"朋也","text":"「睁大你的眼，天色都阴沉成这样了。」"},{"op":"bodies","images":["cgsh16"]},{"op":"text","speaker":"春原","text":"「怎么这样…周六晚上狂热的Saturday Night Fever没戏了…」"},{"op":"text","speaker":"朋也","text":"「同一个意思你说了两次。」"},{"op":"bodies","images":[]},{"op":"text","speaker":"班主任","text":"「喂，春原。」"},{"op":"text","speaker":"","text":"是班主任的声音"},{"op":"text","speaker":"班主任","text":"「我今天一定要把你带到办公室。」"},{"op":"text","speaker":"","text":"班主任从课桌的间隙走来。"},{"op":"bodies","images":["cgsh27"]},{"op":"text","speaker":"春原","text":"「哇，糟了。」"},{"op":"text","speaker":"朋也","text":"「这里交给我，你快跳窗逃吧。」"},{"op":"bodies","images":["cgsh14"]},{"op":"text","speaker":"春原","text":"「噢。」"},{"op":"bodies","images":["cgsh23"]},{"op":"text","speaker":"春原","text":"「喂，会死的吧！」"},{"op":"text","speaker":"朋也","text":"「那这样，我来拖时间，你趁机帮我买蜜瓜面包和饮料！」"},{"op":"bodies","images":["cgsh14"]},{"op":"text","speaker":"春原","text":"「噢。」"},{"op":"bodies","images":["cgsh23"]},{"op":"text","speaker":"春原","text":"「喂，让我跑腿啊！」"},{"op":"text","speaker":"班主任","text":"「抓住你了。」"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"班主任紧紧抓住春原的肩膀。"},{"op":"bodies","images":["cgsh16"]},{"op":"text","speaker":"春原","text":"「哇啊ー，光顾着和冈崎胡扯了！」"},{"op":"text","speaker":"班主任","text":"「你俩关系真好。要不就一起…」"},{"op":"background","image":"bg018c"},{"op":"bodies","images":[]},{"op":"text","speaker":"朋也","text":"「我要回家了…」"},{"op":"text","speaker":"","text":"我已经跑去走廊了。"},{"op":"text","speaker":"","text":"我不去理会背后春原那『竟然丢下同胞！』的哀嚎，离开了这个是非之地。"},{"op":"ifFalse","to":140,"condition":["==",["v","f",9],1]},{"op":"callScene","scene":6419,"entry":1},{"op":"goto","to":475},{"op":"background","image":"kuro"},{"op":"bodies","images":[]},{"op":"background","image":"bg018c"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"唉…下午没什么事，而且春原也不在。"},{"op":"text","speaker":"","text":"干什么去呢…。"},{"op":"choice","id":"419:33840","target":["v","f",1089],"items":[{"text":"去旧教学楼","value":0,"serial":33840},{"text":"直接回家","value":1,"serial":33850}]},{"op":"ifFalse","to":149,"condition":["==",["v","f",1089],0]},{"op":"goto","to":152},{"op":"ifFalse","to":152,"condition":["==",["v","f",1089],1]},{"op":"text","speaker":"","text":"回去得了…。"},{"op":"goto","to":232},{"op":"background","image":"bg020c"},{"op":"bodies","images":[]},{"op":"ifFalse","to":156,"condition":["==",["v","f",400],0]},{"op":"text","speaker":"","text":"要说旧教学楼有什么，也就特别教室和图书室了，再有就是文化系社团赖以生存的空教室。"},{"op":"ifFalse","to":172,"condition":["||",["==",["v","f",500],0],["==",["v","f",501],1]]},{"op":"text","speaker":"","text":"虽然来到了旧教学楼…但问题是具体去哪。"},{"op":"choice","id":"419:33950","target":["v","f",1089],"items":[{"text":"去图书室","value":0,"serial":33950},{"text":"去活动室","value":1,"serial":33960},{"text":"去资料室","value":2,"serial":33970}]},{"op":"ifFalse","to":162,"condition":["==",["v","f",1089],0]},{"op":"goto","to":176},{"op":"goto","to":171},{"op":"ifFalse","to":165,"condition":["==",["v","f",1089],1]},{"op":"goto","to":194},{"op":"goto","to":171},{"op":"ifFalse","to":171,"condition":["==",["v","f",1089],2]},{"op":"ifFalse","to":169,"condition":["==",["v","f",500],0]},{"op":"callScene","scene":5418,"entry":0},{"op":"goto","to":171},{"op":"ifFalse","to":171,"condition":["==",["v","f",500],1]},{"op":"callScene","scene":5419,"entry":0},{"op":"goto","to":232},{"op":"ifFalse","to":232,"condition":["&&",["==",["v","f",500],1],["==",["v","f",501],0]]},{"op":"text","speaker":"","text":"虽然来到了旧教学楼…但问题是具体去哪。"},{"op":"choice","id":"419:34100","target":["v","f",1089],"items":[{"text":"去图书室","value":0,"serial":34100},{"text":"去活动室","value":1,"serial":34110},{"text":"回家","value":2,"serial":34120}]},{"op":"ifFalse","to":193,"condition":["==",["v","f",1089],0]},{"op":"text","speaker":"朋也","text":"「去图书室好了。」"},{"op":"text","speaker":"","text":"念叨着朝那边走去。"},{"op":"text","speaker":"","text":"并没有什么特别的意思，只是去观望下。"},{"op":"text","speaker":"","text":"爬上楼梯，旁边不断有去活动室的学生大步跑过。"},{"op":"text","speaker":"","text":"站在图书室门口，氛围明显和上课时不一样。"},{"op":"text","speaker":"","text":"说来，感觉是第一次见到门口那块『开放中』的牌子。"},{"op":"text","speaker":"","text":"从拉门的缝隙中看了看里面。"},{"op":"text","speaker":"","text":"图书室真够热闹的。"},{"op":"text","speaker":"","text":"说是热闹，其实大部分的人都在自习，能清楚听到自动铅笔写字的沙沙声。"},{"op":"text","speaker":"","text":"几乎没人把这里当作是安静看书的地方。"},{"op":"text","speaker":"","text":"虽然我没资格这么说，却依旧这么认为。"},{"op":"ifFalse","to":189,"condition":["==",["v","f",400],1]},{"op":"text","speaker":"","text":"坐在地板上吃便当的少女，当然不可能会存在。"},{"op":"text","speaker":"","text":"当然我和这里更加不搭调。"},{"op":"text","speaker":"朋也","text":"「………」"},{"op":"text","speaker":"朋也","text":"（回去吧…）"},{"op":"goto","to":232},{"op":"ifFalse","to":222,"condition":["==",["v","f",1089],1]},{"op":"callScene","scene":6419,"entry":2},{"op":"ifFalse","to":197,"condition":["==",["v","f",3],1]},{"op":"goto","to":232},{"op":"ifFalse","to":214,"condition":["==",["v","f",128],1]},{"op":"ifFalse","to":202,"condition":["||",["==",["v","f",2],1],["==",["v","f",1],1]]},{"op":"text","speaker":"","text":"还有一个令人在意的家伙…。"},{"op":"text","speaker":"","text":"看了看隔壁的房间。"},{"op":"goto","to":204},{"op":"ifFalse","to":204,"condition":["&&",["==",["v","f",2],0],["==",["v","f",1],0]]},{"op":"text","speaker":"","text":"通过门在看了看里面。"},{"op":"text","speaker":"","text":"果然还在呢。"},{"op":"text","speaker":"朋也","text":"（是叫风子来着吧…）"},{"op":"text","speaker":"","text":"在很努力地雕刻着木块。"},{"op":"text","speaker":"朋也","text":"「………」"},{"op":"text","speaker":"朋也","text":"（我是那家伙的监护人吗…？）"},{"op":"text","speaker":"朋也","text":"（没这回事吧…）"},{"op":"text","speaker":"","text":"风子也注意到了这里，抬起了头。"},{"op":"text","speaker":"","text":"大概是想说不要紧吧，朝这边张开了手掌。"},{"op":"text","speaker":"朋也","text":"「啊，也是啊…」"},{"op":"text","speaker":"","text":"我好像影响到别人了。我也在挥手示意后便离开了。"},{"op":"ifFalse","to":220,"condition":["&&",["&&",["==",["v","f",128],0],["==",["v","f",2],0]],["==",["v","f",1],0]]},{"op":"text","speaker":"","text":"活动室…？"},{"op":"text","speaker":"","text":"是不是该说今天开始就要请你们多多关照啦之类的再进去？"},{"op":"text","speaker":"","text":"这事春原来做的话感觉会挺好笑的，但并不是该我来做的。"},{"op":"text","speaker":"","text":"这么一来…"},{"op":"text","speaker":"","text":"完全没事啊。"},{"op":"text","speaker":"朋也","text":"（回去吧…）"},{"op":"goto","to":232},{"op":"ifFalse","to":232,"condition":["==",["v","f",1089],2]},{"op":"text","speaker":"朋也","text":"（回去吧…）"},{"op":"text","speaker":"","text":"…啧，我到底是来旧教学楼干吗的啊。"},{"op":"text","speaker":"","text":"这不是给自己徒添疲劳吗。"},{"op":"text","speaker":"","text":"…就这么回去感觉缺了点什么。"},{"op":"text","speaker":"朋也","text":"「哈，热舞一下。」"},{"op":"text","speaker":"","text":"所以我一个人在走廊摇摆了起来。"},{"op":"text","speaker":"","text":"跳了舞就没算白来。"},{"op":"text","speaker":"朋也","text":"「嗯…真是充实放学时间。」"},{"op":"text","speaker":"","text":"怎么感觉更加空虚了。"},{"op":"ifFalse","to":238,"condition":["==",["v","f",211],1]},{"op":"background","image":"kuro"},{"op":"bodies","images":[]},{"op":"background","image":"bg016c"},{"op":"bodies","images":[]},{"op":"callScene","scene":2419,"entry":1},{"op":"ifFalse","to":241,"condition":["==",["v","f",405],1]},{"op":"callScene","scene":4419,"entry":0},{"op":"goto","to":347},{"op":"ifFalse","to":347,"condition":["==",["v","f",405],0]},{"op":"background","image":"kuro"},{"op":"bodies","images":[]},{"op":"background","image":"bg034c"},{"op":"bodies","images":[]},{"op":"set","target":["v","z",315],"value":1},{"op":"text","speaker":"","text":"回家放好东西，换上衣服，趁着雨还没下下来我朝宿舍走去。"},{"op":"background","image":"bg046c"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"房间里空无一人。"},{"op":"text","speaker":"朋也","text":"（还没被放回来啊…）"},{"op":"text","speaker":"","text":"差不多也该回来了吧。"},{"op":"text","speaker":"","text":"我边看杂志边等春原回来。"},{"op":"text","speaker":"","text":"………。"},{"op":"background","image":"bg046c"},{"op":"bodies","images":[]},{"op":"set","target":["v","z",314],"value":1},{"op":"text","speaker":"","text":"嘎吱，门被打开了。"},{"op":"bodies","images":["cgsh16"]},{"op":"text","speaker":"春原","text":"「呼…」"},{"op":"bodies","images":["cgsh27"]},{"op":"text","speaker":"春原","text":"「呜哇，有人在里面。」"},{"op":"text","speaker":"朋也","text":"「欢迎回来。」"},{"op":"bodies","images":["cgsh16"]},{"op":"text","speaker":"春原","text":"「我说你啊…别擅自跑别人房里啊…」"},{"op":"text","speaker":"春原","text":"「我都被你吓到了…」"},{"op":"text","speaker":"朋也","text":"「下次我会躲在被炉里面，突然抓住你的脚。」"},{"op":"bodies","images":["cgsh23"]},{"op":"text","speaker":"春原","text":"「那会吓死人的。」"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"他关上门，脱下外套。"},{"op":"bodies","images":["cgsh18b"]},{"op":"text","speaker":"春原","text":"「真是够了，我都要被逼死了…」"},{"op":"text","speaker":"春原","text":"「顺带一提，下次就轮到你了。」"},{"op":"bodies","images":["cgsh15b"]},{"op":"text","speaker":"春原","text":"「你老家就在这里，估计老师会登门拜访的。」"},{"op":"text","speaker":"朋也","text":"「真的假的…」"},{"op":"text","speaker":"春原","text":"「他们还打算让我升学呢…」"},{"op":"text","speaker":"朋也","text":"「就你？哈哈哈，没戏的啦。」"},{"op":"bodies","images":["cgsh23b"]},{"op":"text","speaker":"春原","text":"「你也是啊。」"},{"op":"bodies","images":["cgsh20b"]},{"op":"text","speaker":"春原","text":"「啊ー啊…果然还是下起来了。」"},{"op":"text","speaker":"","text":"春原透过窗户看着外面的天空说到。"},{"op":"bodies","images":["cgsh18b"]},{"op":"text","speaker":"春原","text":"「这样不就哪儿都去不了吗。」"},{"op":"text","speaker":"春原","text":"「居然大中午的就要和一个男人在房间里独处…」"},{"op":"text","speaker":"朋也","text":"「那你出去吧。」"},{"op":"bodies","images":["cgsh23b"]},{"op":"text","speaker":"春原","text":"「这是我的房间好吧。」"},{"op":"text","speaker":"朋也","text":"「不过，比你一个人待着强吧？」"},{"op":"bodies","images":["cgsh16b"]},{"op":"text","speaker":"春原","text":"「是啊…」"},{"op":"ifFalse","to":323,"condition":["==",["v","f",302],1]},{"op":"text","speaker":"朋也","text":"「要不我们两个，去玩在雨中裸奔假装神经病的游戏吧。」"},{"op":"text","speaker":"朋也","text":"「猜拳输掉的春原，要去雨中裸奔假装神经病。」"},{"op":"bodies","images":["cgsh27b"]},{"op":"text","speaker":"春原","text":"「什么叫输掉的春原…那输掉的冈崎呢！？」"},{"op":"text","speaker":"朋也","text":"「好，我们开始吧。」"},{"op":"text","speaker":"春原","text":"「唉？」"},{"op":"bodies","images":[]},{"op":"text","speaker":"朋也","text":"「剪刀石头布！」"},{"op":"bodies","images":["cgsh25b"]},{"op":"text","speaker":"春原","text":"「好，我赢了！」"},{"op":"text","speaker":"朋也","text":"「该死。」"},{"op":"bodies","images":[]},{"op":"text","speaker":"朋也","text":"「再来一次，剪刀石头布！」"},{"op":"bodies","images":["cgsh25b"]},{"op":"text","speaker":"春原","text":"「好，我连胜了！」"},{"op":"bodies","images":[]},{"op":"text","speaker":"朋也","text":"「你赶紧输掉去裸奔吧，剪刀石头布！」"},{"op":"bodies","images":["cgsh27b"]},{"op":"text","speaker":"春原","text":"「啊，终于还是输了！」"},{"op":"text","speaker":"朋也","text":"「漂亮，慢走不送。」"},{"op":"bodies","images":["cgsh26b"]},{"op":"text","speaker":"春原","text":"「可恶，很丢人啊，跟神经病似的。」"},{"op":"bodies","images":["cgsh23b"]},{"op":"text","speaker":"春原","text":"「话说，谁会去啊！」"},{"op":"text","speaker":"春原","text":"「这种欺负人一样的游戏哪里好玩了啊。」"},{"op":"text","speaker":"朋也","text":"「超好玩的。」"},{"op":"text","speaker":"春原","text":"「觉得好玩的人只有你！」"},{"op":"goto","to":347},{"op":"ifFalse","to":347,"condition":["==",["v","f",302],0]},{"op":"text","speaker":"朋也","text":"「要不我们两个，去玩在雨中裸奔假装神经病的游戏吧。」"},{"op":"text","speaker":"朋也","text":"「猜拳输掉的春原，要去雨中裸奔假装神经病。」"},{"op":"bodies","images":["cgsh27b"]},{"op":"text","speaker":"春原","text":"「什么叫输掉的春原…那输掉的冈崎呢！？」"},{"op":"text","speaker":"朋也","text":"「好，我们开始吧。」"},{"op":"text","speaker":"春原","text":"「唉？」"},{"op":"bodies","images":[]},{"op":"text","speaker":"朋也","text":"「剪刀石头布！」"},{"op":"bodies","images":["cgsh25b"]},{"op":"text","speaker":"春原","text":"「好，我赢了！」"},{"op":"text","speaker":"朋也","text":"「该死。」"},{"op":"bodies","images":[]},{"op":"text","speaker":"朋也","text":"「再来一次，剪刀石头布！」"},{"op":"bodies","images":["cgsh25b"]},{"op":"text","speaker":"春原","text":"「好，我连胜了！」"},{"op":"bodies","images":[]},{"op":"text","speaker":"朋也","text":"「你赶紧输掉去裸奔吧，剪刀石头布！」"},{"op":"bodies","images":["cgsh25b"]},{"op":"text","speaker":"春原","text":"「怎么样，三连胜！」"},{"op":"bodies","images":["cgsh23b"]},{"op":"text","speaker":"春原","text":"「喂，非要我出去裸奔这猜拳游戏才算完吗！」"},{"op":"text","speaker":"朋也","text":"「没错。」"},{"op":"text","speaker":"春原","text":"「这绝对是欺负人好吧！」"},{"op":"ifFalse","to":473,"condition":["==",["v","f",632],1]},{"op":"text","speaker":"","text":"雨持续到了夜里。"},{"op":"background","image":"bg046n"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"咚咚。"},{"op":"text","speaker":"春原","text":"「嗯，是谁？」"},{"op":"text","speaker":"","text":"听到了敲门声的春原朝着门方向问到。"},{"op":"set","target":["v","z",320],"value":1},{"op":"bodies","images":["cgms10"]},{"op":"text","speaker":"美佐枝","text":"「是我。」"},{"op":"text","speaker":"","text":"从半开的门缝中，可以看到美佐枝小姐的脸庞。"},{"op":"bodies","images":["cgsh12b"]},{"op":"text","speaker":"春原","text":"「什么事？给我做了蛋糕吗？」"},{"op":"bodies","images":["cgms19"]},{"op":"text","speaker":"美佐枝","text":"「做个头啊…」"},{"op":"bodies","images":["cgsh18b"]},{"op":"text","speaker":"春原","text":"「嘁，什么嘛，害我空欢喜一场。」"},{"op":"bodies","images":["cgms20"]},{"op":"text","speaker":"美佐枝","text":"「我什么时候说过值得你期待的话了…」"},{"op":"bodies","images":["cgsh13b"]},{"op":"text","speaker":"春原","text":"「美佐枝小姐光站着都是让人抱有期待的存在。」"},{"op":"bodies","images":["cgms19h"]},{"op":"text","speaker":"美佐枝","text":"「那还真是罪过…」"},{"op":"text","speaker":"春原","text":"「没事，下次做个蛋糕给我就好了。」"},{"op":"bodies","images":["cgms13h"]},{"op":"text","speaker":"美佐枝","text":"「好啦…知道了。」"},{"op":"bodies","images":["cgsh10b"]},{"op":"text","speaker":"春原","text":"「于是找我有事？」"},{"op":"bodies","images":["cgms10h"]},{"op":"text","speaker":"美佐枝","text":"「我在想冈崎有没有带伞。」"},{"op":"text","speaker":"","text":"美佐枝小姐看向我。"},{"op":"text","speaker":"朋也","text":"「嗯？我？」"},{"op":"text","speaker":"美佐枝","text":"「是啊。现在雨很大。你带伞了吗？」"},{"op":"text","speaker":"朋也","text":"「嗯，带是没带，到时候随便拿一把回去就是。」"},{"op":"bodies","images":["cgms20h"]},{"op":"text","speaker":"美佐枝","text":"「你准备拿谁的哦…」"},{"op":"text","speaker":"朋也","text":"「鞋柜那边不都是伞嘛。」"},{"op":"text","speaker":"美佐枝","text":"「那些都是我们宿舍学生的伞。」"},{"op":"text","speaker":"朋也","text":"「发觉伞没了的家伙到时候也会偷偷拿走别人的，没关系啦。」"},{"op":"text","speaker":"美佐枝","text":"「别让这种恶性循环循环起来行不？」"},{"op":"bodies","images":["cgms19"]},{"op":"text","speaker":"美佐枝","text":"「给，用这把好了。」"},{"op":"text","speaker":"","text":"手中拿着一把折伞。"},{"op":"text","speaker":"","text":"不由分说地扔出了一道漂亮的弧线，也只好拿着了。"},{"op":"bodies","images":["cgms15h"]},{"op":"text","speaker":"美佐枝","text":"「如果你要的话，雨鞋也有哦。」"},{"op":"text","speaker":"朋也","text":"「一把年纪就不穿了吧。」"},{"op":"text","speaker":"美佐枝","text":"「风大雨大的，你回家鞋子肯定会湿透的哦？」"},{"op":"text","speaker":"朋也","text":"「没关系。」"},{"op":"text","speaker":"美佐枝","text":"「哦，是吗。」"},{"op":"text","speaker":"美佐枝","text":"「总之别感冒了。」"},{"op":"text","speaker":"朋也","text":"「嗯。」"},{"op":"bodies","images":["cgms10"]},{"op":"text","speaker":"美佐枝","text":"「好了。那我走了。」"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"举手示意后，关上了门。"},{"op":"bodies","images":["cgsh12b"]},{"op":"text","speaker":"春原","text":"「感冒的话，让美佐枝小姐来照顾一下也不错。」"},{"op":"text","speaker":"朋也","text":"「还真会这样，算了吧。」"},{"op":"bodies","images":["cgsh13b"]},{"op":"text","speaker":"春原","text":"「为什么啊？不好吗。」"},{"op":"text","speaker":"春原","text":"「额头靠在一起量体温之类的。」"},{"op":"bodies","images":["cgsh12b"]},{"op":"text","speaker":"春原","text":"「那时候恶作剧亲她一下，也不至于对着病人发火吧。」"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"我看了看手里的伞。朱红色的女款。是美佐枝小姐的东西吧。"},{"op":"text","speaker":"朋也","text":"（还不如塑料伞让人舒服一些呢…）"},{"op":"text","speaker":"","text":"但是也不好辜负美佐枝小姐的一番好意。"},{"op":"text","speaker":"","text":"光照顾住校生就已经累成那样了，还要来关心我有没有带伞。"},{"op":"text","speaker":"","text":"咚咚。"},{"op":"text","speaker":"","text":"又是敲门声，这次敲得很重。"},{"op":"text","speaker":"","text":"还不等人回复，门就被打开了。"},{"op":"set","target":["v","z",317],"value":1},{"op":"text","speaker":"橄榄球部","text":"「喂！」"},{"op":"text","speaker":"","text":"橄榄球部的那群家伙探头进来。"},{"op":"bodies","images":["cgsh23b"]},{"op":"text","speaker":"春原","text":"「噫！有何贵干！？」"},{"op":"bodies","images":[]},{"op":"text","speaker":"橄榄球部","text":"「冈崎。」"},{"op":"text","speaker":"","text":"全员齐刷刷看向我。"},{"op":"text","speaker":"朋也","text":"「嗯？叫我？」"},{"op":"text","speaker":"橄榄球部","text":"「出来聊聊。」"},{"op":"bodies","images":["cgsh27b"]},{"op":"text","speaker":"春原","text":"「啥？怎么回事，你干什么了？这气氛很不妙吧？」"},{"op":"text","speaker":"","text":"春原小声地对我说。"},{"op":"bodies","images":["cgsh16b"]},{"op":"text","speaker":"春原","text":"「感觉要被教训了就跪下磕头道歉。我一直都这么干。」"},{"op":"text","speaker":"朋也","text":"「你还有点自尊心没…」"},{"op":"bodies","images":[]},{"op":"text","speaker":"橄榄球部","text":"「喂，快点。」"},{"op":"text","speaker":"朋也","text":"「知道啦，马上就来，别催。」"},{"op":"text","speaker":"","text":"我站起来走出了房间。"},{"op":"background","image":"bg045n"},{"op":"bodies","images":[]},{"op":"text","speaker":"橄榄球部","text":"「冈崎，你这人啊。」"},{"op":"text","speaker":"橄榄球部","text":"「是不是对美佐枝小姐灌输了什么。」"},{"op":"text","speaker":"朋也","text":"「灌输？」"},{"op":"text","speaker":"橄榄球部","text":"「是你教她那些怪招的吧。」"},{"op":"text","speaker":"朋也","text":"「哦，大风车吗？」"},{"op":"text","speaker":"橄榄球部","text":"「还有其他的吧。」"},{"op":"text","speaker":"橄榄球部","text":"「刚才我还看到你在和美佐枝小姐说话。」"},{"op":"text","speaker":"橄榄球部","text":"「你再不注意一点的话，小心再也来不了。」"},{"op":"text","speaker":"朋也","text":"「你们别再给美佐枝小姐添麻烦不就得了。」"},{"op":"text","speaker":"朋也","text":"「守点规矩行吗。」"},{"op":"text","speaker":"橄榄球部","text":"「轮不到你这惯犯来说。」"},{"op":"text","speaker":"朋也","text":"「话虽如此，你们倒是看看自己给美佐枝小姐添了多少麻烦啊。」"},{"op":"text","speaker":"橄榄球部","text":"「怎么，你这家伙想要逞英雄？」"},{"op":"text","speaker":"橄榄球部","text":"「你小子，不会对美佐枝小姐有意思吧。」"},{"op":"text","speaker":"朋也","text":"「没有啊…话说关你们什么事，嗯？」"},{"op":"text","speaker":"朋也","text":"「你们几个，对美佐枝小姐有意思？」"},{"op":"text","speaker":"橄榄球部","text":"「咦？」"},{"op":"text","speaker":"","text":"这些家伙面面相觑。"},{"op":"text","speaker":"","text":"然后全都露出了尴尬的笑容。"},{"op":"text","speaker":"","text":"…真是的，这群家伙是小学生啊。"},{"op":"text","speaker":"","text":"希望被照顾，所以特地去给对方添麻烦。"},{"op":"text","speaker":"橄榄球部","text":"「总而言之。」"},{"op":"text","speaker":"橄榄球部","text":"「你又不住在这里，今后不准再接近美佐枝小姐了。」"},{"op":"text","speaker":"朋也","text":"「………」"},{"op":"text","speaker":"橄榄球部","text":"「回答呢！？」"},{"op":"text","speaker":"朋也","text":"「好好，知道了。」"},{"op":"text","speaker":"","text":"对方人多就是可以为所欲为，只好先这么敷衍了事。"},{"op":"text","speaker":"橄榄球部","text":"「嗯，明白就好。」"},{"op":"text","speaker":"","text":"接着就各自回房了。"},{"op":"text","speaker":"朋也","text":"（整天被这群傻子缠着的美佐枝小姐还真是可怜啊…）"},{"op":"set","target":["v","f",633],"value":1},{"op":"goto","to":475},{"op":"ifFalse","to":475,"condition":["==",["v","f",632],0]},{"op":"text","speaker":"","text":"到了晚上，雨还是一直在下。"},{"op":"background","image":"kuro"},{"op":"bodies","images":[]},{"op":"jumpScene","scene":420,"entry":0},{"op":"return"}]