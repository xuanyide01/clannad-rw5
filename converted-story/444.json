[{"op":"set","target":["v","f",1112],"value":0},{"op":"ifFalse","to":5,"condition":["==",["v","f",314],0]},{"op":"background","image":"bg010"},{"op":"bodies","images":[]},{"op":"goto","to":8},{"op":"ifFalse","to":8,"condition":["==",["v","f",314],1]},{"op":"background","image":"bg010y"},{"op":"bodies","images":[]},{"op":"set","target":["v","z",303],"value":1},{"op":"ifFalse","to":13,"condition":["==",["v","f",512],1]},{"op":"text","speaker":"","text":"结果，还是回到了家。"},{"op":"text","speaker":"","text":"一如既往的空无一人。"},{"op":"goto","to":15},{"op":"ifFalse","to":15,"condition":["==",["v","f",512],0]},{"op":"text","speaker":"","text":"穿过玄关，进到房间里。一如既往的空无一人。"},{"op":"text","speaker":"","text":"冷清的家。"},{"op":"text","speaker":"","text":"没有任何温暖的家。"},{"op":"text","speaker":"","text":"令人作呕…住有陌生人的家。"},{"op":"text","speaker":"","text":"空气沉重。"},{"op":"text","speaker":"","text":"令人无法思考。"},{"op":"text","speaker":"","text":"我没有任何亲人。"},{"op":"text","speaker":"","text":"没有家人。"},{"op":"text","speaker":"","text":"这样想着，一直住下去。"},{"op":"ifFalse","to":27,"condition":["==",["v","f",314],0]},{"op":"background","image":"bg009"},{"op":"bodies","images":[]},{"op":"goto","to":30},{"op":"ifFalse","to":30,"condition":["==",["v","f",314],1]},{"op":"background","image":"bg009y"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"那么，我…"},{"op":"text","speaker":"","text":"就算变成大人…也依旧会过着没有家人的日子吗。"},{"op":"text","speaker":"","text":"那时候的我，会是什么样的我呢。"},{"op":"text","speaker":"","text":"………。"},{"op":"text","speaker":"","text":"啊，只是想想就感觉烦躁。"},{"op":"text","speaker":"","text":"不想背负任何责任。"},{"op":"text","speaker":"","text":"只想轻松地活下去。"},{"op":"text","speaker":"","text":"哪怕一直孤身一人也没有关系。"},{"op":"ifFalse","to":42,"condition":["||",["==",["v","f",512],1],["==",["v","f",513],1]]},{"op":"text","speaker":"","text":"脑中忽然浮现出宫泽。"},{"op":"text","speaker":"","text":"可是，马上又消失了。"},{"op":"goto","to":50},{"op":"ifFalse","to":46,"condition":["==",["v","f",307],1]},{"op":"text","speaker":"","text":"脑中忽然浮现出藤林。"},{"op":"text","speaker":"","text":"可是，马上又消失了。"},{"op":"text","speaker":"","text":"杏为了撮合我们，明明做了那么多…。"},{"op":"ifFalse","to":50,"condition":["==",["v","f",321],1]},{"op":"text","speaker":"","text":"像藤林和胜平那样，明明在一起可最后还是分开了…。"},{"op":"text","speaker":"","text":"他们…。"},{"op":"text","speaker":"","text":"或许分开才是正确的也说不定…。"},{"op":"text","speaker":"朋也","text":"（如果有这样的一家人，那才是最糟糕的…）"},{"op":"ifFalse","to":54,"condition":["&&",["==",["v","f",512],0],["==",["v","f",513],0]]},{"op":"text","speaker":"","text":"正在换校服的我，或许是太累了，忽然感到一阵困意。"},{"op":"goto","to":56},{"op":"ifFalse","to":56,"condition":["||",["==",["v","f",512],1],["==",["v","f",513],1]]},{"op":"text","speaker":"","text":"或许是太累了，忽然感到一阵困意。"},{"op":"text","speaker":"","text":"就这样直接倒在了床上。"},{"op":"text","speaker":"朋也","text":"（等醒过来的时候，如果一切都发生了改变就好了…）"},{"op":"text","speaker":"","text":"不过，我清楚。"},{"op":"text","speaker":"","text":"不会有任何新的事物，也不会有任何变化。"},{"op":"text","speaker":"","text":"最终，还是会走到这一步。"},{"op":"background","image":"kuro"},{"op":"bodies","images":[]},{"op":"background","image":"siro"},{"op":"bodies","images":[]},{"op":"set","target":["v","z",301],"value":1},{"op":"text","speaker":"","text":"一望无际的白色世界…"},{"op":"text","speaker":"","text":"………"},{"op":"text","speaker":"","text":"雪…"},{"op":"background","image":"bg300"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"对，是雪。"},{"op":"text","speaker":"","text":"不断飘落，渐渐盖住了我的身体。"},{"op":"text","speaker":"","text":"我抓着一只雪白的手。"},{"op":"text","speaker":"","text":"我并不是孤身一人。"},{"op":"text","speaker":"","text":"拭去她脸上的雪。"},{"op":"text","speaker":"","text":"露出来一张安详的睡脸。"},{"op":"text","speaker":"","text":"对了…"},{"op":"text","speaker":"","text":"我和她…一直在一起。"},{"op":"text","speaker":"","text":"在这个世界。"},{"op":"background","image":"kuro"},{"op":"bodies","images":[]},{"op":"text","speaker":"","text":"这个，没有任何人，异常悲伤世界。"},{"op":"set","target":["v","g",1004],"value":0},{"op":"set","target":["v","g",1005],"value":0},{"op":"set","target":["v","g",1006],"value":0},{"op":"end"},{"op":"return"}]