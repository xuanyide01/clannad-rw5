<template>
  <div class="page" onswipe="swipe">
    <div if="{{mode === 'title'}}" class="title-art">
      <image class="title-background" src="{{titleBackgroundSrc}}" onerror="backgroundError"></image>
      <image class="title-logo" src="/common/ui/logo.png"></image>
      <image class="title-kana" src="/common/ui/subtitle.png"></image>
      <image class="title-menu-glass" src="/common/ui/title-panel.png"></image>
      <text class="title-progress">{{progressLabel}}</text>
      <image class="title-copyright" src="/common/ui/copyright.png"></image>
    </div>
    <image if="{{mode !== 'title' && mode !== 'play' && mode !== 'choice' && mode !== 'cg'}}" class="paper-background" src="/common/ui/paper.jpg"></image>
    <div if="{{mode === 'play' || mode === 'choice'}}" class="art" onclick="advance">
      <image class="background" src="{{backgroundSrc}}" onerror="backgroundError" oncomplete="backgroundLoaded"></image>
      <image if="{{bodySrc !== ''}}" class="body" style="width: {{portraitWidth}}px; height: {{portraitHeight}}px; top: {{portraitTop}}px; left: {{portraitLeft}}px;" src="{{bodySrc}}"></image>
      <image if="{{bodySecond !== ''}}" class="body" style="width: {{portraitSecondWidth}}px; height: {{portraitSecondHeight}}px; top: {{portraitSecondTop}}px; left: {{portraitSecondLeft}}px;" src="{{bodySecond}}"></image>
      <image if="{{bodyThird !== ''}}" class="body" style="width: {{portraitThirdWidth}}px; height: {{portraitThirdHeight}}px; top: {{portraitThirdTop}}px; left: {{portraitThirdLeft}}px;" src="{{bodyThird}}"></image>
    </div>
    <div if="{{mode === 'title'}}" class="title-panel">
      <div class="title-button" onclick="startNew"><image class="original-button" src="/common/ui/new-game.png"></image></div>
      <div class="title-button" onclick="continueGame"><image class="original-button" src="/common/ui/load.png"></image></div>
      <div class="title-button" onclick="startAfter"><image class="original-button" style="opacity: {{afterAvailable ? 1 : 0.4}};" src="/common/ui/after-story.png"></image></div>
      <div class="title-button" onclick="openGallery"><image class="original-button" src="/common/ui/cg-mode.png"></image></div>
      <div class="title-button" onclick="openConfig"><image class="original-button" src="/common/ui/config.png"></image></div>
    </div>
    <div if="{{mode === 'config'}}" class="overlay">
      <text class="menu-title">CONFIG</text><text class="panel-subtitle">系统设置</text>
      <text class="menu-action" onclick="toggleMusic">{{musicLabel}}</text>
      <text class="menu-action" onclick="toggleSpeed">{{speedLabel}}</text>
      <text class="menu-action" onclick="toggleFont">{{fontLabel}}</text>
      <text class="menu-action" onclick="openRoutes">选择路线 / 章节</text>
      <text class="menu-action" onclick="openHelp">操作说明</text>
      <text class="menu-action return-action" onclick="toTitle">返回标题</text>
    </div>
    <div if="{{mode === 'help'}}" class="overlay">
      <text class="menu-title">操作说明</text>
      <text class="help-text">轻触画面或正文：显示整句 / 下一句。
上滑正文：阅读长文本。
右滑：打开阅读菜单。
自动播放：菜单开启，可选三档速度。
自动播放遇选项暂停，选择后继续。
菜单、存读档和滚动正文时暂停。
保存与加载：自行选择 30 个栏位。
下一章遇选项停止，需手动选择。
按攻略游玩请从 NEW GAME 开始。
路线直达不计入光玉与通关记录。</text>
      <text class="menu-action return-action" onclick="openConfig">返回设置</text>
    </div>
    <image if="{{mode === 'play'}}" class="dialogue-backdrop" src="/common/ui/dialogue.jpg"></image>
    <div if="{{mode === 'play'}}" class="dialogue-panel">
      <div class="speaker-row"><text class="speaker" style="font-family: {{speakerFont}};">{{speaker}}</text><text class="chapter" style="font-family: {{chapterFont}};">{{chapterLabel}}</text></div>
      <scroll id="dialogue-scroll" class="dialogue-scroll" scroll-y="true" ontouchstart="dialogueTouchStart" ontouchmove="dialogueTouchMove" ontouchend="dialogueTouchEnd" onscroll="dialogueScrolled" onclick="dialogueTap"><div class="dialogue-content" style="height: {{dialogueHeight}}px;"><text class="dialogue" style="font-size: {{fontSize}}px;font-family: {{dialogueFont}};">{{displayText}}</text></div></scroll>
      <div class="toolbar"><text class="tool" onclick="goBack">上一句</text><text class="tool" onclick="showMenu">{{autoEnabled ? '自动 · 菜单' : '菜单'}}</text><text class="tool" onclick="advance">下一句 ›</text></div>
    </div>
    <div if="{{mode === 'choice'}}" class="choice-panel">
      <text class="choice-title">选择下一步</text>
      <scroll class="choice-list" scroll-y="true"><text for="{{options}}" tid="text" class="choice" style="font-family: {{$item.font}};" onclick="pick($idx)">{{$item.text}}</text></scroll>
      <text class="small-action" onclick="showMenu">菜单</text>
    </div>
    <div if="{{mode === 'menu'}}" class="overlay">
      <text class="menu-title">阅读菜单</text>
      <text class="menu-action reading-action" onclick="saveGame">保存进度</text>
      <text class="menu-action reading-action" onclick="loadGame">读取进度</text>
      <text class="menu-action reading-action" style="color: {{hasNextChapter ? '#3d665b' : '#abbebc'}};" onclick="goNextChapter">下一章 ›</text>
      <text class="menu-action reading-action" onclick="toggleAuto">{{autoLabel}}</text>
      <text class="menu-action reading-action" onclick="cycleAutoSpeed">{{autoSpeedLabel}}</text>
      <text class="menu-action reading-action" onclick="toggleSpeed">{{speedLabel}}</text>
      <text class="menu-action reading-action" onclick="toggleFont">{{fontLabel}}</text>
      <text class="menu-action reading-action" onclick="resume">返回游戏</text>
      <text class="menu-action reading-action muted" onclick="toTitle">返回标题</text>
    </div>
    <div if="{{mode === 'routes' || mode === 'chapters'}}" class="full-panel">
      <text class="panel-title">{{browseTitle}}</text><text class="panel-subtitle" style="font-family: {{browseFont}};">{{browseLabel}}</text>
      <div class="slot-list"><div for="{{browseRows}}" tid="key" class="slot-card" onclick="selectBrowse($idx)"><text class="slot-title" style="font-family: {{$item.font}};">{{$item.name}}</text><text class="slot-meta">{{$item.detail}}</text></div></div>
      <div class="pager"><text class="pager-action" onclick="previousBrowse">‹ 上一页</text><text class="pager-action" onclick="closeBrowse">返回</text><text class="pager-action" onclick="nextBrowse">下一页 ›</text></div>
    </div>
    <div if="{{mode === 'slots'}}" class="full-panel">
      <text class="panel-title">{{slotTitle}}</text>
      <text class="panel-subtitle">{{slotPageLabel}}</text>
      <div class="slot-list">
        <div for="{{slotRows}}" tid="number" class="slot-card" style="background-color: {{$item.occupied ? '#dcece7' : '#e9f2ed'}};" onclick="selectSlot($item.index)">
          <text class="slot-title">{{$item.title}}</text><text class="slot-meta" style="font-family: {{$item.metaFont}};">{{$item.meta}}</text><text class="slot-preview" style="font-family: {{$item.previewFont}};">{{$item.preview}}</text>
        </div>
      </div>
      <div class="pager"><text class="pager-action" onclick="previousSlotPage">‹ 上一页</text><text class="pager-action" onclick="closeSlots">返回</text><text class="pager-action" onclick="nextSlotPage">下一页 ›</text></div>
    </div>
    <div if="{{mode === 'overwrite'}}" class="overlay">
      <text class="menu-title">{{overwriteTitle}}</text>
      <text class="confirm-text" style="font-family: {{overwriteFont}};">{{overwriteDetail}}</text>
      <text class="menu-action" onclick="confirmOverwrite">确认覆盖</text><text class="menu-action muted" onclick="cancelOverwrite">取消</text>
    </div>
    <div if="{{mode === 'gallery'}}" class="full-panel">
      <text class="panel-title">CG 鉴赏</text><text class="panel-subtitle">{{galleryPageLabel}}</text>
      <div class="gallery-row"><div for="{{galleryTop}}" tid="image" class="gallery-card" onclick="viewCg($item.index)"><image class="gallery-thumb" src="{{$item.src}}"></image><text class="gallery-caption" style="font-family: {{$item.font}};">{{$item.label}}</text></div></div>
      <div class="gallery-row"><div for="{{galleryBottom}}" tid="image" class="gallery-card" onclick="viewCg($item.index)"><image class="gallery-thumb" src="{{$item.src}}"></image><text class="gallery-caption" style="font-family: {{$item.font}};">{{$item.label}}</text></div></div>
      <div class="pager"><text class="pager-action" onclick="previousGalleryPage">‹ 上一页</text><text class="pager-action" onclick="toTitle">返回标题</text><text class="pager-action" onclick="nextGalleryPage">下一页 ›</text></div>
    </div>
    <div if="{{mode === 'cg'}}" class="cg-panel">
      <image class="cg-image" src="{{cgSrc}}" onclick="cycleCg"></image><text class="cg-caption" style="font-family: {{cgFont}};">{{cgLabel}}</text>
      <div class="cg-controls"><text class="pager-action" onclick="previousCg">‹ 上一组</text><text class="pager-action" onclick="backToGallery">返回列表</text><text class="pager-action" onclick="nextCg">下一组 ›</text></div>
    </div>
    <div if="{{mode === 'end'}}" class="end-panel"><text class="game-title">本篇阅读完毕</text><text class="subtitle">可从标题选择其他篇章</text><text class="action" onclick="toTitle">返回标题</text></div>
    <div if="{{mode === 'error'}}" class="overlay"><text class="menu-title">暂时无法继续</text><text class="error-text">{{errorText}}</text><text class="action" onclick="toTitle">返回标题</text></div>
    <text if="{{loading}}" class="loading">加载中…</text>
  </div>
</template>
<script>
import file from '@system.file';
import storage from '@system.storage';
import prompt from '@system.prompt';
import audio from '@system.audio';
import {newState,restore,readFrame,readChapterSkip,next,nextChapter,choose,previous,previewMap} from '../../common/engine.js';
import {SLOT_COUNT,LEGACY_KEY,slotKey,decodeSave,createSave,slotRow} from '../../common/saves.js';
import {catalog} from '../../common/catalog.js';
import {imagePath} from '../../common/assets.js';
import {groupGallery,stepVariant} from '../../common/gallery.js';
import {textFont} from '../../common/text-font.js';
import {portraitBox} from '../../common/portrait-layout.js';
import {PROGRESS_KEY,emptyProgress,decodeProgress,progressFromState,withProgress,lightCount,afterUnlocked,titleBackground} from '../../common/progress.js';
import {autoSpeeds,autoWait} from '../../common/auto-reader.js';
import {makeTitleMusic} from '../../common/title-music.js';
export default {
  private:{mode:'title',titleBackgroundSrc:'/common/ui/title-before.jpg',backgroundSrc:'/common/ui/title.jpg',bodySrc:'',bodySecond:'',bodyThird:'',portraitWidth:200,portraitLeft:116,portraitSecondLeft:216,speaker:'',displayText:'',chapterLabel:'',speakerFont:'sans-serif',dialogueFont:'sans-serif',chapterFont:'sans-serif',browseFont:'sans-serif',overwriteFont:'sans-serif',cgFont:'sans-serif',
    options:[],loading:false,errorText:'',hasNextChapter:true,fontSize:24,dialogueHeight:128,textSpeed:30,autoEnabled:false,autoSpeed:1,autoLabel:'自动播放：关闭',autoSpeedLabel:'自动速度：标准',speedLabel:'显示速度：逐字',fontLabel:'字号：标准',soundEnabled:true,musicAvailable:true,musicLabel:'标题音乐：开启',afterAvailable:false,afterLabel:'After Story（未解锁）',progressLabel:'光玉 0 / 13',
    portraitHeight:286,portraitTop:0,portraitSecondWidth:200,portraitSecondHeight:286,portraitSecondTop:0,portraitThirdWidth:144,portraitThirdHeight:286,portraitThirdTop:0,portraitThirdLeft:288,
    slotTitle:'',slotPage:0,slotPageLabel:'',slotRows:[],storageBusy:false,overwriteTitle:'',overwriteDetail:'',
    galleryPage:0,galleryPageLabel:'',galleryTop:[],galleryBottom:[],cgIndex:0,cgVariant:0,cgSrc:'',cgLabel:'',browseRows:[],browseTitle:'',browseLabel:'',browsePage:0},
  onInit(){
    this.session=newState();this.cachedChapter=0;this.ops=[];this.loadSequence=0;this.timer=null;this.fullText='';this.resumeMode='play';this.autoEnabled=false;this._alive=true;this._hidden=false;this._autoTimer=null;this._autoGeneration=0;this._typingGeneration=0;this._touchReading=false;
    this._slotsSequence=0;this._gallerySequence=0;this._slotData=[];this._galleryCatalog=[];this._galleryTotal=0;this._slotsReturnMode='title';this._slotRole='load';
    this._progress=emptyProgress();this._progressWriteBusy=false;this._progressDirty=false;this._progressReady=false;this.loading=true;
    this._settingsReady=false;this._musicStartTimer=null;this._musicRequest=0;this._musicWanted=false;this._music=makeTitleMusic(audio,available=>{this.musicAvailable=available;if(!available)this._musicWanted=false;this.refreshSettings();});
    storage.get({complete:()=>{},key:'clannad_rw5_settings_v1',success:data=>{try{const s=JSON.parse(data);this.fontSize=s.fontSize===28?28:24;this.textSpeed=s.textSpeed===0?0:30;this.autoSpeed=s.autoSpeed===0||s.autoSpeed===2?s.autoSpeed:1;this.soundEnabled=s.soundEnabled!==false;}catch(e){}this._settingsReady=true;this.refreshSettings();this.updateMusic();},fail:()=>{this._settingsReady=true;this.refreshSettings();this.updateMusic();}});
    this.readProgress();
    console.log('CLANNAD_RW5 title ready');
  },
  backgroundLoaded(){console.log('CLANNAD_RW5 background loaded',this.mode,this.backgroundSrc);},
  backgroundError(){console.log('CLANNAD_RW5 background failed',this.mode,this.backgroundSrc);},
  clearTyping(){this.clearAuto();this._typingGeneration=(this._typingGeneration||0)+1;if(this.timer!==null){clearTimeout(this.timer);this.timer=null;}},
  clearAuto(){if(this._autoTimer!=null)clearTimeout(this._autoTimer);this._autoTimer=null;this._autoGeneration=(this._autoGeneration||0)+1;},
  canAuto(){return this.autoEnabled&&this._alive&&!this._hidden&&!this._touchReading&&!this.loading&&!this.storageBusy&&this.mode==='play'&&this.timer===null&&this.displayText===this.fullText;},
  armAuto(){
    this.clearAuto();if(!this.canAuto())return;
    const generation=this._autoGeneration,chapter=this.session.chapter,cursor=this.session.cursor;
    this._autoTimer=setTimeout(()=>{if(generation!==this._autoGeneration)return;this._autoTimer=null;if(!this.canAuto()||this.session.chapter!==chapter||this.session.cursor!==cursor)return;console.log('CLANNAD_RW5 auto advance',chapter,cursor);this.advance();},autoWait(this.autoSpeed,this.fullText.length));
  },
  stopAuto(){this.autoEnabled=false;this.clearAuto();this.refreshSettings();},
  toggleAuto(){if(this.mode!=='menu')return;this.autoEnabled=!this.autoEnabled;this.clearAuto();this.refreshSettings();console.log('CLANNAD_RW5 auto enabled',this.autoEnabled);},
  cycleAutoSpeed(){if(this.mode!=='menu')return;this.autoSpeed=(this.autoSpeed+1)%3;this.refreshSettings();this.persistSettings();console.log('CLANNAD_RW5 auto speed',this.autoSpeed);},
  onShow(){this._hidden=false;this.updateMusic();if(this._chapterSkip&&this.timer===null)this.renderFrame();else this.armAuto();},
  onHide(){this._hidden=true;this.stopTitleMusic();this._touchReading=false;this.clearTyping();if(!this._chapterSkip&&this.mode==='play')this.displayText=this.fullText;},
  onDestroy(){this._alive=false;this.stopTitleMusic();if(this._music)this._music.destroy();this.stopAuto();this.clearTyping();this.loadSequence++;this._slotsSequence++;this._gallerySequence++;},
  canTitleMusic(){return this._alive&&!this._hidden&&this._settingsReady&&this._progressReady&&this.soundEnabled&&this.musicAvailable&&(this.mode==='title'||this.mode==='config'||this.mode==='help');},
  updateMusic(){
    if(!this._music)return;if(!this.canTitleMusic()){this.stopTitleMusic();return;}if(this._musicWanted)return;
    this._musicWanted=true;const request=++this._musicRequest;
    // Let the title paint and temporary startup allocations settle first.
    this._musicStartTimer=setTimeout(()=>{if(request!==this._musicRequest)return;this._musicStartTimer=null;if(!this.canTitleMusic()){this._musicWanted=false;return;}this._music.update(true);},1800);
  },
  stopTitleMusic(){this._musicRequest=(this._musicRequest||0)+1;if(this._musicStartTimer!=null)clearTimeout(this._musicStartTimer);this._musicStartTimer=null;this._musicWanted=false;if(this._music)this._music.stop();},
  toggleMusic(){if(this.mode!=='config')return;if(!this.musicAvailable){this._music.retry();this.soundEnabled=true;}else this.soundEnabled=!this.soundEnabled;this.refreshSettings();this.persistSettings();this.updateMusic();console.log('CLANNAD_RW5 title music enabled',this.soundEnabled);},
  readProgress(){this.loading=true;storage.get({complete:()=>{},key:PROGRESS_KEY,default:'',success:data=>{try{this._progress=decodeProgress(data);this._progressReady=true;this.refreshProgress();this.loading=false;this.updateMusic();}catch(e){this.fail(e.message);}},fail:()=>{this.fail('通关记录读取失败，请返回标题重试');}});},
  openConfig(){if(this.loading||this.storageBusy)return;this.clearTyping();this.mode='config';this.updateMusic();console.log('CLANNAD_RW5 config');},
  openHelp(){if(!this.loading)this.mode='help';},
  startNew(){if(this.loading||!this._progressReady)return;this.stopAuto();this.clearTyping();this.session=withProgress(newState(catalog.flowScene,true),this._progress);this.cachedChapter=0;this._autoHops=0;this.renderFrame();},
  startAfter(){if(this.loading||!this._progressReady)return;if(!this.afterAvailable){this.toast('请先完成学园篇各路线并取得对应光玉');return;}this.stopAuto();this.clearTyping();this.session=withProgress(newState(6800,true),this._progress);this.cachedChapter=0;this._autoHops=0;this.renderFrame();},
  refreshProgress(){this.afterAvailable=afterUnlocked(this._progress);this.afterLabel=this.afterAvailable?'After Story':'After Story（未解锁）';this.progressLabel='光玉 '+lightCount(this._progress)+' / 13';this.titleBackgroundSrc=titleBackground(this._progress);},
  syncProgress(){
    if(!this._progressReady||this.session.progression!=='story')return;const progress=progressFromState(this.session);
    if(JSON.stringify(progress)===JSON.stringify(this._progress))return;
    this._progress=progress;this._progressDirty=true;this.refreshProgress();this.writeProgress();
  },
  writeProgress(){
    if(this._progressWriteBusy||!this._progressDirty)return;this._progressWriteBusy=true;this._progressDirty=false;
    const payload=JSON.stringify(this._progress);
    storage.set({complete:()=>{},key:PROGRESS_KEY,value:payload,success:()=>{this._progressWriteBusy=false;this.writeProgress();},fail:()=>{this._progressWriteBusy=false;this._progressDirty=true;this.toast('通关记录保存失败，请重试保存或返回标题');}});
  },
  openRoutes(){if(this.loading)return;this.stopTitleMusic();this.clearTyping();this._browseReturnMode=this.mode==='config'?'config':'title';this.mode='routes';this.browsePage=0;this.refreshBrowse();},
  visibleText(text){return String(text||'').replace(/・/g,'·');},
  visibleOptions(items){return items.map(item=>{const text=this.visibleText(item.text);return Object.assign({},item,{text,font:textFont(text)});});},
  refreshBrowse(){const routes=this.mode==='routes';this._browseItems=routes?catalog.routes:catalog.chapters.filter(x=>x.route===this._browseRoute);this.browseTitle=routes?'选择路线':'选择章节';const start=this.browsePage*4;this.browseRows=this._browseItems.slice(start,start+4).map((item,i)=>({key:(routes?'route:':'chapter:'+this._browseRoute+':')+(start+i),index:start+i,name:this.visibleText(item.name),font:textFont(item.name),detail:routes?item.scenes.length+' 个章节':'点击开始阅读'}));this.browseLabel=(routes?'章节阅读 · ':this.visibleText(catalog.routes[this._browseRoute].name)+' · ')+(this.browsePage+1)+' / '+Math.ceil(this._browseItems.length/4);this.browseFont=textFont(this.browseLabel);},
  previousBrowse(){if(this.browsePage>0){this.browsePage--;this.refreshBrowse();}},
  nextBrowse(){if(this.browsePage<Math.ceil(this._browseItems.length/4)-1){this.browsePage++;this.refreshBrowse();}},
  selectBrowse(row){if(this.mode!=='routes'&&this.mode!=='chapters')return;const index=this.browsePage*4+row;if(this.mode==='routes'){this._browseRoute=index;this.browsePage=0;this.mode='chapters';this.refreshBrowse();return;}const item=this._browseItems[index];if(!item)return;this.session=withProgress(newState(item.id),this._progress);this.cachedChapter=0;this._autoHops=0;this.renderFrame();},
  closeBrowse(){if(this.mode==='chapters'){this.mode='routes';this.browsePage=Math.floor(this._browseRoute/4);this.refreshBrowse();}else if(this._browseReturnMode==='config'){this.mode='config';this.updateMusic();}else this.toTitle();},
  continueGame(){this.openSlots('load');},
  readChapter(chapter,done){
    const block=Math.floor(this.session.cursor/512),key=chapter+':'+block;
    if(this.cachedChapter===key){done();return;}
    this.loading=true;const seq=++this.loadSequence;
    file.readText({complete:()=>{},uri:'/common/story/'+chapter+'/'+block+'.txt',success:data=>{
      if(seq!==this.loadSequence)return;
      try{const ops=JSON.parse(data.text);if(!Array.isArray(ops))throw new Error('章节格式无效');this.ops=ops;this.opsBase=block*512;this.cachedChapter=key;this.loading=!!this._chapterSkip;done();}
      catch(e){this.fail(e.message);}
    },fail:(data,code)=>{if(seq===this.loadSequence)this.fail('第 '+chapter+' 章读取失败：'+code+' '+String(data||'').slice(0,100));}});
  },
  renderFrame(){
    this.stopTitleMusic();this.clearTyping();this.readChapter(this.session.chapter,()=>{
      if(this._hidden)return;
      try{
        const f=this._chapterSkip?readChapterSkip(this.ops,this.session,this._chapterSkip,this.opsBase,catalog.scenes[String(this.session.chapter)].length):readFrame(this.ops,this.session,this.opsBase,catalog.scenes[String(this.session.chapter)].length);
        this.syncProgress();
        if(f.type==='jump'||f.type==='yield'){this._autoHops=(this._autoHops||0)+1;if(this._autoHops>1000)throw new Error('此章节无法继续，可从标题选择其他篇章');this.timer=setTimeout(()=>{this.timer=null;this.renderFrame();},0);return;}this._autoHops=0;this._chapterSkip=null;this.loading=false;
        this.backgroundSrc=imagePath(this.session.background);
        const bodies=this.session.bodies||[];this.bodySrc=bodies[0]?imagePath(bodies[0]):'';this.bodySecond=bodies[1]?imagePath(bodies[1]):'';this.bodyThird=bodies[2]?imagePath(bodies[2]):'';
        const first=portraitBox(this.bodySrc,bodies.length,0),second=portraitBox(this.bodySecond,bodies.length,1),third=portraitBox(this.bodyThird,bodies.length,2);
        this.portraitWidth=first.width;this.portraitHeight=first.height;this.portraitTop=first.top;this.portraitLeft=first.left;
        this.portraitSecondWidth=second.width;this.portraitSecondHeight=second.height;this.portraitSecondTop=second.top;this.portraitSecondLeft=second.left;
        this.portraitThirdWidth=third.width;this.portraitThirdHeight=third.height;this.portraitThirdTop=third.top;this.portraitThirdLeft=third.left;
        this.chapterLabel=this.visibleText(catalog.scenes[String(this.session.rootChapter)].name);this.chapterFont=textFont(this.chapterLabel);this.hasNextChapter=!this.session.ended;
        if(f.type==='map'){this.renderMap(f);return;}
        if(f.type==='choice'){this.options=this.visibleOptions(f.items);this.mode='choice';console.log('CLANNAD_RW5 choice',this.session.chapter,this.session.cursor);return;}
        if(f.type==='end'){this.stopAuto();this.mode='end';console.log('CLANNAD_RW5 ending');return;}
        this.mode='play';this.speaker=this.visibleText(f.speaker);this.fullText=this.visibleText(f.text);this.speakerFont=textFont(this.speaker);this.dialogueFont=textFont(this.fullText);this.displayText='';this._dialogueDragged=false;this._dialogueIgnoreUntil=0;this.measureDialogue();
        try{this.$element('dialogue-scroll').scrollTo({index:0});}catch(e){}
        console.log('CLANNAD_RW5 frame',this.session.chapter,this.session.cursor);
        const speed=this.autoEnabled?30:this.textSpeed,generation=this._typingGeneration;
        if(speed===0){this.displayText=this.fullText;this.armAuto();return;}
        const tick=()=>{if(!this._alive||this._hidden||this.mode!=='play'||generation!==this._typingGeneration)return;this.displayText=this.fullText.slice(0,this.displayText.length+1);if(this.displayText.length<this.fullText.length)this.timer=setTimeout(tick,speed);else{this.timer=null;this.armAuto();}};tick();
      }catch(e){this.fail(e.message);}
    });
  },
  advance(){if(this.loading||this.mode!=='play')return;this.clearAuto();if(this.timer!==null){this.clearTyping();this.displayText=this.fullText;this.armAuto();return;}next(this.session);this.renderFrame();},
  measureDialogue(){const columns=this.fontSize===28?12:14;let lines=0;String(this.fullText||'').split('\n').forEach(line=>{let units=0;for(let i=0;i<line.length;i++)units+=line.charCodeAt(i)<128?0.55:1;lines+=Math.max(1,Math.ceil(units/columns));});this.dialogueHeight=Math.max(126,lines*34+8);},
  dialoguePoint(event){const t=event&&((event.touches&&event.touches[0])||(event.changedTouches&&event.changedTouches[0]));return t?{x:Number(t.clientX===undefined?t.pageX:t.clientX),y:Number(t.clientY===undefined?t.pageY:t.clientY)}:null;},
  dialogueTouchStart(event){this._touchReading=true;this.clearAuto();this._dialogueTouch=this.dialoguePoint(event);this._dialogueDragged=false;},
  dialogueTouchMove(event){const p=this.dialoguePoint(event),start=this._dialogueTouch;if(p&&start&&(Math.abs(p.x-start.x)>8||Math.abs(p.y-start.y)>8))this._dialogueDragged=true;},
  dialogueTouchEnd(){if(this._dialogueDragged)this._dialogueIgnoreUntil=Date.now()+450;this._dialogueTouch=null;this._touchReading=false;this.armAuto();},
  dialogueScrolled(){if(this._dialogueTouch){this._dialogueDragged=true;this._dialogueIgnoreUntil=Date.now()+450;}if(this.mode==='play')this.armAuto();},
  dialogueTap(){if(this._dialogueDragged||Date.now()<(this._dialogueIgnoreUntil||0)){this._dialogueDragged=false;return;}this.advance();},
  renderMap(frame){this.loading=true;const seq=++this.loadSequence;file.readText({complete:()=>{},uri:'/common/map-preview.txt',success:data=>{if(seq!==this.loadSequence)return;try{const choices=previewMap(JSON.parse(data.text),this.session,frame);if(!choices.length)throw new Error('此地图阶段暂无支持的剧情选项，请返回标题选择其他篇章');this.options=this.visibleOptions(choices);this.mode='choice';this.loading=false;console.log('CLANNAD_RW5 map ready',this.session.chapter,this.session.cursor,choices.map(x=>x.value).join(','));}catch(e){this.fail(e.message);}},fail:()=>{if(seq===this.loadSequence)this.fail('地图选项读取失败');}});},
  goNextChapter(){if(this.loading||this.mode!=='menu')return;if(this.resumeMode==='choice'){this.mode='choice';this.toast('请先作出当前选择');return;}this.clearTyping();this._chapterSkip=nextChapter(this.session);if(!this._chapterSkip){this.toast('本篇已结束');return;}this._autoHops=0;this.loading=true;this.renderFrame();console.log('CLANNAD_RW5 safe chapter skip',this.session.chapter,this.session.cursor);},
  pick(index){if(this.mode!=='choice'||this.loading)return;choose(this.session,this.options[index],index);this.renderFrame();},
  goBack(){if(this.loading||this.mode!=='play')return;this.stopAuto();this.clearTyping();if(previous(this.session)){if(this.session.progression==='story')withProgress(this.session,this._progress);this.renderFrame();}else this.toast('已经是第一句');},
  showMenu(){if(this.loading||(this.mode!=='play'&&this.mode!=='choice'))return;this.clearTyping();this.displayText=this.fullText;this.resumeMode=this.mode;this.mode='menu';console.log('CLANNAD_RW5 menu',this.session.chapter);},
  resume(){this.mode=this.resumeMode;this.armAuto();},
  swipe(event){
    if(event.direction==='right'&&this.mode==='config'){this.toTitle();return;}
    if(event.direction==='right'&&this.mode==='help'){this.openConfig();return;}
    if(this.mode==='gallery'){if(event.direction==='left')this.nextGalleryPage();if(event.direction==='right')this.previousGalleryPage();return;}
    if(event.direction==='right'&&(this.mode==='play'||this.mode==='choice'))this.showMenu();
  },
  saveGame(){this.writeProgress();this.openSlots('save');},
  loadGame(){this.openSlots('load');},
  openSlots(role){
    if(this.loading||this.storageBusy)return;this.stopTitleMusic();this.clearTyping();this._slotsReturnMode=this.mode;this._slotRole=role;
    this._pendingSave=role==='save'?createSave(this.session,this.resumeMode,Date.now()):null;
    this.slotTitle=role==='save'?'选择保存栏位':'选择读取栏位';this.slotPage=0;this.slotRows=[];this.mode='slots';this.loading=true;
    const seq=++this._slotsSequence;this._slotData=Array(SLOT_COUNT).fill(null);
    const ready=()=>{if(seq!==this._slotsSequence)return;this.loading=false;this.refreshSlotRows();console.log('CLANNAD_RW5 slots ready',role);};
    const finish=index=>{
      if(seq!==this._slotsSequence)return;
      if(index+1<SLOT_COUNT){setTimeout(()=>readSlot(index+1),0);return;}
      if(this._slotData[0]){ready();return;}
      storage.get({complete:()=>{},key:LEGACY_KEY,default:'',success:data=>{if(seq!==this._slotsSequence)return;try{const old=decodeSave(data);if(old){old.legacy=true;this._slotData[0]=old;}}catch(e){}ready();},fail:ready});
    };
    const readSlot=i=>{if(seq!==this._slotsSequence)return;storage.get({complete:()=>{},key:slotKey(i),default:'',success:data=>{if(seq!==this._slotsSequence)return;try{this._slotData[i]=decodeSave(data);}catch(e){this._slotData[i]={invalid:true};}finish(i);},fail:()=>{if(seq!==this._slotsSequence)return;this._slotData[i]={invalid:true};finish(i);}});};
    readSlot(0);
  },
  refreshSlotRows(){const start=this.slotPage*4;const rows=[];for(let i=start;i<Math.min(start+4,SLOT_COUNT);i++)rows.push(slotRow(i,this._slotData[i]));this.slotRows=rows;this.slotPageLabel=SLOT_COUNT+' 个栏位 · 第 '+(this.slotPage+1)+' / '+Math.ceil(SLOT_COUNT/4)+' 页';},
  previousSlotPage(){if(this.loading||this.slotPage===0)return;this.slotPage--;this.refreshSlotRows();},
  nextSlotPage(){if(this.loading||this.slotPage>=Math.ceil(SLOT_COUNT/4)-1)return;this.slotPage++;this.refreshSlotRows();},
  closeSlots(){if(this.storageBusy)return;this._slotsSequence++;this.loading=false;this.mode=this._slotsReturnMode;this.updateMusic();this.armAuto();},
  selectSlot(index){
    if(this.loading||this.storageBusy||this.mode!=='slots'||index<0||index>=SLOT_COUNT)return;
    const saved=this._slotData[index];
    if(this._slotRole==='load'){
      if(!saved){this.toast('这个栏位还没有存档');return;}if(saved.invalid){this.toast('这个存档无法读取');return;}
      try{this.session=restore(saved.state);if(this.session.progression==='story')withProgress(this.session,this._progress);this.cachedChapter=0;this._slotsSequence++;this.renderFrame();console.log('CLANNAD_RW5 slot loaded',index+1,this.session.chapter,this.session.cursor);}catch(e){this.toast(e.message);}return;
    }
    this._pendingSlotIndex=index;
    if(saved){const row=slotRow(index,saved);this.overwriteTitle='覆盖'+row.title+'？';this.overwriteDetail=row.meta+'\n覆盖后将保存当前进度。';this.overwriteFont=textFont(this.overwriteDetail);this.mode='overwrite';console.log('CLANNAD_RW5 overwrite',index+1);return;}
    this.commitSlot();
  },
  confirmOverwrite(){if(this.mode==='overwrite')this.commitSlot();},
  cancelOverwrite(){if(!this.storageBusy)this.mode='slots';},
  commitSlot(){
    if(this.storageBusy||!this._pendingSave)return;
    const index=this._pendingSlotIndex,seq=this._slotsSequence,payload=this._pendingSave;payload.savedAt=Date.now();this.storageBusy=true;this.loading=true;
    storage.set({complete:()=>{},key:slotKey(index),value:JSON.stringify(payload),success:()=>{
      if(seq!==this._slotsSequence)return;this._slotData[index]=payload;this.storageBusy=false;this.loading=false;this._slotsSequence++;this.mode=this.resumeMode;
      this.armAuto();this.toast('已保存到存档 '+('0'+(index+1)).slice(-2));console.log('CLANNAD_RW5 slot saved',index+1,payload.state.chapter,payload.state.cursor);
    },fail:()=>{if(seq!==this._slotsSequence)return;this.storageBusy=false;this.loading=false;this.toast('保存失败，请重试');}});
  },
  openGallery(){
    if(this.loading)return;this.stopTitleMusic();this.clearTyping();this.mode='gallery';
    if(this._galleryCatalog.length){this.refreshGallery();return;}
    this.loading=true;const seq=++this._gallerySequence;
    file.readText({complete:()=>{},uri:'/common/gallery.txt',success:data=>{
      if(seq!==this._gallerySequence)return;
      try{const items=JSON.parse(data.text);if(!Array.isArray(items)||!items.length)throw new Error('CG 目录为空');this._galleryCatalog=groupGallery(items);this._galleryTotal=items.length;this.galleryPage=0;this.loading=false;this.refreshGallery();console.log('CLANNAD_RW5 gallery ready',this._galleryCatalog.length,items.length);}catch(e){this.fail(e.message);}
    },fail:(data,code)=>{if(seq===this._gallerySequence)this.fail('CG 目录读取失败：'+code);}});
  },
  refreshGallery(){const start=this.galleryPage*4;const items=this._galleryCatalog.slice(start,start+4).map((item,i)=>({image:item.image,label:item.label+'\n'+item.variants.length+' 张',index:start+i,font:textFont(item.label+'张'),src:imagePath(item.image)}));this.galleryTop=items.slice(0,2);this.galleryBottom=items.slice(2,4);this.galleryPageLabel=this._galleryCatalog.length+' 组 · '+this._galleryTotal+' 张 · 第 '+(this.galleryPage+1)+' / '+Math.ceil(this._galleryCatalog.length/4)+' 页';},
  previousGalleryPage(){if(this.loading||this.galleryPage===0)return;this.galleryPage--;this.refreshGallery();},
  nextGalleryPage(){if(this.loading||this.galleryPage>=Math.ceil(this._galleryCatalog.length/4)-1)return;this.galleryPage++;this.refreshGallery();},
  viewCg(index){if((this.mode!=='gallery'&&this.mode!=='cg')||this.loading||index<0||index>=this._galleryCatalog.length)return;this.stopTitleMusic();this.cgIndex=index;this.cgVariant=0;this.mode='cg';this.renderCg();},
  renderCg(){const group=this._galleryCatalog[this.cgIndex],item=group.variants[this.cgVariant];this.cgSrc=imagePath(item.image);this.cgLabel=group.label+(group.variants.length>1?' · 差分 '+(this.cgVariant+1)+' / '+group.variants.length+' · 点击切换':'');this.cgFont=textFont(this.cgLabel);console.log('CLANNAD_RW5 cg',this.cgIndex+1,this.cgVariant+1,item.image);},
  cycleCg(){if(this.mode!=='cg'||this.loading)return;const count=this._galleryCatalog[this.cgIndex].variants.length;if(count<2)return;this.cgVariant=stepVariant(this.cgVariant,1,count);this.renderCg();},
  previousCg(){if(this.cgIndex>0)this.viewCg(this.cgIndex-1);},
  nextCg(){if(this.cgIndex<this._galleryCatalog.length-1)this.viewCg(this.cgIndex+1);},
  backToGallery(){if(this.mode!=='cg')return;this.stopTitleMusic();this.galleryPage=Math.floor(this.cgIndex/4);this.refreshGallery();this.mode='gallery';},
  refreshSettings(){this.speedLabel=this.textSpeed===0?'显示速度：即时':'显示速度：逐字';this.fontLabel=this.fontSize===28?'字号：大':'字号：标准';this.autoLabel='自动播放：'+(this.autoEnabled?'开启':'关闭');this.autoSpeedLabel='自动速度：'+autoSpeeds[this.autoSpeed];this.musicLabel=!this.musicAvailable?'标题音乐：点按重试':'标题音乐：'+(this.soundEnabled?'开启':'关闭');},
  persistSettings(){storage.set({complete:()=>{},key:'clannad_rw5_settings_v1',value:JSON.stringify({fontSize:this.fontSize,textSpeed:this.textSpeed,autoSpeed:this.autoSpeed,soundEnabled:this.soundEnabled}),success:()=>{},fail:()=>{}});},
  toggleSpeed(){this.textSpeed=this.textSpeed===0?30:0;this.refreshSettings();this.persistSettings();},
  toggleFont(){this.fontSize=this.fontSize===24?28:24;this.measureDialogue();this.refreshSettings();this.persistSettings();},
  toTitle(){if(this.storageBusy)return;this.stopAuto();this._chapterSkip=null;this.syncProgress();this.writeProgress();this.clearTyping();this.loadSequence++;this._slotsSequence++;this._gallerySequence++;this.loading=false;this.mode='title';this.backgroundSrc='/common/ui/title.jpg';this.bodySrc='';this.bodySecond='';this.bodyThird='';if(!this._progressReady)this.readProgress();else this.updateMusic();},
  toast(message){prompt.showToast({message,duration:1500,success:()=>{},fail:()=>{},complete:()=>{}});},
  fail(message){this.stopTitleMusic();this.stopAuto();this._chapterSkip=null;this.clearTyping();this.loading=false;this.mode='error';this.errorText=message;console.error('CLANNAD_RW5 error',message);}
}
</script>
<style>
@font-face {font-family:clannadextra;src:url('/common/clannad-extra.otf');}
.page{width:432px;height:514px;background-color:#f1f8f4;flex-direction:column;}
.title-art,.title-background,.paper-background{position:absolute;top:0px;left:0px;width:432px;height:514px;}
.title-logo{position:absolute;top:26px;left:72px;width:288px;height:66px;object-fit:contain;}
.title-kana{position:absolute;top:80px;left:124px;width:184px;height:36px;object-fit:contain;}
.title-menu-glass{position:absolute;top:140px;left:208px;width:216px;height:300px;}
.title-copyright{position:absolute;top:480px;left:258px;width:154px;height:19px;object-fit:contain;}
.title-progress{position:absolute;top:478px;left:56px;width:136px;height:24px;font-size:16px;color:#f0faf5;}
.title-panel{position:absolute;top:162px;left:210px;width:210px;height:250px;flex-direction:column;}
.title-button{width:210px;height:50px;flex-shrink:0;justify-content:center;align-items:center;}
.original-button{width:188px;height:25px;object-fit:contain;}
.art{position:absolute;top:0px;left:0px;width:432px;height:286px;justify-content:center;align-items:center;background-color:#000000;}
.background{width:432px;height:286px;object-fit:contain;}
.body{position:absolute;top:0px;left:116px;width:200px;height:286px;object-fit:contain;}
.dialogue-panel{position:absolute;top:286px;left:0px;width:432px;height:228px;flex-direction:column;padding:8px 18px;}
.dialogue-backdrop{position:absolute;top:286px;left:0px;width:432px;height:228px;}
.game-title{font-size:28px;color:#365b57;text-align:center;margin-bottom:12px;}
.subtitle{font-size:18px;color:#66837b;text-align:center;margin-bottom:24px;}
.action{height:52px;width:396px;margin-bottom:6px;color:#3d665b;background-color:#dceae2;border-radius:5px;text-align:center;font-size:24px;}
.speaker-row{height:34px;width:396px;justify-content:space-between;align-items:center;}
.speaker{width:200px;padding-left:12px;font-size:22px;color:#edf5f0;}
.chapter{width:178px;height:20px;font-size:14px;color:#9fb6ae;text-align:right;}
.dialogue-scroll{width:376px;height:128px;margin:6px 10px;}
.dialogue-content{width:376px;flex-direction:column;flex-shrink:0;}
.dialogue{width:376px;color:#f0f5ed;line-height:34px;flex-shrink:0;}
.toolbar{height:42px;width:396px;justify-content:space-between;align-items:center;}
.tool{font-size:20px;color:#d1dfd4;padding:8px;}
.choice-title{font-size:23px;color:#365b57;margin-bottom:8px;text-align:center;}
.choice{height:68px;width:396px;background-color:#e5efea;border-width:1px;border-color:#b7cec1;border-radius:4px;font-size:21px;line-height:25px;color:#365b57;text-align:center;margin-bottom:6px;}
.small-action{font-size:18px;color:#4c7168;text-align:center;}
.overlay{position:absolute;top:0px;left:0px;width:432px;height:514px;flex-direction:column;padding:22px 32px;}
.menu-title{height:36px;font-size:28px;color:#365b57;text-align:center;margin-bottom:12px;}
.original-action{width:368px;height:50px;flex-shrink:0;margin-bottom:8px;justify-content:center;align-items:center;}
.action-backdrop{position:absolute;left:0px;top:0px;width:368px;height:50px;}
.action-label{width:348px;height:44px;font-size:22px;color:#ffffff;text-align:center;}
.menu-action{height:50px;font-size:22px;color:#3d665b;background-color:#dceae2;border-radius:5px;margin-bottom:8px;text-align:center;}
.reading-action{height:40px;margin-bottom:4px;font-size:20px;}
.reading-backdrop{height:40px;}
.reading-label{height:36px;font-size:20px;}
.muted{color:#6f887e;}
.return-action{margin-top:16px;}
.help-text{height:322px;font-size:19px;line-height:31px;color:#45645b;}
.full-panel{position:absolute;top:0px;left:0px;width:432px;height:514px;flex-direction:column;padding:16px 18px;}
.panel-title{height:36px;font-size:28px;color:#365b57;text-align:center;margin-bottom:4px;}
.panel-subtitle{height:22px;font-size:16px;color:#68887a;text-align:center;margin-bottom:6px;}
.slot-list{height:368px;width:396px;flex-direction:column;}
.slot-card{height:84px;width:396px;margin-bottom:8px;padding:7px 12px;flex-direction:column;background-color:#dfede5;border-width:1px;border-color:#bdd2c5;border-radius:4px;}
.slot-title{height:26px;font-size:22px;color:#335b50;}
.slot-meta{height:19px;font-size:16px;color:#70867c;}
.slot-preview{height:22px;font-size:18px;color:#526b61;}
.pager{height:44px;width:396px;justify-content:space-between;align-items:center;}
.pager-action{font-size:20px;color:#54776a;padding:8px;}
.gallery-row{height:184px;width:396px;justify-content:space-between;}
.gallery-card{height:176px;width:192px;padding:6px;flex-direction:column;background-color:#dfede5;border-radius:4px;}
.gallery-thumb{height:116px;width:180px;object-fit:contain;background-color:#000000;}
.gallery-caption{height:48px;width:180px;font-size:18px;line-height:22px;color:#365b57;text-align:center;}
.cg-panel{position:absolute;top:0px;left:0px;width:432px;height:514px;flex-direction:column;background-color:#000000;}
.cg-image{width:432px;height:432px;object-fit:contain;}
.cg-caption{width:432px;height:28px;font-size:18px;color:#d5e5f2;text-align:center;}
.cg-controls{width:432px;height:54px;padding:0px 10px;justify-content:space-between;align-items:center;background-color:#edf5ef;}
.confirm-text{font-size:24px;color:#45645b;margin:30px 0px;}
.error-text{font-size:22px;color:#955b59;margin-bottom:30px;}
.loading{position:absolute;top:234px;left:128px;width:176px;height:46px;text-align:center;font-size:23px;color:#ffffff;background-color:#3d6960;border-radius:5px;}
.choice-panel{position:absolute;top:0px;left:0px;width:432px;height:514px;flex-direction:column;background-color:#edf5ef;padding:18px;}
.choice-list{width:396px;height:416px;flex-direction:column;}
.end-panel{position:absolute;top:0px;left:0px;width:432px;height:514px;flex-direction:column;padding:140px 18px 18px;}
</style>

